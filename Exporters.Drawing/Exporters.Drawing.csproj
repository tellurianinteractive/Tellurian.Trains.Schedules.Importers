<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Tellurian.Trains.Schedules.Exporters.Drawing</AssemblyName>
    <RootNamespace>Tellurian.Trains.Schedules.Exporters.Drawing</RootNamespace>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>$(AssemblyName)</Title>
    <Description>Writes Module Draw's drawing files (end profiles; modules, catalogues, halls and hall plans to follow) at the current schema version, as IExporter&lt;T&gt;s, counting up the revision when a write is a new revision. Reading is in Importers.Drawing.</Description>
    <PackageTags>model-trains FREMO module drawing export</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Exporters.Interfaces\Exporters.Interfaces.csproj" />
    <ProjectReference Include="..\Model.Drawings\Model.Drawings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="True" PackagePath="\" />
  </ItemGroup>
</Project>
