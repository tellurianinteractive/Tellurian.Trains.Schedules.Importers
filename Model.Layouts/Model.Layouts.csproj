<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Tellurian.Trains.Schedules.Model.Layouts</AssemblyName>
    <RootNamespace>Tellurian.Trains.Schedules.Model.Layouts</RootNamespace>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>$(AssemblyName)</Title>
    <Description>The operating model railway layout: operation locations, their tracks and the stretches between them, with what the hall plan's drawings measured. Shared by the planner, Dispatch, Module Draw and the Module Registry. No dependencies.</Description>
    <PackageTags>model-trains layouts FREMO operation-locations</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- The planner resolves the regions of a station after reading (Station.UnresolvedRegionIds); the drawn layout reads its operating layout with the layout's own JSON metadata. -->
    <InternalsVisibleTo Include="Tellurian.Trains.Schedules.Model" />
    <InternalsVisibleTo Include="Tellurian.Trains.Schedules.Model.Drawings" />
  </ItemGroup>
</Project>
