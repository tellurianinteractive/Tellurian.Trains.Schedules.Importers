<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>Tellurian.Trains.Schedules.Importers.Services</AssemblyName>
		<RootNamespace>Tellurian.Trains.Schedules.Importers.Services</RootNamespace>
		<PackageId>$(AssemblyName)</PackageId>
		<PackageReleaseNotes>
		</PackageReleaseNotes>
		<Title>$(AssemblyName)</Title>
		<RepositoryType />
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Tellurian.Utilities" Version="1.3.0" />
	</ItemGroup>
	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\Importers.Interfaces\Interfaces.csproj" />
	  <ProjectReference Include="..\Model\Model.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <None Update="CSV\TrainCategories.csv">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="JSON\OperatingCompanies.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="CSV\" />
	</ItemGroup></Project>
