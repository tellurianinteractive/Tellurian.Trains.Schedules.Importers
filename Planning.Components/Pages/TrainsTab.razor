@page "/trains"
@inject ScheduleStateService ScheduleState
@inject Translator Translator
@inject UiPreferenceService UiPrefs
@implements IDisposable

@if (ScheduleState.Timetable is null || ScheduleState.Layout is null)
{
    <p>@Translator("TrainsNoSchedule")</p>
}
else
{
    <div class="trains-tab">
        @* Two ways into the same calls: a train with every place it calls at, or a place with every train
           that calls there. The second is where trains are moved between the tracks of one station, which
           in the first means opening every train that calls there one at a time. *@
        <nav class="sub-tabs">
            @foreach (var section in Sections)
            {
                <button class="sub-tab @(section == _section ? "active" : "")"
                        @onclick="() => SelectSection(section)">
                    @SectionLabel(section)
                </button>
            }
        </nav>

        @switch (_section)
        {
            case TrainsSection.PerTrain:
                <TrainsEditor />
                break;
            case TrainsSection.PerLocation:
                <LocationCallsEditor />
                break;
        }
    </div>
}

@code {
    private enum TrainsSection { PerTrain, PerLocation }

    private TrainsSection _section = TrainsSection.PerTrain;
    private static readonly TrainsSection[] Sections = Enum.GetValues<TrainsSection>();

    protected override void OnInitialized() => ScheduleState.OnChanged += OnStateChanged;

    protected override async Task OnInitializedAsync()
    {
        if (await UiPrefs.GetTrainsSectionAsync() is { } saved && Enum.TryParse<TrainsSection>(saved, out var section))
            _section = section;
    }

    private void SelectSection(TrainsSection section)
    {
        _section = section;
        _ = UiPrefs.SetTrainsSectionAsync(section.ToString());
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private string SectionLabel(TrainsSection section) => Translator(section switch
    {
        TrainsSection.PerTrain => "PerTrain",
        TrainsSection.PerLocation => "PerOperationLocation",
        _ => section.ToString()
    });

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        ScheduleState.FlushPendingSave();
    }
}
