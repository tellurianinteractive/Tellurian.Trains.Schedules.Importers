@page "/settings"
@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Settings
@using Tellurian.Trains.Schedules.Model.Timetables
@using LayoutModel = Tellurian.Trains.Schedules.Model.Layouts.Layout
@using Theme = Tellurian.Trains.Schedules.Model.Layouts.Theme
@using Scale = Tellurian.Trains.Schedules.Model.Layouts.Scale
@using Country = Tellurian.Trains.Schedules.Model.Country
@inject ScheduleStateService ScheduleState
@inject Translator Translator
@inject UiPreferenceService UiPrefs
@inject IJSRuntime JS
@implements IDisposable


@if (Layout is null || LayoutSettings is null)
{
    <p>@Translator("SettingsNoSchedule")</p>
}
else
{
    <div class="settings">
        <nav class="sub-tabs">
            @foreach (var section in Sections)
            {
                <button class="sub-tab @(section == _section ? "active" : "")"
                        @onclick="() => SelectSection(section)">
                    @SectionLabel(section)
                </button>
            }
        </nav>

        @* Settings bind directly to the shared Layout model. Each field uses @bind:after="OnEdited"
           so every edit is saved to storage and broadcast: docked views (e.g. the graphical timetable)
           re-render via ScheduleState.OnChanged, and the change survives a reload. *@
        @* The information section holds markdown editors, each showing its text and a preview side
           by side; they need the full width rather than the reading width the labelled fields use. *@
        <div class="section @(_section == SettingsSection.Information ? "wide" : "")">
            @if (_section == SettingsSection.General)
            {
                var g = LayoutSettings.General;
                var i = LayoutSettings.Identity;
                <div class="field">
                    <HelpLabel For="LayoutName" />
                    <input type="text" @bind="LayoutName" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("Theme")</label>
                    <select @bind="LayoutTheme" @bind:after="OnEdited">
                        @foreach (var t in Enum.GetValues<Theme>())
                        {
                            <option value="@t">@Translator(t.ToString())</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@Translator("Scale")</label>
                    <select @bind="i.ScaleId" @bind:after="OnEdited">
                        @foreach (var s in Scale.Scales.OrderBy(s => s.Denominator))
                        {
                            <option value="@s.Id">@ScaleLabel(s)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@Translator("DefaultCountry")</label>
                    <select @bind="i.DefaultCountryId" @bind:after="OnEdited">
                        @foreach (var c in CountryChoices)
                        {
                            <option value="@c.Id">@Translator(c.ResourceKey)</option>
                        }
                    </select>
                </div>
                @* The meeting's date span, printed as the validity line on reports. Both are optional:
                   a layout with no meeting booked omits the line rather than printing a placeholder. *@
                <div class="field">
                    <HelpLabel For="ValidFrom" />
                    <input type="date" @bind="g.ValidFrom" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <HelpLabel For="ValidTo" />
                    <input type="date" @bind="g.ValidTo" @bind:after="OnEdited" />
                </div>

                <div class="field">
                    <HelpLabel For="RunsOverMidnight" />
                    <input type="checkbox" @bind="RunsOverMidnight" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <HelpLabel For="StartTime" />
                    <input type="time" @bind="StartTime" @bind:after="OnEdited" disabled="@RunsOverMidnight" />
                </div>
                <div class="field">
                    <HelpLabel For="EndTime" />
                    <input type="time" @bind="EndTime" @bind:after="OnEdited" disabled="@RunsOverMidnight" />
                </div>
                <div class="field">
                    <HelpLabel For="AllowPlanTimeExtend" />
                    <input type="checkbox" @bind="g.AllowPlanTimeExtend" @bind:after="OnEdited" disabled="@RunsOverMidnight" />
                </div>
                <div class="field">
                    <HelpLabel For="BreakForPrinting" />
                    <span class="control">
                        <input type="checkbox" @bind="UseBreak" @bind:after="OnEdited" />
                        @if (UseBreak)
                        {
                            <input type="time" @bind="BreakTime" @bind:after="OnEdited" />
                        }
                    </span>
                </div>

                <div class="group-heading">@Translator("LocoDrivers")</div>
                <div class="field">
                    <HelpLabel For="ExpectedLocoDrivers" />
                    <input type="number" min="0" max="99" @bind="g.ExpectedLocoDrivers" @bind:after="OnEdited" />
                </div>

                <div class="group-heading">@Translator("Reports")</div>
                <div class="field">
                    <HelpLabel For="UseObjectLanguageInReports" />
                    <input type="checkbox" @bind="g.UseObjectLanguageInReports" @bind:after="OnEdited" />
                </div>
                @* Each family is listed in itself, so the choice is made by looking at the faces rather
                   than by recognising their names. The list is what this device can actually render. *@
                <div class="field">
                    <HelpLabel For="ReportFontFamily" />
                    <select class="font-choice" @bind="ReportFontFamily" @bind:after="OnEdited">
                        <option value="">@Translator("DefaultFont")</option>
                        @foreach (var group in FontChoices)
                        {
                            <optgroup label="@Translator(group.Key.ToString())">
                                @foreach (var font in group)
                                {
                                    <option value="@font.Name" style="font-family: @ReportFonts.CssFontFamily(font.Name)">@font.Name</option>
                                }
                            </optgroup>
                        }
                        @* A plan may name a font this device has not got. Keeping it in the list is what
                           stops merely opening the settings here from silently discarding the choice. *@
                        @if (MissingFont is { } missing)
                        {
                            <optgroup label="@Translator("FontNotInstalled")">
                                <option value="@missing">@missing</option>
                            </optgroup>
                        }
                    </select>
                </div>
                <p class="hint font-sample" style="font-family: @ReportFonts.CssFontFamily(ReportFontFamily)">@Translator("ReportFontSample")</p>
            }
            else if (_section == SettingsSection.SessionDays)
            {
                var g = LayoutSettings.General;
                <div class="field">
                    <HelpLabel For="UseDays" />
                    <input type="checkbox" @bind="g.UseDays" @bind:after="OnEdited" />
                </div>
                @if (g.UseDays)
                {
                    <div class="field">
                        <HelpLabel For="StartDay" />
                        <select @bind="g.StartDay" @bind:after="OnEdited">
                            @foreach (var day in Enum.GetValues<DayOfWeek>())
                            {
                                <option value="@day">@DayName(day)</option>
                            }
                        </select>
                    </div>
                }
                <div class="field">
                    <HelpLabel For="MaxSessions" />
                    <input type="number" min="1" max="14" @bind="g.MaxSessions" @bind:after="OnEdited" />
                </div>

                @if (Timetable is not null)
                {
                    <div class="group-heading">@Translator("SessionPatterns")</div>
                    <p class="hint">@Translator(g.UseDays ? "DayPatternHint" : "SessionPatternHint")</p>
                    <div class="session-patterns">
                        @if (Timetable.Sessions.Count == 0)
                        {
                            <span class="none">@Translator("NoneOption")</span>
                        }
                        @foreach (var sessions in Timetable.Sessions.ToList())
                        {
                            <span class="chip">
                                <SessionsView Sessions="sessions" Settings="SessionSettings" />
                                <button type="button" class="remove" title="@Translator("Delete")"
                                        @onclick="() => RemoveSessionPattern(sessions)">×</button>
                            </span>
                        }
                    </div>
                    <div class="field add-pattern">
                        @if (g.UseDays)
                        {
                            <span class="days">
                                @foreach (var day in WeekDays)
                                {
                                    <label><input type="checkbox" checked="@_newDays.Contains(day)"
                                                  @onchange="e => ToggleNewDay(day, e)" /> @Translator(day + "Short")</label>
                                }
                            </span>
                            <button type="button" disabled="@(_newDays.Count == 0)" @onclick="AddDaysPattern">@Translator("AddSessionPattern")</button>
                        }
                        else
                        {
                            <input type="text" placeholder="1-3, 4 7" @bind="_newSessionsText" />
                            <button type="button" @onclick="AddSessionsPattern">@Translator("AddSessionPattern")</button>
                        }
                    </div>
                }
            }
            else if (_section == SettingsSection.GraphicTimetable)
            {
                var gt = LayoutSettings.GraphicTimetable;
                <div class="field">
                    <label>@Translator("TimeAxisOrientation")</label>
                    <select @bind="gt.Orientation" @bind:after="OnEdited">
                        @foreach (var o in Enum.GetValues<TimeAxisOrientation>())
                        {
                            <option value="@o">@Translator(o.ToString())</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@Translator("ShowArrivalMinutes")</label>
                    <input type="checkbox" @bind="gt.ShowArrivalMinutes" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ShowDepartureMinutes")</label>
                    <input type="checkbox" @bind="gt.ShowDepartureMinutes" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("MinuteSpacing")</label>
                    <input type="number" min="1" @bind="gt.MinuteSpacing" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("KilometerSpacing")</label>
                    <input type="number" min="1" @bind="gt.KilometerSpacing" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("StationSpacing")</label>
                    <input type="number" min="1" @bind="gt.StationSpacing" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("TrackSpacing")</label>
                    <input type="number" min="1" @bind="gt.TrackSpacing" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("TrainLabelFontSize")</label>
                    <input type="number" min="4" max="16" @bind="gt.TrainLabelFontSize" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ShowTrainCategory")</label>
                    <input type="checkbox" @bind="gt.ShowTrainCategory" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ShowCompany")</label>
                    <input type="checkbox" @bind="gt.ShowCompany" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("HideSessionsOrDays")</label>
                    <input type="checkbox" @bind="gt.HideSessionsOrDays" @bind:after="OnEdited" />
                </div>
            }
            else if (_section == SettingsSection.TimeAndSpeed)
            {
                var ts = LayoutSettings.TimeAndSpeed;
                <div class="field">
                    <label>@Translator("FastClockSpeed")</label>
                    <input type="number" min="1" @bind="ts.FastClockSpeed" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("DistanceFactor")</label>
                    <input type="number" min="0" step="0.01" @bind="ts.DistanceFactor" @bind:culture="Invariant" @bind:after="OnEdited" />
                </div>
                <p class="hint">@Translator("DistanceFactorHint")</p>

                <div class="group-heading">@Translator("SpeedMapping")</div>
                <table class="speed-map">
                    <thead>
                        <tr><th>@Translator("Class")</th><th>@Translator("ScaleSpeedKmh")</th><th>@Translator("RealSpeedMs")</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Translator("SpeedSlow")</td>
                            <td><input type="number" min="0" @bind="ts.Slow.ScaleSpeedKmh" @bind:after="OnEdited" /></td>
                            <td><input type="number" step="0.01" @bind="ts.Slow.RealSpeedMetersPerSecond" @bind:culture="Invariant" @bind:after="OnEdited" /></td>
                        </tr>
                        <tr>
                            <td>@Translator("SpeedNormal")</td>
                            <td><input type="number" min="0" @bind="ts.Normal.ScaleSpeedKmh" @bind:after="OnEdited" /></td>
                            <td><input type="number" step="0.01" @bind="ts.Normal.RealSpeedMetersPerSecond" @bind:culture="Invariant" @bind:after="OnEdited" /></td>
                        </tr>
                        <tr>
                            <td>@Translator("SpeedHigh")</td>
                            <td><input type="number" min="0" @bind="ts.High.ScaleSpeedKmh" @bind:after="OnEdited" /></td>
                            <td><input type="number" step="0.01" @bind="ts.High.RealSpeedMetersPerSecond" @bind:culture="Invariant" @bind:after="OnEdited" /></td>
                        </tr>
                    </tbody>
                </table>

                <div class="group-heading">@Translator("DefaultStationTimes")</div>
                <p class="hint">@Translator("DefaultStationTimesHint")</p>
                <div class="field">
                    <HelpLabel For="MinimumStop" />
                    <input type="number" min="0" @bind="ts.StationTimings.MinimumStopMinutes" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <HelpLabel For="LocoRunaround" />
                    <input type="number" min="0" @bind="ts.StationTimings.LocoRunaroundRealMinutes" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <HelpLabel For="TrainClearance" />
                    <input type="number" min="0" @bind="ts.StationTimings.TrainClearanceRealMinutes" @bind:after="OnEdited" />
                </div>
            }
            else if (_section == SettingsSection.Validation)
            {
                var v = LayoutSettings.Validation;
                <div class="field">
                    <label>@Translator("ValidateStationCalls")</label>
                    <input type="checkbox" @bind="v.ValidateStationCalls" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ValidateStationTracks")</label>
                    <input type="checkbox" @bind="v.ValidateStationTracks" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ValidateStretches")</label>
                    <input type="checkbox" @bind="v.ValidateStretches" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ValidateTrainSpeed")</label>
                    <input type="checkbox" @bind="v.ValidateTrainSpeed" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ValidateRouteContinuity")</label>
                    <input type="checkbox" @bind="v.ValidateRouteContinuity" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ValidateTrainNumbers")</label>
                    <input type="checkbox" @bind="v.ValidateTrainNumbers" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ValidateSchedules")</label>
                    <input type="checkbox" @bind="v.ValidateSchedules" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ValidateLocomotiveCoverage")</label>
                    <input type="checkbox" @bind="v.ValidateLocomotiveCoverage" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ValidateDriverDuties")</label>
                    <input type="checkbox" @bind="v.ValidateDriverDuties" @bind:after="OnEdited" />
                </div>

                <div class="group-heading">@Translator("Thresholds")</div>
                <div class="field">
                    <label>@Translator("MinTrainSpeed")</label>
                    <input type="number" step="0.1" @bind="v.MinTrainSpeedMetersPerClockMinute" @bind:culture="Invariant" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("MaxTrainSpeed")</label>
                    <input type="number" step="0.1" @bind="v.MaxTrainSpeedMetersPerClockMinute" @bind:culture="Invariant" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("MinMinutesBetweenTrackUsage")</label>
                    <input type="number" min="0" @bind="v.MinMinutesBetweenTrackUsage" @bind:after="OnEdited" />
                </div>
            }
            else if (_section == SettingsSection.Integration)
            {
                var i = LayoutSettings.Integration;
                <div class="field">
                    <label>@Translator("ModuleRegistryApiUrl")</label>
                    <input type="text" @bind="i.ModuleRegistryApiUrl" @bind:after="OnEdited" />
                </div>
                <div class="field">
                    <label>@Translator("ModuleRegistryApiKey")</label>
                    <input type="text" @bind="i.ModuleRegistryApiKey" @bind:after="OnEdited" />
                </div>
            }
            else if (_section == SettingsSection.Information)
            {
                @if (Plan is null)
                {
                    <p class="empty">@Translator("SettingsNoSchedule")</p>
                }
                else
                {
                    @* The meeting's programme: session times, breaks, meals. Printed on the front page
                       of the general instructions booklet, before the standing instructions below. *@
                    <p class="hint">@Translator("ProgramHint")</p>
                    <div class="field instructions">
                        <HelpLabel For="Program" />
                        <MarkdownEditor Rows="8" PreviewClass="instructions-body"
                                        @bind-Value="Plan.Program" @bind-Value:after="OnEdited" />
                    </div>

                    @* The standing instructions for the whole meeting. They are printed as their own
                       booklet and handed to every participant before the first session — station staff
                       included — rather than bound into each driver's duty booklet. *@
                    <p class="hint">@Translator("GeneralInstructionsHint")</p>
                    <div class="field instructions">
                        <HelpLabel For="GeneralInstructions" />
                        <MarkdownEditor Rows="24" PreviewClass="instructions-body"
                                        @bind-Value="Plan.GeneralInstructions" @bind-Value:after="OnEdited" />
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private SettingsSection _section = SettingsSection.General;

    private static readonly SettingsSection[] Sections = Enum.GetValues<SettingsSection>();

    private static CultureInfo Invariant => CultureInfo.InvariantCulture;

    private LayoutModel? Layout => ScheduleState.Layout;
    private LayoutSettings? LayoutSettings => Layout?.Settings;
    private Timetable? Timetable => ScheduleState.Timetable;
    // The general instructions belong to the plan, not to the layout settings.
    private Plan? Plan => ScheduleState.Schedule;

    private static readonly Days[] WeekDays =
        [Days.Monday, Days.Tuesday, Days.Wednesday, Days.Thursday, Days.Friday, Days.Saturday, Days.Sunday];

    private string _newSessionsText = "";
    private readonly HashSet<Days> _newDays = [];

    private SessionsSettings SessionSettings =>
        LayoutSettings?.General.SessionSettings() ?? SessionsSettings.UseSessions(14);

    private void ToggleNewDay(Days day, ChangeEventArgs e)
    {
        if (e.Value is true) _newDays.Add(day); else _newDays.Remove(day);
    }

    private void AddSessionsPattern()
    {
        var numbers = SessionsDisplay.ParseSessionNumbers(_newSessionsText);
        if (numbers.Length == 0) return;
        AddPattern(Sessions.FromSessionNumbers(numbers));
        _newSessionsText = "";
    }

    private void AddDaysPattern()
    {
        if (_newDays.Count == 0) return;
        var days = _newDays.Aggregate(Days.None, (acc, d) => acc | d);
        AddPattern(Sessions.FromDays(days));
        _newDays.Clear();
    }

    // Add a pattern to the timetable's catalogue unless an equal one is already present.
    private void AddPattern(Sessions sessions)
    {
        if (Timetable is null) return;
        if (Timetable.Sessions.Any(s => SessionsDisplay.Key(s) == SessionsDisplay.Key(sessions))) return;
        Timetable.Sessions.Add(sessions);
        OnEdited();
    }

    private void RemoveSessionPattern(Sessions sessions)
    {
        if (Timetable is null) return;
        Timetable.Sessions.Remove(sessions);
        OnEdited();
    }

    private string LayoutName
    {
        get => Layout?.Name ?? "";
        set { if (Layout is not null) Layout.Name = value; }
    }

    // Changing the theme switches which countries are offered, so keep the stored default country
    // valid for the new theme (fall back to the first available one).
    private Theme LayoutTheme
    {
        get => LayoutSettings?.Identity.Theme ?? Theme.European;
        set
        {
            if (LayoutSettings is null) return;
            LayoutSettings.Identity.Theme = value;
            var available = Country.CountriesByTheme(value);
            if (!available.Any(c => c.Id == LayoutSettings.Identity.DefaultCountryId))
                LayoutSettings.Identity.DefaultCountryId = available.FirstOrDefault()?.Id ?? 0;
        }
    }

    // The weekday name in the current UI culture, capitalised for a drop-down (locales such as
    // Swedish yield lower-case day names from the culture data).
    private static string DayName(DayOfWeek day)
    {
        var culture = CultureInfo.CurrentCulture;
        return culture.TextInfo.ToTitleCase(culture.DateTimeFormat.GetDayName(day));
    }

    private static string ScaleLabel(Scale scale) =>
        string.IsNullOrEmpty(scale.Remark)
            ? $"{scale.Name} (1:{scale.Denominator})"
            : $"{scale.Name} (1:{scale.Denominator}, {scale.Remark})";

    // Sort by the name as shown in the current UI language (one entry per country).
    private IEnumerable<Country> CountryChoices =>
        Country.CountriesByTheme(LayoutTheme)
            .OrderBy(c => Translator(c.ResourceKey), StringComparer.CurrentCulture);

    // The operating window may run to or past midnight (e.g. an end of 24:00 when the last
    // departure is in the 23:00 hour, or beyond for services running into the next day). A
    // <input type="time">/TimeOnly cannot represent >= 24h, and TimeOnly.FromTimeSpan throws
    // for such values, so clamp the displayed time into a valid day. The underlying TimeSpan
    // is left untouched (the graph axis consumes it directly) unless the user edits the field.
    private static readonly TimeSpan MaxTimeOfDay = TimeSpan.FromDays(1) - TimeSpan.FromTicks(1);

    private static TimeOnly ToTimeOfDay(TimeSpan value) =>
        TimeOnly.FromTimeSpan(value < TimeSpan.Zero ? TimeSpan.Zero : value > MaxTimeOfDay ? MaxTimeOfDay : value);

    // When enabled, the operating window spans the whole day (00:00–23:59) and the start/end time
    // fields are pinned to that range and disabled, so a timetable whose services run over midnight
    // is graphed across the full day rather than a partial window.
    private static readonly TimeSpan EndOfDay = new(23, 59, 0);

    private bool RunsOverMidnight
    {
        get => LayoutSettings?.General.RunsOverMidnight ?? false;
        set
        {
            if (LayoutSettings is null) return;
            LayoutSettings.General.RunsOverMidnight = value;
            if (value)
            {
                LayoutSettings.General.StartTime = TimeSpan.Zero;
                LayoutSettings.General.EndTime = EndOfDay;
            }
        }
    }

    private TimeOnly StartTime
    {
        get => LayoutSettings is null ? default : ToTimeOfDay(LayoutSettings.General.StartTime);
        set { if (LayoutSettings is not null) LayoutSettings.General.StartTime = value.ToTimeSpan(); }
    }

    private TimeOnly EndTime
    {
        get => LayoutSettings is null ? default : ToTimeOfDay(LayoutSettings.General.EndTime);
        set { if (LayoutSettings is not null) LayoutSettings.General.EndTime = value.ToTimeSpan(); }
    }

    // The report font. Until the browser has been asked which families it has, every candidate is
    // offered: a list that starts empty and fills in is worse than one that starts long and shortens.
    private IReadOnlyList<ReportFont> _fonts = ReportFonts.Candidates;

    private string ReportFontFamily
    {
        get => LayoutSettings?.General.ReportFontFamily ?? "";
        set { if (LayoutSettings is not null) LayoutSettings.General.ReportFontFamily = value; }
    }

    // Grouped in catalogue order, so the railway faces lead and the serifs stay apart from the rest.
    private IEnumerable<IGrouping<ReportFontGroup, ReportFont>> FontChoices =>
        _fonts.GroupBy(f => f.Group);

    // The chosen family when this device has not got it, so it can still be listed and kept.
    private string? MissingFont =>
        ReportFontFamily is { Length: > 0 } chosen && !_fonts.Any(f => f.Name == chosen) ? chosen : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Tellurian.Trains.Schedules.Planning.Components/js/fonts.js");
        var names = await module.InvokeAsync<string[]>("installed", ReportFonts.Candidates.Select(f => f.Name));
        // An empty answer means the check could not tell (a browser that resists fingerprinting, say),
        // not that the device has no fonts — so keep the full list rather than emptying the drop-down.
        if (names.Length == 0) return;
        _fonts = [.. ReportFonts.Candidates.Where(f => names.Contains(f.Name))];
        StateHasChanged();
    }

    private bool UseBreak
    {
        get => LayoutSettings?.General.BreakTime is not null;
        set
        {
            if (LayoutSettings is null) return;
            LayoutSettings.General.BreakTime = value ? LayoutSettings.General.BreakTime ?? TimeSpan.FromHours(12) : null;
        }
    }

    private TimeOnly? BreakTime
    {
        get => LayoutSettings?.General.BreakTime is { } b ? ToTimeOfDay(b) : null;
        set { if (LayoutSettings is not null) LayoutSettings.General.BreakTime = value?.ToTimeSpan(); }
    }

    protected override void OnInitialized()
    {
        ScheduleState.OnChanged += OnStateChanged;
        // Older/imported timetables (e.g. from XPLN) have no session catalogue yet; seed the standard
        // patterns so they are always available here. Only persists when something was actually added.
        if (Timetable is { } timetable && timetable.EnsureSessions()) ScheduleState.SaveAndNotify();
    }

    protected override async Task OnInitializedAsync()
    {
        if (await UiPrefs.GetSettingsSectionAsync() is { } saved && Enum.TryParse<SettingsSection>(saved, out var section))
            _section = section;
    }

    // Switches the active sub-tab and remembers it, so the same section is shown next time.
    private void SelectSection(SettingsSection section)
    {
        _section = section;
        _ = UiPrefs.SetSettingsSectionAsync(section.ToString());
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // Runs after each bound settings field changes: save the edit and notify docked views so they
    // re-render. Bound directly to the shared Layout model, these edits otherwise neither persist
    // nor notify on their own.
    private void OnEdited() => ScheduleState.SaveAndNotify();

    private string SectionLabel(SettingsSection section) => Translator(section switch
    {
        SettingsSection.General => "General",
        SettingsSection.SessionDays => "SessionDays",
        SettingsSection.GraphicTimetable => "GraphicalTimetable",
        SettingsSection.TimeAndSpeed => "TimeAndSpeed",
        SettingsSection.Validation => "Validation",
        SettingsSection.Integration => "ImportExport",
        SettingsSection.Information => "Information",
        _ => section.ToString()
    });

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        // Write any edit still inside the debounce window before this view goes away.
        ScheduleState.FlushPendingSave();
    }

    private enum SettingsSection
    {
        General,
        SessionDays,
        TimeAndSpeed,
        GraphicTimetable,
        Validation,
        Integration,
        Information
    }
}
