@namespace Tellurian.Trains.Schedules.Planning.Components.Reporting.Compositions

@using System.Globalization
@using Tellurian.Trains.Schedules.Planning.App.Translations
@using Tellurian.Trains.Schedules.Planning.Components.Shared

@inject Translator Translator

@{ UseReportCulture(); }

@* One printed page of a station's train compositions.

   The reader is whoever makes up the trains at the station — the yard manager, where there is one — checking
   that every train leaves with the right wagons in the right places. The departures are listed a track at a
   time, and on each row the train is drawn the way it travels past the reader: the loco at the end it heads
   for, holding when it runs, which train it is and its times here, and behind it the rectangles standing where
   the wagons stand, so the paper reads in the same order as the train on the track. Which side of the tracks
   the reader stands on is not known, so every page comes twice, the second mirrored; the neighbours named at
   either end of the composition tell the reader which of the two is theirs. The rectangles are: a wagonset
   coupled here, by a shaded frame holding its turnus and one rectangle per wagon it lists, with class and number —
   a rake the train only runs on with is not drawn, nothing is made up for it; and the cargo flow wagons gathered
   here as one rectangle per unit marshalled — a flow's position in the train, and within it the position its
   destinations give the wagons. A flow that only runs through the station is not drawn: there is nothing
   here to make up for it.

   An arriving train uncoupling cargo flow wagons here gets a row of its own, with no departure time, and one
   dashed rectangle per position its flows take in the train, listing where the wagons came from. Only flows
   whose uncouple note is ticked are drawn — except at a shadow station, where every train's wagons come off.

   The rectangles carry no captions. Their sequence is the wagon order, so a rectangle needs to say nothing
   about where in the train it stands, and each wagonset is named at the front of its shaded frame. That leaves
   every rectangle free to be exactly as wide as what it holds.

   The heading repeats on every page and is what identifies the sheet: the pile is torn apart and handed to
   the stations, so a page has to say whose it is on its own. *@

<div class="compositions-page">
    <header class="heading">
        <h1>
            @Page.Station.Station.Name
            @if (Page.IsContinued)
            {
                <span class="continued">(@Translator("Continued"))</span>
            }
        </h1>
        <div class="context">
            <span>@Translator("TrainCompositions")</span>
            <span>@ContextLine</span>
            @* Only where the page has arrivals; the heading box has room for a third line. *@
            @if (Page.Departures.Any(departure => departure.IsArrival))
            {
                <span class="legend"><span class="arriving-sample"></span>@Translator("ArrivingWagonsLegend")</span>
            }
        </div>
    </header>

    <table class="compositions">
        <thead>
            <tr>
                <th class="track">@Translator("Track")</th>
                @* One column for both ends: a departure names where the train goes, an arrival where it came
                   from, each marked so the two cannot be mistaken for each other. *@
                <th class="to">@Translator("ToFrom")</th>
                @* The neighbours lying at either end, as this page is read: a train drawn heading left leaves
                   for those on the left. This is how the reader picks the page for their side of the tracks. *@
                <th class="composition">
                    <div class="ends">
                        <span class="end">@if (Page.LeftNeighbours.Count > 0) { @($"◀ {NamesOf(Page.LeftNeighbours)}") }</span>
                        <span>@Translator("CompositionFromLoco")</span>
                        <span class="end">@if (Page.RightNeighbours.Count > 0) { @($"{NamesOf(Page.RightNeighbours)} ▶") }</span>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Page.Departures.Count; i++)
            {
                var departure = Page.Departures[i];
                var isFirstOfTrack = i == 0 || !Page.Departures[i - 1].Track.Equals(departure.Track);
                var isLastOfTrack = i == Page.Departures.Count - 1 || !Page.Departures[i + 1].Track.Equals(departure.Track);
                <tr class="@(isLastOfTrack ? "last-of-track" : null)">
                    @* The track is named once, where its departures begin; the rule under its last one closes
                       the group. Named again at the top of a page, which is read on its own. *@
                    <td class="track">@(isFirstOfTrack ? departure.Track.Number : null)</td>
                    <td class="to"><span class="direction">@Translator(departure.IsArrival ? "FromPlace" : "ToPlace")</span> @departure.EndName</td>
                    <td class="composition">
                        @* Heading right, the row is laid out from the right: the loco stands at the right end
                           and everything behind it follows to the left, the rakes' own wagons included. *@
                        @{ var heading = Page.HeadingOf(departure); }
                        <div class="groups @(heading == CompositionHeading.Rightwards ? "rightwards" : "leftwards")">
                            @* The loco leads the train, so it says which way the train travels; its arrow
                               says so again for a train with nothing behind the loco to compare it with. It
                               holds what were columns of their own — when the train runs, which train it is,
                               its times here and its limit — to give the width to the wagons. *@
                            <div class="loco">
                                @if (heading == CompositionHeading.Leftwards)
                                {
                                    <span class="arrow">◀</span>
                                }
                                <SessionsView Sessions="departure.Sessions" Settings="Settings" />
                                <span class="train">@departure.TrainIdentity</span>
                                @* "-06:45" where the train starts here, "06:00-" where it ends here. *@
                                <span class="times">@departure.TimeText</span>
                                @* Last, the most the train may be made up of: its marks say which limit each
                                   figure is. Nothing at all where the train is not restricted, since a limit
                                   with no figure would read as one the planner forgot, nor on an arrival,
                                   where nothing is made up. *@
                                @if (departure.LimitText.Length > 0)
                                {
                                    <MaxLoadView Capacity="departure.Limit" />
                                }
                                @if (heading == CompositionHeading.Rightwards)
                                {
                                    <span class="arrow">▶</span>
                                }
                            </div>
                            @foreach (var group in departure.Groups)
                            {
                                @switch (group)
                                {
                                    case WagonsetComposition wagonset:
                                        @* The wagons of one rake stay together inside a shaded frame, which
                                           encloses them all so they read as one group under one turnus rather
                                           than the turnus as a further wagonset beside them. They wrap as a
                                           block within the frame. *@
                                        <div class="group wagonset">
                                            @* The turnus card the rake belongs to, unboxed on the frame's shading
                                               so it is not read as a wagon, at the front of the wagons it names:
                                               the right card is fetched out of several standing in the yard. *@
                                            <div class="turnus">
                                                <span class="designation">@wagonset.Designation</span>
                                                @* Only where the rake is in the train on some of its sessions. *@
                                                @if (wagonset.Sessions is { } sessions)
                                                {
                                                    <SessionsView Sessions="sessions" Settings="Settings" />
                                                }
                                            </div>
                                            @foreach (var wagon in wagonset.Wagons)
                                            {
                                                <div class="wagon">
                                                    <span class="class">@wagon.Class</span>
                                                    @* One line, the number beside the class, so a long rake
                                                       costs width rather than height. *@
                                                    @if (!string.IsNullOrWhiteSpace(wagon.Number))
                                                    {
                                                        <span class="number">@wagon.Number</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        break;
                                    case CargoPositionComposition cargo:
                                        <div class="group cargo">
                                            @* The places run on as one list, separated by commas, so a
                                               rectangle costs width before it costs height. Their order says
                                               nothing — they share a position, so the wagons within the
                                               rectangle stand as they like. The most that may be brought to a
                                               place follows it. *@
                                            @for (var d = 0; d < cargo.Destinations.Count; d++)
                                            {
                                                var destination = cargo.Destinations[d];
                                                <span class="destination">@destination.Html<MaxLoadView Capacity="destination.Limit" />@(d < cargo.Destinations.Count - 1 ? ", " : null)</span>
                                            }
                                        </div>
                                        break;
                                    case ArrivingCargoComposition arriving:
                                        @* Dashed, so the wagons coming off read apart from those going on:
                                           an arrival row is otherwise drawn just like a departure. The
                                           origins run on as one list, as the destinations do. *@
                                        <div class="group cargo arriving">@string.Join(", ", arriving.Origins)</div>
                                        break;
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    /// <summary>The page to print.</summary>
    [Parameter, EditorRequired] public CompositionPage Page { get; set; } = default!;

    /// <summary>
    /// Chooses sessions or days, the operating period and the day names. Build it from the layout with
    /// <c>Layout.Settings.General.SessionSettings()</c>.
    /// </summary>
    [Parameter, EditorRequired] public SessionsSettings Settings { get; set; } = default!;

    /// <summary>The name of the layout the plan is for.</summary>
    [Parameter] public string? LayoutName { get; set; }

    /// <summary>The day the report was printed.</summary>
    [Parameter] public DateOnly PrintDate { get; set; }

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private static string NamesOf(IReadOnlyList<OperationLocation> locations) =>
        string.Join(", ", locations.Select(location => location.Name));

    private string ContextLine
    {
        get
        {
            var printed = string.Format(Culture, Translator("PrintedAt"), PrintDate.ToString("yyyy-MM-dd", Culture));
            return LayoutName is { Length: > 0 } name ? $"{name} · {printed}" : printed;
        }
    }
}
