@using System.Globalization
@using Tellurian.Trains.Schedules.Planning.App.Translations

@inject Translator Translator

@* Page 1 of the general instructions booklet — the same fixed-position facts a duty booklet's front
   page opens with (see FrontDutyPage), stripped to what this wider audience actually needs. There is
   no duty number, no sessions, no operator or grading: this booklet belongs to no one duty, and its
   reader has not yet been handed anything to sort or choose between.

   What replaces them is the meeting's programme — the one thing every participant needs before the
   first session, printed here because it has nowhere else to go. *@

<div class="instructionsfront">
    <h1 class="meetingname">@MeetingName</h1>
    @if (Validity is { Length: > 0 } validity)
    {
        <p class="validity">@validity</p>
    }
    <p class="printed">@string.Format(Culture, Translator("PrintedAt"), PrintDate.ToString("yyyy-MM-dd", Culture))</p>

    @if (Program is { Length: > 0 })
    {
        <hr />
        <div class="programme">
            <h1 class="section-title">@Translator("Program")</h1>
            @((MarkupString)Markdig.Markdown.ToHtml(Program))
        </div>
    }
</div>

@code {
    /// <summary>The schedule's own name, shown as the page's heading.</summary>
    [Parameter] public string MeetingName { get; set; } = "";

    /// <summary>First day of the meeting, or null when none is booked.</summary>
    [Parameter] public DateOnly? ValidFrom { get; set; }

    /// <summary>Last day of the meeting.</summary>
    [Parameter] public DateOnly? ValidTo { get; set; }

    /// <summary>When the booklet was rendered, fixed once for the whole print run.</summary>
    [Parameter] public DateOnly PrintDate { get; set; }

    /// <summary>The authored programme, as markdown. The section is omitted entirely when empty.</summary>
    [Parameter] public string? Program { get; set; }

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    // Omitted entirely when no meeting is booked, rather than printing a placeholder date.
    private string Validity =>
        ValidFrom is { } from && ValidTo is { } to
            ? string.Format(Culture, Translator("ValidBetween"),
                from.ToString("yyyy-MM-dd", Culture), to.ToString("yyyy-MM-dd", Culture))
            : "";
}
