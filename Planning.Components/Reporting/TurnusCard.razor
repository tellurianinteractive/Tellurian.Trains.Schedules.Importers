@using Tellurian.Trains.Schedules.Planning.App.Translations
@inject Translator Translator

<PocketCard>
    @if (Item is not null)
    {
        <svg>
            <line style="stroke: @Item.CrossLineColor;" x1="100%" y1="0mm" x2="0mm" y2="91mm" />
        </svg>
        <div class="content">
            <div class="schedule header">
                <div>@Item.ObjectTypeName(Translator)</div>
                <div><strong>@Item.Display</strong></div>
                @{
                    var operatingPeriod = Item.OperatingPeriod(Translator);
                }
                @if (Item.HasClass)
                {
                    <div>
                        <span>@Item.ClassOrContentLabel(Translator):&nbsp;<strong>@Item.Class</strong></span>
                    </div>
                }
                @if (operatingPeriod.Length > 0)
                {
                    <div>
                        <svg class="cal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" role="img" aria-label="@Item.OperatingPeriodLabel(Translator)">
                            <title>@Item.OperatingPeriodLabel(Translator)</title>
                            <rect x="3" y="4" width="18" height="17" rx="2" />
                            <line x1="3" y1="9" x2="21" y2="9" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                        </svg>&nbsp;<strong>@operatingPeriod</strong>
                    </div>
                }
                
            </div>
            <div>
                @Item.Remark
            </div>
            <div class="schedule item">
                <table width="100%" style="border-collapse: collapse">
                    <thead>
                        <tr style="border-bottom: 1px solid gray">
                            <th align="left">@Translator("Train")</th>
                            <th align="left" colspan="2">@Translator("From")</th>
                            <th align="left" colspan="2">@Translator("To")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Item.TrainParts != null) foreach (var part in Item.TrainParts)
                        {
                            <tr style="border-bottom: 1px solid gray">
                                <td>@part.Train.Number</td>
                                <td>@part.From.OperationLocation.Signature</td>
                                <td>@part.From.Departure</td>
                                <td>@part.To.OperationLocation.Signature</td>
                                <td>@part.To.Arrival</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="schedule alert">
                @if (Item.TurnForNextSession)
                {
                    <span>@Translator(Item.UseDays ? "TurnForNextDay" : "TurnForNextSession")</span>
                }
            </div>
        </div>
    }
</PocketCard>

@code {
    [Parameter] public TurnusData? Item { get; set; }
}
