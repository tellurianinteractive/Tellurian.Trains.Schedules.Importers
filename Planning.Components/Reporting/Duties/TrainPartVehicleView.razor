@using Tellurian.Trains.Schedules.Planning.App.Translations
@using Tellurian.Trains.Schedules.Planning.Components.Shared

@inject Translator Translator

@{ UseReportCulture(); }

@* One vehicle block of a train part — traction units or wagonsets. The two have the same eight columns
   and differ only in what they list, so one view serves both; the heading tells them apart.

   An empty block is omitted entirely, heading and rule included, so a simple part stays short and
   costs nothing in page fitting. *@

@if (Data is { HasData: true })
{
    <div class="dutyblock @Block">
        <h3>@Translator(Heading)</h3>
        <table class="dutytrain">
            <thead>
                <tr>
                    @* "Runs", not "Sessions": the noun reaches thirteen characters in the Nordic languages
                       and would head a column holding a few circles. *@
                    <th>@Translator(SessionsHeading)</th>
                    @* The heading names the card the identity is written on, which serves locomotives and
                       wagonsets alike. *@
                    <th>@Translator("Turnus")</th>
                    <th>@Translator("From")</th>
                    <th class="track">@Translator("Track")</th>
                    <th>@Translator("Dep")</th>
                    <th>@Translator("To")</th>
                    <th class="track">@Translator("Track")</th>
                    <th>@Translator("Arr")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Data.Vehicles)
                {
                    <tr>
                        <td><SessionsView Sessions="vehicle.Sessions" Settings="Data.SessionsSettings" /></td>
                        @* The identity written on the loco or wagonset card, so the driver can match it. *@
                        <td class="designation">@vehicle.Designation</td>
                        <td>@vehicle.TrainPart.From.OperationLocation.Name</td>
                        @* The vehicle's own tracks, which differ from the train's where it is fetched from or
                           put on another track. *@
                        <td class="track">@vehicle.DepartureTrack.Number</td>
                        <td>@vehicle.TrainPart.StartTime.HHMM()</td>
                        <td>@vehicle.TrainPart.To.OperationLocation.Name</td>
                        <td class="track">@vehicle.ArrivalTrack.Number</td>
                        <td>@vehicle.TrainPart.EndTime.HHMM()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <hr />
}

@code {
    /// <summary>The vehicles to list. Nothing is rendered when the block is empty.</summary>
    [Parameter, EditorRequired] public TrainPartVehicleData? Data { get; set; }

    /// <summary>Resource key for the block heading.</summary>
    [Parameter, EditorRequired] public string Heading { get; set; } = "";

    /// <summary>The block's class in the booklet CSS, which gives it its colour bar.</summary>
    [Parameter, EditorRequired] public string Block { get; set; } = "";

    // The day names already say what the column is, so they head it as themselves.
    private string SessionsHeading =>
        Data?.SessionsSettings.UseDaysInsteadOfSessionNumbers == true ? "Days" : "SessionsShort";
}
