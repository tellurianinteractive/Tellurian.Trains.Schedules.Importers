@page "/turnuscards"
@layout PrintLayout

@inject Translator Translator
@inject ScheduleStateService ScheduleState

@if (Items == null)
{
    <DisplayedMessage ResourceKey="CreatingReport" />
}
else
{
    @* 48 x 91 mm cards on A4 landscape: 6 across, 2 down. The 4 mm page margin keeps the outermost
       cards away from the sheet edge, which most printers cannot reach. *@
    @foreach (var itemsOnPage in Items.ItemsPerPage(12))
    {
        <A4LPage Margin="4">
            <div class="pagebreak">
                @foreach (var item in itemsOnPage)
                {
                    <TurnusCard Item="@item" />
                }
            </div>
        </A4LPage>
    }

}
@code {
    private IEnumerable<TurnusData>? Items { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // The report uses PrintLayout, so MainLayout's restore never runs; ensure the plan is
        // loaded (idempotent) so opening the report directly still works.
        await ScheduleState.InitializeAsync();
        var general = ScheduleState.Layout?.Settings.General;
        var startDay = general?.StartDay ?? DayOfWeek.Monday;
        var useDays = general?.UseDays ?? false;
        var maxSessions = general?.MaxSessions ?? 14;
        Items = ScheduleState.Schedule?.ScheduledObjects.ToTurnusData(useDays, maxSessions, startDay) ?? [];
    }

}
