@page "/timetable-report"
@layout PrintLayout
@using System.Globalization
@using Tellurian.Trains.Schedules.Planning.Timetables

@inject Translator Translator
@inject ScheduleStateService ScheduleState

@* The tabular timetables, packed onto A4 landscape sheets.

   A page is a row of columns and a column a stack of blocks, because a short branch line needs nowhere near
   a whole sheet: the paginator fills the sheet with as many further stretches as its width and height hold,
   and the flex row below is what puts them side by side. Each column is given the exact width the paginator
   reserved for it, so what the estimate called a fit is what the browser lays out. *@

@if (Pages.Count == 0)
{
    <DisplayedMessage ResourceKey="TimetableNoSchedule" />
}
else
{
    @foreach (var page in Pages)
    {
        <A4LPage Margin="10">
            <div class="timetable-page">
                @foreach (var column in page.Columns)
                {
                    <div class="timetable-page-column" style="width: @Mm(column.WidthMm)">
                        @foreach (var tile in column.Tiles)
                        {
                            <TimetableStretchTable Table="tile.Table" Continued="tile.IsContinued" ShowTitle="tile.ShowTitle" />
                        }
                    </div>
                }
            </div>
        </A4LPage>
    }
}

@code {
    // Invariant, or a Swedish or German culture writes the decimal comma the CSS parser then throws away.
    private static string Mm(double value) => $"{value.ToString("0.##", CultureInfo.InvariantCulture)}mm";

    private IReadOnlyList<TimetablePage> Pages { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        await ScheduleState.InitializeAsync();
        if (ScheduleState.Timetable is not { } timetable) return;

        var trains = timetable.Trains;
        var useDays = ScheduleState.Layout?.Settings.General.UseDays ?? false;
        var maxSessions = ScheduleState.Layout?.Settings.General.MaxSessions ?? 14;
        var startDay = ScheduleState.Layout?.Settings.General.StartDay ?? DayOfWeek.Monday;
        // Stretch by stretch, both directions, in order: a stretch's Up and Down tables stay adjacent
        // so the paginator can pack them onto one page (a hard break only happens when the stretch changes).
        var tables = ScheduleState.TimetableStretches
            .SelectMany(stretch =>
                new[] { TrainGraphDirection.Upward, TrainGraphDirection.Downward }
                    .Select(dir => TimetableTable.Create(stretch, trains, dir, useDays, maxSessions, startDay))
                    // A stretch nobody stops anywhere along has no rows left to print, only headers.
                    .Where(t => t.Columns.Count > 0 && t.Rows.Count > 0));

        Pages = TimetablePaginator.BuildPages(tables, PageGeometry.A4Landscape);
    }
}
