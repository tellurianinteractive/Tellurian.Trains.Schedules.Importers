@page "/general-instructions-report"
@layout PrintLayout

@using Tellurian.Trains.Schedules.Planning.Components.Reporting.Instructions
@* Planning.Components.Layout is a namespace here, so the model type needs disambiguating. *@
@using LayoutModel = Tellurian.Trains.Schedules.Model.Layouts.Layout

@inject Translator Translator
@inject ScheduleStateService ScheduleState

@* The standing instructions for the whole meeting, as their own A5 booklet.

   Not bound into each duty booklet, for three reasons: the audience is everyone at the meeting rather
   than only the drivers — station staff need the same conventions and never hold a duty booklet; the
   content is identical in every duty, so binding it in would repeat the same pages across the whole
   pile and still miss those people; and it is read once, before the first session, whereas a duty
   booklet is carried and consulted throughout.

   Same physical format as the duty booklets, and it reuses their padding and imposition unchanged —
   both depend only on a page count. The booklet always opens with a front page (layout name, validity,
   print date, programme), then the standing instructions under their own heading, then the layout
   topology and shunting yards under theirs — appended because the people who receive this get no
   layout overview from anywhere else.

   The shunting yards table is the one part of that last page the author may move: writing a
   <ShuntingYards/> tag in the instructions prints it there instead, and takes it off the layout page,
   which a long yard list would otherwise push past the foot of. *@

@if (_sheets is null)
{
    <DisplayedMessage ResourceKey="CreatingReport" />
}
else
{
    <div class="no-print sheet-index">
        <h2>@Translator("GeneralInstructions")</h2>
        <p class="hint">@Translator("BookletPrintingHint")</p>
    </div>

    @foreach (var side in _sheets)
    {
        <A4LPage>
            <div class="dutysheet">
                <InstructionsBookletPage Page="side.Left" Layout="Layout" Program="@Program"
                                         PrintDate="_printDate" ShowShuntingYards="_showShuntingYards" />
                <InstructionsBookletPage Page="side.Right" Layout="Layout" Program="@Program"
                                         PrintDate="_printDate" ShowShuntingYards="_showShuntingYards" />
            </div>
        </A4LPage>
    }
}

@code {
    private IReadOnlyList<SheetSide<InstructionsPage>>? _sheets;
    private DateOnly _printDate;
    private bool _showShuntingYards = true;

    private LayoutModel? Layout => ScheduleState.Layout;
    private string? Program => ScheduleState.Schedule?.Program;

    protected override async Task OnInitializedAsync()
    {
        // Uses PrintLayout, so MainLayout's restore never runs; ensure the plan is loaded.
        await ScheduleState.InitializeAsync();

        // Fixed once for the whole render, so a PDF printed later still identifies the render it came from.
        _printDate = DateOnly.FromDateTime(DateTime.Now);

        var instructions = ScheduleState.Schedule?.GeneralInstructions;

        // The table goes where the author put it, and nowhere else: a booklet that printed it both in
        // the text and again at the back would leave the reader wondering which one to trust.
        _showShuntingYards = !InstructionsPlaceholders.Places(instructions, InstructionsPlaceholder.ShuntingYards);

        var pages = InstructionsPagination.BuildPages(instructions, shuntingYards: Layout?.ShuntingYards);
        _sheets = BookletImposition.Impose(pages);
    }
}
