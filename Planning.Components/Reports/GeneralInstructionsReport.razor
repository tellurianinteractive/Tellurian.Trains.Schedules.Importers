@page "/general-instructions-report"
@layout PrintLayout

@using System.Globalization
@using Tellurian.Trains.Schedules.Planning.Components.Reporting.Instructions
@* Planning.Components.Layout is a namespace here, so the model type needs disambiguating. *@
@using LayoutModel = Tellurian.Trains.Schedules.Model.Layouts.Layout

@inject Translator Translator
@inject ScheduleStateService ScheduleState

@* The standing instructions for the whole meeting, as their own A5 booklet.

   Not bound into each duty booklet, for three reasons: the audience is everyone at the meeting rather
   than only the drivers — station staff need the same conventions and never hold a duty booklet; the
   content is identical in every duty, so binding it in would repeat the same pages across the whole
   pile and still miss those people; and it is read once, before the first session, whereas a duty
   booklet is carried and consulted throughout.

   Same physical format as the duty booklets, and it reuses their padding and imposition unchanged —
   both depend only on a page count. The booklet always opens with a front page (layout name, validity,
   print date, programme), then the standing instructions under their own heading, then the layout
   topology and shunting yards under theirs — appended because the people who receive this get no
   layout overview from anywhere else.

   The shunting yards table is the one part of that last page the author may move: writing a
   <ShuntingYards/> tag in the instructions prints it there instead, and takes it off the layout page,
   which a long yard list would otherwise push past the foot of.

   An <Interchanges/> tag works the same way but has no fixed home to be moved from: the stations where
   passengers change trains are printed where the author placed the tag, and nowhere at all otherwise.

   The programme and the instructions may be written in several languages with language tags, such as
   [sv]Svensk text[/sv][nb]Norsk tekst[/nb] (see InstructionsLanguages). The whole booklet is then printed
   once per language tagged, the layout's default language first; without tags it is printed once, in
   the default language. *@

@if (_booklets is null)
{
    <DisplayedMessage ResourceKey="CreatingReport" />
}
else
{
    <div class="no-print sheet-index">
        <h2>@Translator("GeneralInstructions")</h2>
        <p class="hint">@Translator("BookletPrintingHint")</p>
    </div>

    @* One whole booklet per language, each imposed on its own and printed in its own language. *@
    @foreach (var booklet in _booklets)
    {
        if (_booklets.Count > 1)
        {
            <div class="no-print sheet-index">
                <h3>@booklet.LanguageName</h3>
            </div>
        }
        UseReportCulture(booklet.Culture);
        <CascadingValue Value="booklet.Culture">
            @foreach (var side in booklet.Sheets)
            {
                <A4LPage>
                    <div class="dutysheet">
                        <InstructionsBookletPage Page="side.Left" Layout="Layout" Program="@booklet.Program"
                                                 PrintDate="_printDate" ShowShuntingYards="booklet.ShowShuntingYards" />
                        <InstructionsBookletPage Page="side.Right" Layout="Layout" Program="@booklet.Program"
                                                 PrintDate="_printDate" ShowShuntingYards="booklet.ShowShuntingYards" />
                    </div>
                </A4LPage>
            }
        </CascadingValue>
    }
}

@code {
    private IReadOnlyList<Booklet>? _booklets;
    private DateOnly _printDate;

    /// <summary>The booklet in one language: its culture, programme, sheets, and where the yards go.</summary>
    private sealed record Booklet(
        ReportCulture Culture, string LanguageName, string Program,
        IReadOnlyList<SheetSide<InstructionsPage>> Sheets, bool ShowShuntingYards);

    private LayoutModel? Layout => ScheduleState.Layout;

    protected override async Task OnInitializedAsync()
    {
        // Uses PrintLayout, so MainLayout's restore never runs; ensure the plan is loaded.
        await ScheduleState.InitializeAsync();

        // Fixed once for the whole render, so a PDF printed later still identifies the render it came from.
        _printDate = DateOnly.FromDateTime(DateTime.Now);

        var program = ScheduleState.Schedule?.Program;
        var instructions = ScheduleState.Schedule?.GeneralInstructions;
        if (Layout is not { } layout) { _booklets = []; return; }

        // Without language tags this is the default language alone: one booklet, as it always was.
        var defaultLanguage = layout.DefaultLanguage;
        var languages = InstructionsLanguages.BookletLanguages(defaultLanguage, LanguageService.IsSupported, program, instructions);
        _booklets = [.. languages.Select(language => BookletIn(layout, language, defaultLanguage, program, instructions))];
    }

    private static Booklet BookletIn(LayoutModel layout, string language, string defaultLanguage, string? program, string? instructions)
    {
        var culture = layout.ReportCultureIn(language);
        var text = InstructionsLanguages.Resolve(instructions, language, defaultLanguage);

        // The table goes where the author put it, and nowhere else: a booklet that printed it both in
        // the text and again at the back would leave the reader wondering which one to trust. Decided
        // per language, since the tag may sit inside one language's version of a passage.
        var showShuntingYards = !InstructionsPlaceholders.Places(text, InstructionsPlaceholder.ShuntingYards);

        using var scope = ReportCulture.Use(culture);
        var pages = InstructionsPagination.BuildPages(
            text,
            shuntingYards: layout.ShuntingYards,
            passengerInterchanges: layout.PassengerInterchanges);
        return new(
            new ReportCulture(culture), LanguageNameOf(language),
            InstructionsLanguages.Resolve(program, language, defaultLanguage),
            BookletImposition.Impose(pages), showShuntingYards);
    }

    // The language's own name for itself, for the on-screen heading above its booklet.
    private static string LanguageNameOf(string language)
    {
        var culture = CultureInfo.GetCultureInfo(language);
        var name = culture.NativeName;
        return name.Length > 0 ? char.ToUpper(name[0], culture) + name[1..] : language;
    }
}
