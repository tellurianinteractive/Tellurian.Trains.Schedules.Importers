@page "/station-dispatch-report"
@layout PrintLayout

@using Tellurian.Trains.Schedules.Planning.Components.Reporting.Dispatch

@inject IJSRuntime JS
@inject Translator Translator
@inject ScheduleStateService ScheduleState

@* The sheets the person on duty at a station works from during an operating session.

   Like the duty booklets this serves operating rather than planning: it is read standing at a layout,
   under time pressure, on paper that cannot be scrolled — so a page that overflows is a bug, not a
   cosmetic issue. Every dispatch endpoint gets its own sheets, starting on a fresh page, because the
   pile is torn apart and handed to different people.

   Printed A4 landscape, one-sided. Unlike the booklets there is no imposition: these are working sheets
   to be laid out on a desk beside the phone, not folded. *@

@if (_pages is null)
{
    <ReportBusy Name="StationDispatchList" />
}
else if (_pages.Count == 0)
{
    <DisplayedMessage ResourceKey="NoDispatchStations" />
}
else
{
    @* No page footer: the heading carries the station and the interval the page covers, which is what
       identifies a sheet and what orders a station's pile. *@
    @foreach (var page in _pages)
    {
        var culture = _cultures[page.List];
        UseReportCulture(culture);
        <CascadingValue Value="culture">
            <A4LPage Margin="10" VerticalMargin="6">
                <StationDispatchTable Page="page" Settings="Settings" />
            </A4LPage>
        </CascadingValue>
    }
}

@code {
    /// <summary>
    /// Optional comma-separated station signatures to print, for a targeted reprint — a link that can be
    /// kept. Absent or empty prints every station, so the plain route keeps working unchanged.
    /// </summary>
    /// <remarks>
    /// Matched on the signature rather than the name: a signature is what identifies a location
    /// throughout the model (it is what <c>OperationLocation.Equals</c> compares), it is short enough to
    /// type into a URL, and it survives a station being renamed.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "stations")]
    public string? StationSignatures { get; set; }

    private IReadOnlyList<DispatchPage>? _pages;

    // The language each station's sheets are printed in, by its list.
    private readonly Dictionary<DispatchList, ReportCulture> _cultures = [];

    private SessionsSettings Settings =>
        ScheduleState.Layout?.Settings.General.SessionSettings() ?? SessionsSettings.UseSessions(14);

    protected override async Task OnInitializedAsync()
    {
        // The report uses PrintLayout, so MainLayout's restore never runs; ensure the plan is loaded
        // (idempotent) so opening the report directly still works.
        await ScheduleState.InitializeAsync();
        await ReportBusy.PaintAsync();

        if (ScheduleState.Layout is not { } layout || ScheduleState.Timetable is not { } timetable)
        {
            _pages = [];
            return;
        }

        var settings = Settings;
        var sessionCount = SessionsFormatting.PositionsOf(settings).Count;

        // Built in the station's own language: the list writes the sessions' texts, and the pagination
        // measures the notes'.
        var lists = new List<DispatchList>();
        var words = new HashSet<string>();
        foreach (var station in Selected(layout))
        {
            var culture = new ReportCulture(station.ReportCulture(layout, LanguageService.IsSupported));
            using var scope = ReportCulture.Use(culture.Culture);
            foreach (var list in DispatchList.CreateAll(station, timetable.Trains, settings, ScheduleState.Schedule))
            {
                _cultures[list] = culture;
                lists.Add(list);
                foreach (var note in list.Rows.SelectMany(row => row.PrintingNotes))
                    words.UnionWith(NoteTextMeasure.WordsOf(note.ToText));
            }
        }

        var geometry = DispatchPageGeometry.A4Landscape with { NoteMeasure = await MeasureAsync(words) };
        var pages = new List<DispatchPage>();
        foreach (var list in lists)
        {
            using var scope = ReportCulture.Use(_cultures[list].Culture);
            pages.AddRange(DispatchPaginator.BuildPages([list], sessionCount, geometry)
                .Select(page => page with { PageNumber = pages.Count + page.PageNumber }));
        }
        _pages = pages;
    }

    // The width of every word of the notes in the font the report is set in, measured by the browser. The
    // font is the planner's choice, so no fixed character width fits it. Null when the browser cannot
    // measure, which leaves the pagination on its character estimate.
    private async Task<NoteTextMeasure?> MeasureAsync(HashSet<string> words)
    {
        if (words.Count == 0) return null;
        try
        {
            var list = words.ToList();
            await using var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Tellurian.Trains.Schedules.Planning.Components/js/text-width.js");
            var font = ReportFonts.CssFontFamily(ScheduleState.Layout?.Settings.General.ReportFontFamily);
            var widths = await module.InvokeAsync<double[]>("measure", font, DispatchPageGeometry.FontSizePt, list);
            if (widths.Length != list.Count + 1) return null;
            return new NoteTextMeasure(
                list.Select((word, i) => (word, width: widths[i])).ToDictionary(x => x.word, x => x.width),
                widths[^1]);
        }
        catch (JSException)
        {
            return null;
        }
    }

    // The stations that get a list: every station with a dispatcher — manned stations, and shadow
    // stations whether manned or not — in layout order, narrowed by the query parameter when one is given.
    // Selection changes WHICH stations print, never their order.
    private IReadOnlyList<Station> Selected(Model.Layouts.Layout layout)
    {
        var all = layout.Dispatchers.ToList();
        if (string.IsNullOrWhiteSpace(StationSignatures)) return all;

        var wanted = StationSignatures
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        return [.. all.Where(station => wanted.Contains(station.Signature, StringComparer.OrdinalIgnoreCase))];
    }
}
