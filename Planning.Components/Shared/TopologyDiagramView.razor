@namespace Tellurian.Trains.Schedules.Planning.Components.Shared
@using System.Globalization

@* The schematic of the layout's timetable stretches, drawn from the pure TopologyDiagram.Build result.

   Shared between the Stretches tab and the duty booklet's overview page, so a driver meets the same
   diagram on paper that the planner drew on screen. Being SVG it prints reliably: browsers drop
   background colours when printing, but strokes and fills always print. *@

@if (Diagram is { } diagram)
{
    <svg class="topology-svg" viewBox="0 0 @F(diagram.Width) @F(diagram.Height)"
         width="100%" preserveAspectRatio="xMidYMid meet"
         xmlns="http://www.w3.org/2000/svg">
        @foreach (var connector in diagram.Connectors)
        {
            @* Diagonal and the first bit of the branch's own line in one path: a rounded join fills the
               corner between them, which two separate strokes butting together leave notched. *@
            <path d="M @F(connector.JunctionX) @F(connector.JunctionY) L @F(connector.LineX) @F(connector.LineY) L @F(connector.StubX) @F(connector.LineY)"
                  fill="none" stroke="@connector.Color" stroke-width="10" stroke-linejoin="round" />
        }
        @foreach (var line in diagram.Lines)
        {
            @foreach (var section in line.Sections)
            {
                @* A double-track section is drawn as the two tracks it has, a single-track one as one line.
                   Timetable stretches sharing a section are laid over it as dashes instead of as further
                   lines, which would be read as more tracks than the section really has. *@
                @foreach (var offset in TrackOffsets(section.Tracks))
                {
                    <line x1="@F(section.FromX)" y1="@F(line.Y + offset)" x2="@F(section.ToX)" y2="@F(line.Y + offset)"
                          stroke="@section.Color" stroke-width="@F(TrackWidth(section.Tracks))" />
                }
                @foreach (var (shared, index) in section.SharedColors.Select((c, i) => (c, i)))
                {
                    <line x1="@F(section.FromX)" y1="@F(line.Y)" x2="@F(section.ToX)" y2="@F(line.Y)"
                          stroke="@shared" stroke-width="@F(SharedWidth)" stroke-linecap="butt"
                          stroke-dasharray="@DashPattern" stroke-dashoffset="@F(index * DashStep)" />
                }
            }
            <SvgText X="line.StartX - TopologyDiagram.NumberOffset" Y="line.Y + 4" Anchor="end"
                     Fill="@TextColor" FontSize="TopologyDiagram.FontSize" FontWeight="600" Text="@line.Number" />
            @foreach (var node in line.Nodes.Where(n => !n.Hidden))
            {
                <circle cx="@F(node.X)" cy="@F(node.Y)" r="5"
                        fill="#fff" stroke="@line.Color" stroke-width="2" />
                <SvgText X="node.X" Y="node.Y + (node.LabelBelow ? LabelDrop : -LabelRise)" Anchor="middle"
                         Fill="@TextColor" FontSize="TopologyDiagram.FontSize" FontWeight="600" Text="@node.Signature" />
            }
        }
    </svg>
}

@code {
    /// <summary>The layout to draw. Nothing is rendered when it has no stretches to show.</summary>
    [Parameter, EditorRequired] public Layout? Layout { get; set; }

    // Text stays a neutral black regardless of each line's colour, so labels never clash with a
    // similarly-coloured line and remain equally legible across the whole diagram.
    private const string TextColor = "#223";

    // A section is drawn to the same overall weight whether it is single or double track, so that the number
    // of tracks reads from the gap between them rather than from the line getting heavier. Two tracks of
    // TrackWidth centred TrackGap apart leave a clear gap between them and still span the single line's 10.
    private const double SectionWidth = 10.0;
    private const double TrackGap = 6.5;

    // Where a station's signature sits relative to its circle. Above it by default; below it — far enough
    // down to clear the circle and sit on its own baseline — where a branch climbs away from that station.
    private const double LabelRise = 10.0;
    private const double LabelDrop = 22.0;

    // Dashes of a sharing stretch's colour laid over a section: short enough to read as an overlay rather
    // than as the section's own colour, and stepped so two sharing stretches do not fall on each other.
    private const double SharedWidth = 5.0;
    private const double DashStep = 8.0;
    private const string DashPattern = "5 11";

    // Where each track of a section sits relative to the line: one track on the line itself, two straddling
    // it evenly. More than two are spread the same way, out from the middle.
    private static IEnumerable<double> TrackOffsets(int tracks) =>
        tracks <= 1
            ? [0.0]
            : Enumerable.Range(0, tracks).Select(i => (i - ((tracks - 1) / 2.0)) * TrackGap);

    private static double TrackWidth(int tracks) => tracks <= 1 ? SectionWidth : 4.0;

    private TopologyDiagram? Diagram =>
        Layout is null || Layout.TimetableStretches.All(s => s.Stretches.Count == 0)
            ? null
            : TopologyDiagram.Build(Layout);

    // SVG requires '.' as the decimal separator regardless of UI culture.
    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
