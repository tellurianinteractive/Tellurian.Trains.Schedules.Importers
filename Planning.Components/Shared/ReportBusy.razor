@inject Translator Translator

@* The modal shown in the report window while a report is being built. A report renders it in place of
   its content until the content exists, so it closes by itself when the report is ready. *@
<div class="report-busy no-print" role="alertdialog" aria-modal="true" aria-live="polite">
    <div class="report-busy-dialog">
        <div class="spinner" aria-hidden="true"></div>
        <p>@Translator("CreatingReportNamed").Replace("{0}", Translator(Name))</p>
    </div>
</div>

@code {
    /// <summary>The label key of the report's name, as the Reports menu shows it.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>
    /// Gives the browser a moment to paint the dialog. Building a report is synchronous, so without this
    /// the dialog would only appear once the work it announces is already done.
    /// </summary>
    public static Task PaintAsync() => Task.Delay(50);
}
