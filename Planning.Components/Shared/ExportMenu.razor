@using Tellurian.Trains.Schedules.Planning.Components.Reporting.Dispatch
@using Tellurian.Trains.Schedules.Planning.Components.Reporting.Odt

@inject ScheduleStateService ScheduleState
@inject ScheduleExportService Exporter
@inject ModuleRegistryUploadService Uploader
@inject IJSRuntime JS
@inject Translator Translator

<TabMenu @ref="_menu" Label="@Translator("Export")">
    <button class="menu-item" @onclick="OpenSaveAs" disabled="@(!ScheduleState.HasSchedule)">@Translator("SaveAs")</button>
    <button class="menu-item" @onclick="OpenDispatchLists" disabled="@(!ScheduleState.HasSchedule)">@Translator("DispatchLists")</button>
</TabMenu>

@if (_showSaveAs)
{
    <div class="dialog-backdrop" @onclick="CloseSaveAs">
        <div class="dialog" @onclick:stopPropagation>
            <h3>@Translator("SaveAs")</h3>
            <p>@((MarkupString)string.Format(Translator("DownloadAs"), System.Net.WebUtility.HtmlEncode(ScheduleState.Schedule?.Name ?? "")))</p>

            <div class="export-row">
                <span class="fmt">JSON<span class="ext">.json</span></span>
                <button class="dest" disabled="@_busy" @onclick="SaveJsonToDisk">@Translator("ToDisk")</button>
                <button class="dest" disabled="@_busy" @onclick="SendJsonToModuleRegistry">@Translator("ToModuleRegistry")</button>
            </div>
            <div class="export-row dim">
                <span class="fmt">SQLite<span class="ext">.db</span></span>
                <span class="note">@Translator("SqliteViaModuleRegistry")</span>
            </div>

            @if (_busy)
            {
                <p class="status busy"><span class="spinner"></span>@Translator(_busyKey!)</p>
            }
            else if (_result is not null)
            {
                <p class="status @(_resultOk ? "ok" : "err")">@_result</p>
            }

            <div class="dialog-actions">
                <button @onclick="CloseSaveAs" disabled="@_busy">@Translator("Close")</button>
            </div>
        </div>
    </div>
}

@* The station dispatch lists as editable documents — a report leaving the app rather than the plan in
   another format, which is why it is its own entry and not a row in Save as. *@
@if (_showDispatchLists)
{
    <div class="dialog-backdrop" @onclick="CloseDispatchLists">
        <div class="dialog" @onclick:stopPropagation>
            <h3>@Translator("DispatchLists")</h3>
            <p>@Translator("DispatchListsHint")</p>

            @if (DispatchStationCount == 0)
            {
                <div class="export-row dim">
                    <span class="note">@Translator("NoDispatchStations")</span>
                </div>
            }
            else
            {
                <div class="export-row">
                    <span class="fmt">ODT<span class="ext">@(DispatchStationCount == 1 ? ".odt" : ".zip")</span></span>
                    <button class="dest" disabled="@_busy" @onclick="SaveDispatchListsToDisk">@Translator("ToDisk")</button>
                </div>
            }

            @if (_busy)
            {
                <p class="status busy"><span class="spinner"></span>@Translator(_busyKey!)</p>
            }
            else if (_result is not null)
            {
                <p class="status @(_resultOk ? "ok" : "err")">@_result</p>
            }

            <div class="dialog-actions">
                <button @onclick="CloseDispatchLists" disabled="@_busy">@Translator("Close")</button>
            </div>
        </div>
    </div>
}

@code {
    private TabMenu? _menu;
    private bool _showSaveAs;
    private bool _busy;
    private string? _busyKey;
    private string? _result;
    private bool _resultOk;
    private bool _showDispatchLists;
    private IJSObjectReference? _downloadModule;

    // Every station a dispatcher works: manned stations and shadow stations, in layout order. Read rather
    // than cached, because the dialog can be opened again after a station has been marked manned.
    private IReadOnlyList<Station> DispatchStations =>
        ScheduleState.Layout is { } layout ? [.. layout.DispatchEndpoints] : [];

    private int DispatchStationCount => DispatchStations.Count;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _downloadModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Tellurian.Trains.Schedules.Planning.Components/js/download.js");
    }

    private void OpenSaveAs()
    {
        _menu?.Close();
        _result = null;
        _showSaveAs = true;
    }

    private void CloseSaveAs()
    {
        if (_busy) return;
        _showSaveAs = false;
    }

    private void OpenDispatchLists()
    {
        _menu?.Close();
        _result = null;
        _showDispatchLists = true;
    }

    private void CloseDispatchLists()
    {
        if (_busy) return;
        _showDispatchLists = false;
    }

    // Show the spinner before the (synchronous, UI-thread-blocking) serialize: flip to busy, render,
    // then yield so the browser repaints before the heavy work starts.
    private async Task BeginBusy(string key)
    {
        _result = null;
        _busyKey = key;
        _busy = true;
        StateHasChanged();
        await Task.Delay(1);
    }

    private async Task SaveJsonToDisk()
    {
        if (ScheduleState.Schedule is not { } plan) return;
        if (_downloadModule is null) return;
        var fileName = $"{SafeFileName(plan.Name)}.json";

        // openSaveFilePicker must be called while user activation is live — before BeginBusy yields.
        // Returns true (handle stored in JS), null (user cancelled), false (API not supported).
        var pickerResult = await _downloadModule.InvokeAsync<bool?>("openSaveFilePicker", fileName, "application/json");
        if (pickerResult == null) return; // user cancelled

        await BeginBusy("Saving");
        try
        {
            var json = Exporter.ToJson(plan);
            if (pickerResult == true)
                await _downloadModule.InvokeVoidAsync("writePendingText", json);
            else
                await _downloadModule.InvokeVoidAsync("downloadText", fileName, json, "application/json");
            _showSaveAs = false;
        }
        catch (Exception ex)
        {
            _resultOk = false;
            _result = string.Format(Translator("ExportFailed"), ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendJsonToModuleRegistry()
    {
        if (ScheduleState.Schedule is not { } plan) return;
        await BeginBusy("Sending");
        try
        {
            var integration = ScheduleState.Layout?.Settings.Integration;
            var json = Exporter.ToJson(plan);
            var result = await Uploader.UploadJsonAsync(integration?.ModuleRegistryApiUrl, integration?.ModuleRegistryApiKey, json);
            _resultOk = result.Success;
            _result = result.Success
                ? Translator("UploadSucceeded")
                : result.Message == "MissingUrl"
                    ? Translator("ModuleRegistryUrlMissing")
                    : string.Format(Translator("UploadFailed"), result.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    /* One editable document per station, which is what gets sent: a station's owner is emailed their own
       station and edits it without touching anybody else's. Several are zipped only because a browser
       hands over one file per gesture — the recipient never sees the bundle.

       Unlike the JSON export this needs no save picker: it is generated in milliseconds, so there is
       nothing to serialize behind a dialog that is already open, and the anchor download keeps the code to
       the one path that works in every browser. */
    private async Task SaveDispatchListsToDisk()
    {
        if (ScheduleState.Timetable is not { } timetable) return;
        if (_downloadModule is null) return;

        await BeginBusy("Saving");
        try
        {
            var settings = ScheduleState.Layout?.Settings.General.SessionSettings()
                ?? SessionsSettings.UseSessions(14);
            var lists = DispatchStations
                .Select(station => DispatchList.Create(station, timetable.Trains, settings))
                .ToList();

            // Set in the layout's report font, like every other report — the recipient can still
            // restyle it, since these are named styles rather than direct formatting.
            var font = ScheduleState.Layout?.Settings.General.ReportFontFamily;
            var single = lists.Count == 1;
            var bytes = single
                ? StationDispatchOdt.Create(lists[0], settings, Translator, DateTimeOffset.Now, font)
                : StationDispatchOdt.CreateBundle(lists, settings, Translator, DateTimeOffset.Now, font);
            var fileName = single
                ? StationDispatchOdt.FileNameOf(lists[0])
                : $"{SafeFileName($"{timetable.Name} {Translator("DispatchLists")}")}.zip";

            await _downloadModule.InvokeVoidAsync(
                "downloadBytes", fileName, Convert.ToBase64String(bytes),
                single ? OdtPackage.MediaType : OdtPackage.ZipMediaType);
            _showDispatchLists = false;
        }
        catch (Exception ex)
        {
            _resultOk = false;
            _result = string.Format(Translator("ExportFailed"), ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string SafeFileName(string name)
    {
        var cleaned = string.Join("_", name.Split(Path.GetInvalidFileNameChars(), StringSplitOptions.RemoveEmptyEntries));
        return string.IsNullOrWhiteSpace(cleaned) ? "schedule" : cleaned;
    }
}
