@namespace Tellurian.Trains.Schedules.Planning.Components.Scheduling
@using Tellurian.Trains.Schedules.Model
@using Tellurian.Trains.Schedules.Model.Validations
@using Tellurian.Trains.Schedules.Planning.Components.Scheduling

@if (Current is null)
{

}
else
{
    <div class="graph-container">
        <svg style="border: 1pt solid black " height="@Current.Height()" width="@Current.Width()" @onclick="OnClick" @onmousedown="OnMouseDown">
            <defs>
                @* Semi-transparent white box behind a minute label: the train lines still show through, but the
                   digits stay readable where a label sits on a line. Region is padded slightly around the text. *@
                <filter x="-0.15" y="-0.05" width="1.3" height="1.1" id="minutebackground">
                    <feFlood flood-color="white" flood-opacity="0.5" result="bg" />
                    <feMerge>
                        <feMergeNode in="bg" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
            </defs>
            @* Draw hours. Gridlines sit on whole hours, so start at the first whole hour at or after the
               axis start (which may be a half hour such as 04:30) — otherwise the lines land on the half
               hour but are labelled as whole hours, making trains look offset from them. *@
            @for (var time = FirstWholeHour(Current.StartTime); time <= Current.EndTime; time += TimeSpan.FromHours(1))
            {
                var hourOffset = Current.TimeAxisLabelOffset(time);
                <text>
                    <text class="@Current.AxisDirection.OrientationCss("hour")" x="@hourOffset.X" y="@hourOffset.Y">@((int)time.TotalHours)</text>
                </text>
                var timeLine = Current.TimeLine(time);
                <line class="timeline" x1="@timeLine.Start.X" y1="@timeLine.Start.Y" x2="@timeLine.End.X" y2="@timeLine.End.Y"></line>
            }

            @* Draw stations *@
            @for (var s = 0; s < Current.Stations.Length; s++)
            {
                var station = Current.Stations[s];
                var stationTracks = station.Tracks.ToArray();
                var stationOffset = Current.StationLabelOffset(s);
                var kmOffset = Current.KmLabelOffset(s);
                <text>
                    <text>
                        <tspan x="@stationOffset.X" y="@stationOffset.Y" class="@Current.AxisDirection.OrientationCss("stationname")">@station.NameLabel()</tspan>
                        <tspan x="@kmOffset.X" y="@kmOffset.Y" class="@Current.AxisDirection.OrientationCss("stationkm")">@station.KmLabel(Current.TimetableStretch)</tspan>
                    </text>
                </text>
                @* Draw station tracks *@
                @for (var t = 0; t < stationTracks.Length; t++)
                {
                    var track = stationTracks[t];
                    var trackNumber = Current.TrackNumberOffset(s, t);
                    <text>
                        <text class="@Current.AxisDirection.OrientationCss("number")" x="@trackNumber.X" y="@trackNumber.Y">@track.Number</text>
                    </text>
                    var trackLine = Current.TrackLine(s, t);
                    <line stroke="@TrackStroke(track)" x1="@trackLine.Start.X" y1="@trackLine.Start.Y" x2="@trackLine.End.X" y2="@trackLine.End.Y"></line>
                }
            }

            @* Draw trains at stations *@
            @for (var s = 0; s < Current.Stations.Length; s++)
            {
                var station = Current.Stations[s];
                var stationTracks = station.Tracks.ToArray();
                @for (var t = 0; t < stationTracks.Length; t++)
                {
                    var track = stationTracks[t];
                    @foreach (var stationCall in Current.Trains.SelectMany(tr => tr.Calls.Where(c => track.Equals(c.Track) && station.Equals(c.Track.Station))))
                    {
                        @foreach (var trackLine in Current.TrainAtStationLine(s, t, stationCall))
                        {
                            <line class="@ConflictCss(stationCall.Train)" stroke="@TrainStroke(stationCall.Train)" stroke-width="@TrainStrokeWidth" x1="@trackLine.Start.X" y1="@trackLine.Start.Y" x2="@trackLine.End.X" y2="@trackLine.End.Y">@if (ConflictTitle(stationCall.Train) is { } ct) { <title>@ct</title> }</line>
                        }
                    }
                }
            }

            @* Draw trains between stations (forward direction) *@
            @for (var toStationIndex = 1; toStationIndex < Current.Stations.Length; toStationIndex++)
            {
                var fromStationIndex = toStationIndex - 1;
                var fromStation = Current.Stations[fromStationIndex];
                var toStation = Current.Stations[toStationIndex];
                var fromTracks = fromStation.Tracks.ToArray();
                var toTracks = toStation.Tracks.ToArray();

                @for (var fromTrackIndex = 0; fromTrackIndex < fromTracks.Length; fromTrackIndex++)
                {
                    var fromTrack = fromTracks[fromTrackIndex];
                    for (var toTrackIndex = 0; toTrackIndex < toTracks.Length; toTrackIndex++)
                    {
                        var toTrack = toTracks[toTrackIndex];

                        @foreach (var stretch in Current.Trains.SelectMany(t => t.StretchUses().Where(c => fromStation.Equals(c.From.Track.Station) && c.From.Track.Equals(fromTrack) && toStation.Equals(c.To.Track.Station) && c.To.Track.Equals(toTrack))))
                        {
                            @foreach (var trackLine in Current.TrainBetweenStationsLine(fromStationIndex, fromTrackIndex, toStationIndex, toTrackIndex, stretch.From.Departure, stretch.To.Arrival))
                            {
                                <line class="@ConflictCss(stretch.Train)" stroke="@TrainStroke(stretch.Train)" stroke-width="@TrainStrokeWidth" x1="@trackLine.Start.X" y1="@trackLine.Start.Y" x2="@trackLine.End.X" y2="@trackLine.End.Y">@if (ConflictTitle(stretch.Train) is { } ct) { <title>@ct</title> }</line>
                            }
                        }
                    }
                }
            }

            @* Draw trains between stations (reverse direction) *@
            @for (var fromStationIndex = Current.Stations.Length - 1; fromStationIndex > 0; fromStationIndex--)
            {
                var toStationIndex = fromStationIndex - 1;
                var fromStation = Current.Stations[fromStationIndex];
                var toStation = Current.Stations[toStationIndex];
                var fromTracks = fromStation.Tracks.ToArray();
                var toTracks = toStation.Tracks.ToArray();

                @for (var fromTrackIndex = 0; fromTrackIndex < fromTracks.Length; fromTrackIndex++)
                {
                    var fromTrack = fromTracks[fromTrackIndex];
                    for (var toTrackIndex = 0; toTrackIndex < toTracks.Length; toTrackIndex++)
                    {
                        var toTrack = toTracks[toTrackIndex];

                        @foreach (var stretch in Current.Trains.SelectMany(t => t.StretchUses().Where(c => fromStation.Equals(c.From.Track.Station) && c.From.Track.Equals(fromTrack) && toStation.Equals(c.To.Track.Station) && c.To.Track.Equals(toTrack))))
                        {
                            @foreach (var trackLine in Current.TrainBetweenStationsLine(fromStationIndex, fromTrackIndex, toStationIndex, toTrackIndex, stretch.From.Departure, stretch.To.Arrival))
                            {
                                <line class="@ConflictCss(stretch.Train)" stroke="@TrainStroke(stretch.Train)" stroke-width="@TrainStrokeWidth" x1="@trackLine.Start.X" y1="@trackLine.Start.Y" x2="@trackLine.End.X" y2="@trackLine.End.Y">@if (ConflictTitle(stretch.Train) is { } ct) { <title>@ct</title> }</line>
                            }
                        }
                    }
                }
            }

            @* Draw all arrival/departure minute labels above the graph lines. Each is anchored by a corner at
               its call point (chosen from the line's slope and whether it is an arrival or departure) and drawn
               semi-transparent so the train lines stay visible through it. *@
            @foreach (var minute in Current.MinuteLabels())
            {
                <text>
                    <text filter="url(#minutebackground)" class="@Current.AxisDirection.OrientationCss("minute")" x="@minute.Point.X" y="@minute.Point.Y" text-anchor="@minute.TextAnchor" dominant-baseline="@minute.DominantBaseline">@minute.Text</text>
                </text>
            }

            @* Draw all train identity labels last so they sit on top of every graph line. Each label runs
               along its own train-line segment via <textPath>, so it follows the line's real slope and sits
               cleanly beside it for both travel directions. The path is invisible (the line itself is drawn
               above); it exists only to lay out the text. *@
            @{ var labelIndex = 0; }
            @foreach (var label in Current.VisibleTrainLabels())
            {
                var pathId = $"trainlabelpath-{InstanceId}-{labelIndex++}";
                var startOffset = (label.Offset * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                <path id="@pathId" fill="none" stroke="none" d="M @label.Start.X,@label.Start.Y L @label.End.X,@label.End.Y"></path>
                <text>
                    <text class="trainlabel" style="font-size:@(Current.GraphSettings.TrainLabelFontPoints)pt" dy="@LabelOffsetDy"><textPath href="#@pathId" startOffset="@startOffset%">@label.Train.GraphLabel(Current.GraphSettings)</textPath></text>
                </text>
            }
        </svg>
    </div>
}

@code
{
    [Parameter] public GraphSchedule? Schedule { get; set; }

    /// <summary>Validation errors for the plan; the graph highlights the trains involved in those that
    /// touch a track it shows. Passed from the tab, sourced from the shared ValidationStateService.</summary>
    [Parameter] public IReadOnlyList<ValidationError> Errors { get; set; } = [];

    GraphSchedule? Current;

    // Trains drawn in this graph that are involved in a validation error touching a track shown here,
    // mapped to the newline-joined messages shown as a hover tooltip. Rebuilt when parameters change.
    readonly Dictionary<Train, string> _conflictTitles = [];

    // Unique per component instance so the <textPath> path IDs don't collide when several
    // GraphicalScheduleEditor instances render into the same document. SVG resolves href="#id"
    // to the first matching element, so duplicate IDs make later schedules lay their labels out
    // along the first schedule's paths, scattering them.
    readonly string InstanceId = Guid.NewGuid().ToString("N");

    // The first whole hour at or after the given time, computed in integer minutes to avoid
    // floating-point drift (so an exact whole hour is returned unchanged, not rounded up).
    static TimeSpan FirstWholeHour(TimeSpan time)
    {
        var minutes = (int)Math.Round(time.TotalMinutes);
        return TimeSpan.FromMinutes((minutes + 59) / 60 * 60);
    }

    string TrackStroke(StationTrack t) => t.IsMain ? "#404040" : t.IsScheduled ? "#bfbfbf" : "#ff8080";
    string TrainStroke(Train t) => t.Category?.Color ?? "#000000";
    const double TrainStrokeWidthValue = 2;
    string TrainStrokeWidth => TrainStrokeWidthValue.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Fixed perpendicular lift (px) of a train identity label off its line, via <textPath> dy, so the
    // digits sit just beside the line rather than on it. Negative lifts to the side the glyphs already
    // occupy, consistently for both slope directions. 2px ≈ one graph-thickness.
    const string LabelOffsetDy = "-2";

    protected override void OnParametersSet()
    {
        Current = Schedule;
        BuildConflicts();
    }

    private void BuildConflicts()
    {
        _conflictTitles.Clear();
        if (Current is null || Errors.Count == 0) return;
        // Restrict to errors whose location is on this stretch, so a train is not flagged on a graph
        // where its conflict does not occur (the same train may run on several stretches).
        var graphTracks = Current.Stations.SelectMany(s => s.Tracks).ToList();
        foreach (var train in Current.Trains)
        {
            var messages = Errors
                .Where(e => e.Scope == ValidationScope.Train && e.Involves(train) && graphTracks.Any(t => e.Involves(t)))
                .Select(e => e.Message.Text)
                .Distinct()
                .ToList();
            if (messages.Count > 0) _conflictTitles[train] = string.Join("\n", messages);
        }
    }

    private string? ConflictCss(Train train) => _conflictTitles.ContainsKey(train) ? "conflict" : null;

    private string? ConflictTitle(Train train) => _conflictTitles.GetValueOrDefault(train);

    void OnClick(MouseEventArgs e)
    {
    }

    void OnMouseDown(MouseEventArgs e)
    {
    }
}
