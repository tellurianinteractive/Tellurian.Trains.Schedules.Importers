@namespace Tellurian.Trains.Schedules.Planning.Components.Schedules
@using System.Globalization
@using Tellurian.Trains.Schedules.Planning.Components.Services
@inject ScheduleStateService ScheduleState
@inject Translator Translator

@* Assigns a vehicle to a schedule: pick one from the pool, or create a new one (type, operator, number,
   class) on the spot. A schedule may carry several vehicles (e.g. a loco and its coach set).

   The new-vehicle fields are ordered as in the edit dialog: what kind of vehicle it is, then what
   identifies it, then how it is described. Operator and number are the vehicle's identity, so a number
   is required and one another vehicle already claims is refused here (rule P5) — a newly created vehicle
   takes every session it is free for, so it would clash with any vehicle already carrying that identity. *@

@if (Plan is not null)
{
    <div class="assign-vehicle-backdrop">
        <div class="assign-vehicle-dialog">
            <h3>@Translator("AssignVehicle")</h3>

            @if (_creatingNew)
            {
                <fieldset class="new-vehicle">
                    <legend>@Translator("CreateNewVehicle")</legend>
                    <div class="field">
                        <label>@Translator("VehicleType")</label>
                        <select value="@_newType" @onchange="e => { _newType = e.Value?.ToString() ?? _newType; }">
                            @foreach (var type in CreatableTypes)
                            {
                                <option value="@type">@Translator(type.ToString())</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>@Translator("Operator")</label>
                        <select value="@(_newCompanyId?.ToString() ?? string.Empty)" @onchange="OnCompanyChanged">
                            <option value="">@Translator("None")</option>
                            @foreach (var company in Companies)
                            {
                                <option value="@company.Id">@company.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>@Translator("Number")</label>
                        @* Entered on input, not on change, so the Assign button and the identity-in-use check
                           follow what is typed instead of waiting for the field to lose focus. *@
                        <input type="number" class="num" min="1" value="@_newNumber"
                               @oninput="e => { _newNumber = ParseOptionalInt(e); _error = null; }" />
                    </div>
                    <div class="field">
                        <label>@Translator("Class")</label>
                        <input type="text" value="@_newClass" @onchange="e => _newClass = e.Value?.ToString() ?? string.Empty" />
                    </div>
                </fieldset>
                @if (AvailableVehicles.Count > 0)
                {
                    <button class="toggle" @onclick="() => { _creatingNew = false; _error = null; }">@Translator("ChooseExistingVehicle")</button>
                }
            }
            else
            {
                <div class="field">
                    <label>@Translator("Vehicle")</label>
                    <select value="@(_existingId?.ToString() ?? string.Empty)" @onchange="OnExistingChanged">
                        <option value="">—</option>
                        @foreach (var vehicle in AvailableVehicles)
                        {
                            <option value="@vehicle.Id">@VehicleLabel(vehicle)</option>
                        }
                    </select>
                </div>
                <button class="toggle" @onclick="() => { _creatingNew = true; _error = null; }"><i class="fa-solid fa-plus"></i> @Translator("CreateNewVehicle")</button>
            }

            @if (CanChooseRole)
            {
                <div class="field">
                    <label title="@Translator("TractionRoleHelp")">@Translator("TractionRole")</label>
                    <select value="@_role" @onchange="e => _role = Enum.TryParse<TractionRole>(e.Value?.ToString(), out var r) ? r : _role">
                        @foreach (var role in Enum.GetValues<TractionRole>())
                        {
                            <option value="@role">@Translator("TractionRole" + role)</option>
                        }
                    </select>
                </div>
            }

            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }
            else if (ClaimedBy is { } other)
            {
                <p class="error">@IdentityInUseMessage(other)</p>
            }

            <div class="actions">
                <button class="primary" disabled="@(!CanAssign)" @onclick="Assign">@Translator("Assign")</button>
                <button @onclick="Abort">@Translator("Abort")</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The schedule the vehicle is assigned to.</summary>
    [Parameter, EditorRequired] public Schedule Schedule { get; set; } = default!;

    /// <summary>Raised after a vehicle has been assigned and saved.</summary>
    [Parameter] public EventCallback OnAssigned { get; set; }

    /// <summary>Raised when the dialog is dismissed without assigning a vehicle.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private static readonly ScheduledObjectType[] CreatableTypes =
        [ScheduledObjectType.Locomotive, ScheduledObjectType.Trainset, ScheduledObjectType.Wagonset];

    private Plan? Plan => ScheduleState.Schedule;

    private bool UseDays => ScheduleState.Layout?.Settings.General.UseDays ?? false;
    private int MaxSessions => ScheduleState.Layout?.Settings.General.MaxSessions ?? 14;
    private DayOfWeek StartDay => ScheduleState.Layout?.Settings.General.StartDay ?? DayOfWeek.Monday;

    private bool _creatingNew;
    private TractionRole _role;

    // Only a traction unit has a place in the train. Its partner may work the train from a schedule of its own,
    // so the role is offered whether or not this schedule has another traction unit.
    private bool CanChooseRole =>
        _creatingNew
            ? Enum.TryParse<ScheduledObjectType>(_newType, out var type) && type != ScheduledObjectType.Wagonset
            : Plan?.ScheduledObjects.FirstOrDefault(v => v.Id == _existingId)?.IsTraction == true;
    private int? _existingId;
    private string _newType = ScheduledObjectType.Locomotive.ToString();
    private string _newClass = "";
    // Null while the field is empty or holds something that is not a number, which keeps the Assign
    // button disabled and lets the field show what was typed rather than an old value.
    private int? _newNumber;
    private int? _newCompanyId;
    private string? _error;

    // Start straight in create mode when there is no existing vehicle to choose.
    protected override void OnInitialized() => _creatingNew = AvailableVehicles.Count == 0;

    // Real vehicles (not cargo flows) not already on this schedule and with a session of the operating period
    // on which they are not already working something at the same time as this schedule, ordered by identity.
    // A vehicle booked on every session stays selectable when its other work runs at other times. A
    // partly-booked vehicle's free sessions are shown; assigning it takes exactly those free sessions.
    private IReadOnlyList<ScheduledObject> AvailableVehicles =>
        Plan is null ? [] :
        [.. Plan.ScheduledObjects
            .Where(v => v.HasTurnusCard
                        && !Schedule.Vehicles.Contains(v)
                        && !FreeSessions(v).ComplementWithin(UseDays, MaxSessions).CoversAllWithin(UseDays, MaxSessions))
            .OrderBy(v => v.Designation, StringComparer.CurrentCulture)];

    private Sessions FreeSessions(ScheduledObject vehicle) => vehicle.FreeSessionsFor(Schedule, UseDays, MaxSessions);

    private IEnumerable<Company> Companies =>
        (Plan?.Layout?.Companies ?? []).OrderBy(c => c.Name, StringComparer.CurrentCulture);

    private bool CanAssign =>
        _creatingNew ? _newNumber is > 0 && ClaimedBy is null : _existingId is not null;

    // The vehicle already carrying the entered operator and number, or null when the identity is free. A
    // vehicle created here is given no external id, so operator and number identify it; and it takes every
    // session it is free for, so it is measured against all of them (see Plan.VehicleClaiming, rule P5).
    private ScheduledObject? ClaimedBy =>
        !_creatingNew || _newNumber is not > 0 ? null
            : Plan?.VehicleClaiming(VehicleIdentity.Of(_newCompanyId, _newNumber.Value), Sessions.All);

    private string IdentityInUseMessage(ScheduledObject other) =>
        string.Format(CultureInfo.CurrentCulture, Translator("VehicleIdentityAlreadyUsed"), other.IdentityText, other.Designation);

    private void OnExistingChanged(ChangeEventArgs e)
    {
        _existingId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _error = null;
    }

    private void OnCompanyChanged(ChangeEventArgs e) =>
        _newCompanyId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private async Task Assign()
    {
        _error = null;
        if (Plan is not { } plan || !CanAssign) return;

        ScheduledObject? vehicle;
        if (_creatingNew)
        {
            if (_newNumber is not { } number) return;
            var type = Enum.TryParse<ScheduledObjectType>(_newType, out var t) ? t : ScheduledObjectType.Locomotive;
            var company = _newCompanyId is int id ? plan.Layout.Companies.FirstOrDefault(c => c.Id == id) : null;
            vehicle = plan.CreateVehicle(type, _newClass, number, company);
        }
        else
        {
            vehicle = _existingId is int vid ? plan.ScheduledObjects.FirstOrDefault(v => v.Id == vid) : null;
        }
        if (vehicle is null) return;

        // Take only the sessions the vehicle is still free for (all of them when it is unassigned).
        var sessions = FreeSessions(vehicle);
        plan.AssignVehicle(Schedule, vehicle, sessions, CanChooseRole ? _role : TractionRole.Front);
        ScheduleState.SaveAndNotify();
        await OnAssigned.InvokeAsync();
    }

    private Task Abort() => OnClosed.InvokeAsync();

    // Vehicle identity, annotated with the sessions it is still free for when it is already partly booked.
    private string VehicleLabel(ScheduledObject vehicle)
    {
        var name = $"{vehicle.Designation} ({Translator(vehicle.ObjectType.ToString())})";
        if (!vehicle.ScheduleAssignments.Any()) return name;
        var free = FreeSessions(vehicle);
        // Part of an <option> label, so the text form rather than circles.
        return $"{name} — {Translator("Free")}: {free.ToText(SessionSettings)}";
    }

    private SessionsSettings SessionSettings =>
        ScheduleState.Layout?.Settings.General.SessionSettings() ?? SessionsSettings.UseSessions(MaxSessions);

    // Null for an empty or unparseable field, so a half-typed value never counts as a whole one.
    private static int? ParseOptionalInt(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.CurrentCulture, out var value) ? value : null;
}
