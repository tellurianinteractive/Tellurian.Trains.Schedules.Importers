@namespace Tellurian.Trains.Schedules.Planning.Components.Schedules
@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Timetables
@inject ScheduleStateService ScheduleState
@inject Translator Translator

@* Changes the span of a part already in a schedule. The part keeps its train — the planner picks the new
   stops from its run — so the driver duties working it follow the change. Every stop is offered: where a
   neighbouring part meets this one and its own train calls at the new joint, the neighbour is adapted with
   it; where it cannot follow, the edit is applied all the same and what it leaves behind is shown here and
   reported as a conflict. *@

<div class="edit-part-backdrop">
    <div class="edit-part-dialog">
        <h3>@Translator("EditTrainPart")</h3>

        <div class="field">
            <label>@Translator("Train")</label>
            <span class="train">@Part.Train.Identity</span>
        </div>
        <div class="field">
            <label>@Translator("Vehicles")</label>
            @if (VehicleKinds.Count == 0)
            {
                <span class="no-vehicle">@Translator("None")</span>
            }
            else
            {
                <span class="kinds">
                    @foreach (var kind in VehicleKinds)
                    {
                        <span class="kind" style="border-color:@kind.Color" title="@kind.Designations">@Translator(kind.Type.ToString())</span>
                    }
                </span>
            }
        </div>
        <div class="field">
            <label>@Translator("From")</label>
            <select value="@_from" @onchange="SetFrom">
                @for (var i = 0; i < Calls.Count - 1; i++)
                {
                    <option value="@i">@CallText(Calls[i], departure: true)</option>
                }
            </select>
        </div>
        <div class="field">
            <label>@Translator("To")</label>
            <select value="@_to" @onchange="SetTo">
                @for (var i = _from + 1; i < Calls.Count; i++)
                {
                    <option value="@i">@CallText(Calls[i], departure: false)</option>
                }
            </select>
        </div>

        @* What has to be done with the traction where the part ends, so the train can leave the other
           way round. Both are arrival notes for the driver and the dispatcher. *@
        @if (ShowTractionOptions)
        {
            @* Offered closed where there is no turntable — except where one was asked for and the
               turntable has since gone, which is left open so it can be cleared here rather than only
               by giving the station its turntable back. *@
            <div class="field">
                <label title="@Translator("TurnLocoHelp")">@Translator("TurnLoco")</label>
                <input type="checkbox" checked="@_turnLoco" disabled="@(!CanTurnLoco && !_turnLoco)"
                       @onchange="e => _turnLoco = e.Value as bool? ?? false" />
            </div>
            @if (!CanTurnLoco)
            {
                <p class="hint">@NoTurntableText</p>
            }
            <div class="field">
                <label title="@Translator("RunaroundLocoHelp")">@Translator("RunaroundLoco")</label>
                <input type="checkbox" checked="@_runaroundLoco"
                       @onchange="e => _runaroundLoco = e.Value as bool? ?? false" />
            </div>
            @* Said rather than silently unticked: what the planner asked for is kept, in case the
               traction working the part changes to one that does have to be run round. *@
            @if (_runaroundLoco && !Part.NeedsRunaround)
            {
                <p class="hint">@Translator("RunaroundLocoNotNeeded")</p>
            }
        }

        @if (Preview is { } edit)
        {
            <p class="preview">@SpanText(edit.From, edit.To)</p>
            @if (edit.AdaptsPrevious)
            {
                <p class="adapts">@Translator("PreviousPart"): @SpanText(edit.Previous!.From, edit.PreviousEnd!) (@Translator("PartEditAdapted"))</p>
            }
            @if (edit.AdaptsNext)
            {
                <p class="adapts">@Translator("NextPart"): @SpanText(edit.NextStart!, edit.Next!.To) (@Translator("PartEditAdapted"))</p>
            }
            @foreach (var warning in Warnings(edit))
            {
                <p class="warning">@warning</p>
            }
        }

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        <div class="actions">
            <button class="primary" @onclick="Save">@Translator("Save")</button>
            <button @onclick="Abort">@Translator("Abort")</button>
        </div>
    </div>
</div>

@code {
    /// <summary>The schedule the part is worked in.</summary>
    [Parameter, EditorRequired] public Schedule Schedule { get; set; } = default!;

    /// <summary>The part to change.</summary>
    [Parameter, EditorRequired] public ScheduledTrainPart Part { get; set; } = default!;

    /// <summary>Raised after the edit has been applied and saved.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>Raised when the dialog is dismissed without changing anything.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private int _from;
    private int _to;
    private bool _turnLoco;
    private bool _runaroundLoco;
    private string? _error;

    // The train's calls in run order, so the index order in the lists is the order the train works them.
    private IReadOnlyList<StationCall> Calls => Part.Train.CallsInRunOrder;

    // The kinds of vehicle working this part, one entry per distinct type in type order. Several vehicles
    // of different kinds may share a working — a locomotive hauling a wagonset, say — and what shortening
    // or extending the part means differs per kind, so every kind is named, not just the first. The
    // vehicles of a kind are named in the chip's tooltip.
    private IReadOnlyList<VehicleKind> VehicleKinds =>
        [.. Schedule.Vehicles
            .GroupBy(v => v.ObjectType)
            .OrderBy(g => g.Key)
            .Select(g => new VehicleKind(
                g.Key,
                g.First().BorderColor,
                string.Join(", ", g.Select(v => v.Designation))))];

    // What the current selection would do, or null while the selection is incomplete. Nothing is changed
    // until the planner saves.
    private PartEdit? Preview
    {
        get
        {
            var calls = Calls;
            if (_to <= _from || _to >= calls.Count) return null;
            var planned = Schedule.PlanPartEdit(Part, calls[_from], calls[_to]);
            return planned.HasValue ? planned.Value : null;
        }
    }

    // Whether the part's traction options are worth asking about: only a locomotive or a trainset is
    // turned or run round. A working with no vehicle yet is offered them all the same — the planner
    // often lays out the trains before saying what works them.
    private bool ShowTractionOptions =>
        !Schedule.Vehicles.Any() || Schedule.Vehicles.Any(v => v.IsTraction);

    // Where the part ends as currently selected, which is where the turn would be made.
    private OperationLocation ArrivalLocation => Calls[_to].OperationLocation;

    // A locomotive is turned on a turntable, so only a station with one can be asked for it.
    private bool CanTurnLoco => ArrivalLocation.CanTurnLoco;

    private string NoTurntableText =>
        string.Format(CultureInfo.CurrentCulture, Translator("TurnLocoNoTurntable"), ArrivalLocation.Name);

    protected override void OnInitialized()
    {
        var calls = Calls;
        _from = calls.TakeWhile(c => !ReferenceEquals(c, Part.From)).Count();
        _to = calls.TakeWhile(c => !ReferenceEquals(c, Part.To)).Count();
        if (_from >= calls.Count - 1) _from = calls.Count - 2;
        if (_to <= _from || _to >= calls.Count) _to = _from + 1;
        _turnLoco = Part.TractionOptions?.TurnLoco ?? false;
        _runaroundLoco = Part.TractionOptions?.RunaroundLoco ?? false;
    }

    private void SetFrom(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var i)) _from = i;
        if (_to <= _from) _to = _from + 1;
        ClearTurnWithoutTurntable();
        _error = null;
    }

    private void SetTo(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var i)) _to = i;
        ClearTurnWithoutTurntable();
        _error = null;
    }

    // Moving the part's end to a station with no turntable takes the turn with it, rather than leaving a
    // disabled box ticked for a move that cannot be made there.
    private void ClearTurnWithoutTurntable()
    {
        if (!CanTurnLoco) _turnLoco = false;
    }

    private IEnumerable<string> Warnings(PartEdit edit)
    {
        if (edit.LeavesGapBefore) yield return Translator("PartEditGapBefore");
        if (edit.LeavesGapAfter) yield return Translator("PartEditGapAfter");
        if (edit.OverlapsPrevious) yield return Translator("PartEditOverlapBefore");
        if (edit.OverlapsNext) yield return Translator("PartEditOverlapAfter");
    }

    private async Task Save()
    {
        _error = null;
        var calls = Calls;
        if (_to <= _from || _to >= calls.Count) return;
        var result = Schedule.EditPart(Part, calls[_from], calls[_to]);
        if (result.IsNone) { _error = result.Message; return; }
        ApplyTractionOptions();
        ScheduleState.SaveAndNotify();
        await OnSaved.InvokeAsync();
    }

    // Records what is to be done with the traction on arrival. A part that carries no traction options
    // gets them only once there is something to say: they are created without the departure "use this
    // locomotive" note, so asking for a turn cannot quietly add notes at the other end of the part.
    private void ApplyTractionOptions()
    {
        if (!ShowTractionOptions) return;
        if (Part.TractionOptions is null)
        {
            if (!_turnLoco && !_runaroundLoco) return;
            Part.TractionOptions = new TractionOptions { DisplayUseNote = false };
        }
        Part.TractionOptions.TurnLoco = _turnLoco;
        Part.TractionOptions.RunaroundLoco = _runaroundLoco;
    }

    private Task Abort() => OnClosed.InvokeAsync();

    private static string CallText(StationCall call, bool departure) =>
        $"{call.OperationLocation.Signature} {(departure ? call.Departure : call.Arrival).HHMM()}";

    private static string SpanText(StationCall from, StationCall to) =>
        $"{CallText(from, departure: true)} → {CallText(to, departure: false)}";

    // One distinct vehicle type on the schedule: the type itself, the colour it is drawn in (taken from
    // the first vehicle of that type, as the turn chart draws it) and the designations of its vehicles.
    private sealed record VehicleKind(ScheduledObjectType Type, string Color, string Designations);
}
