@namespace Tellurian.Trains.Schedules.Planning.Components.Schedules
@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Validations
@using Tellurian.Trains.Schedules.Planning.Components.Services
@using Tellurian.Trains.Schedules.Planning.Components.Scheduling
@using Tellurian.Utilities.Web
@inject ScheduleStateService ScheduleState
@inject ValidationStateService ValidationState
@inject Translator Translator

@* Editable "turn chart": each vehicle schedule (turnus) is a row. The first column lists the vehicle(s)
   assigned to the working (add/remove), followed by the train-part blocks in working order (each
   removable, which truncates the tail). A trailing "+ train" appends the next (possibly partial) train. *@

@if (Schedules.Count == 0)
{
    <p class="empty">@Translator("SchedulesEmpty")</p>
}
else
{
    @* Each row's conflicts are read once here: the badge needs them, and so does the decision whether the
       chart carries a conflict column at all. *@
    var rows = Schedules.Select(s => (Schedule: s, Conflicts: ConflictsOf(s))).ToList();
    var showConflictColumn = rows.Any(r => r.Conflicts.Count > 0);

    <div class="turn-chart @(showConflictColumn ? "with-conflicts" : null)">
        @if (showConflictColumn)
        {
            <div class="head conflict-head"></div>
        }
        <div class="head vehicle-head">@Translator("Vehicles")</div>
        <div class="head parts-head">@Translator("Trains")</div>
        @foreach (var (schedule, scheduleConflicts) in rows)
        {
            <div class="sched-row">
                @if (showConflictColumn)
                {
                    <div class="conflict-cell @(scheduleConflicts.Count > 0 ? "has-conflict" : null)">
                        <ConflictBadge Errors="scheduleConflicts" For="@ScheduleLabel(schedule)" />
                    </div>
                }
                <div class="sched-vehicle">
                    <div class="vehicles">
                        @foreach (var (vehicle, assignment) in VehiclesOf(schedule))
                        {
                            var vehicleConflicts = ConflictsOf(vehicle);
                            <span class="chip @(vehicle.HasExternalId ? "external-id" : null) @(vehicleConflicts.Count > 0 ? "conflict" : null)" style="border-color:@vehicle.BorderColor"
                                  title="@Translator(vehicle.ObjectType.ToString())">
                                @vehicle.Designation
                                @if (!assignment.Sessions.CoversAllWithin(UseDays, MaxSessions))
                                {
                                    <span class="sessions"><SessionsView Sessions="assignment.Sessions" Settings="SessionSettings" /></span>
                                }
                                <ConflictBadge Errors="vehicleConflicts" For="@vehicle.Designation" />
                                <button class="edit" title="@Translator("EditVehicle")"
                                        @onclick="() => _editTarget = (schedule, vehicle, assignment)"><i class="fa-solid fa-pen"></i></button>
                                <button class="x" title="@Translator("RemoveVehicle")"
                                        @onclick="() => RemoveVehicle(assignment)"><i class="fa-solid fa-xmark"></i></button>
                            </span>
                        }
                        <button class="add" title="@Translator("AddVehicle")" @onclick="() => _assignTarget = schedule"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </div>
                <div class="parts @(scheduleConflicts.Count > 0 ? "has-schedule-conflict" : null)">
                    @if (_deleteTarget == schedule)
                    {
                        <div class="confirm">
                            <span>@Translator("DeleteScheduleConfirm")</span>
                            <button class="danger" @onclick="() => DeleteSchedule(schedule)"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button>
                            <button @onclick="() => _deleteTarget = null">@Translator("Cancel")</button>
                        </div>
                    }
                    else
                    {
                        <button class="clone-sched" title="@Translator("CloneSchedule")"
                                @onclick="() => CloneSchedule(schedule)"><i class="fa-solid fa-copy"></i></button>
                        @if (schedule.Parts.Count > 0)
                        {
                            <button class="complement-sched" title="@Translator("ComplementSchedule")"
                                    @onclick="() => ComplementSchedule(schedule)"><i class="fa-solid fa-calendar-plus"></i></button>
                        }
                        <button class="del-sched danger" title="@Translator("DeleteSchedule")"
                                @onclick="() => _deleteTarget = schedule"><i class="fa-solid fa-trash"></i></button>
                    }
                    @if (!schedule.EffectiveSessions.CoversAllWithin(UseDays, MaxSessions))
                    {
                        <span class="sched-sessions" title="@Translator("ScheduleOperatingSessions")">
                            <SessionsView Sessions="schedule.EffectiveSessions" Settings="SessionSettings" />
                        </span>
                    }
                    @foreach (var joint in schedule.Joints)
                    {
                        @* Every joint but the last is drawn before the part that follows it; the working's
                           end keeps the "+ train" button below. *@
                        if (joint.Next is not { } part) continue;
                        if (joint.HasRoom)
                        {
                            <button class="joint @(joint.IsBroken ? "broken" : null) @(joint.IsStart ? "start" : null)"
                                    title="@JointTitle(joint)" @onclick="() => _addPartTarget = (schedule, joint)">
                                <i class="fa-solid fa-plus"></i> @JointText(joint)
                            </button>
                        }
                        var segment = BuildSegment(part);
                        <div class="part" style="background:@segment.Color; color:@segment.TextColor" title="@segment.Title">
                            <span class="from">@segment.From</span>
                            <span class="sep">–</span>
                            <span class="ident">@segment.Identity</span>
                            <span class="sep">–</span>
                            <span class="to">@segment.To</span>
                            @if (!part.Train.Sessions.CoversAllWithin(UseDays, MaxSessions))
                            {
                                <span class="sessions"><SessionsView Sessions="part.Train.Sessions" Settings="SessionSettings" /></span>
                            }
                            <button class="edit" title="@Translator("EditTrainPart")"
                                    @onclick="() => _editPartTarget = (schedule, part)"><i class="fa-solid fa-pen"></i></button>
                            <button class="x" title="@Translator("RemovePart")" @onclick="() => RemovePart(schedule, part)"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    }
                    <button class="add-train" @onclick="() => _addPartTarget = (schedule, null)"><i class="fa-solid fa-plus"></i> @Translator("AddTrainPart")</button>
                </div>
            </div>
        }
    </div>
}

@if (_addPartTarget is { } addTarget)
{
    <AddPartDialog Schedule="addTarget.Schedule" Joint="addTarget.Joint"
                   OnAdded="() => _addPartTarget = null"
                   OnClosed="() => _addPartTarget = null" />
}
@if (_editPartTarget is { } editPartTarget)
{
    <EditPartDialog Schedule="editPartTarget.Schedule" Part="editPartTarget.Part"
                    OnSaved="() => _editPartTarget = null"
                    OnClosed="() => _editPartTarget = null" />
}
@if (_assignTarget is { } assignTarget)
{
    <AssignVehicleDialog Schedule="assignTarget"
                         OnAssigned="() => _assignTarget = null"
                         OnClosed="() => _assignTarget = null" />
}
@if (_editTarget is { } editTarget)
{
    <EditVehicleDialog Schedule="editTarget.Schedule" Vehicle="editTarget.Vehicle" Assignment="editTarget.Assignment"
                       OnSaved="() => _editTarget = null"
                       OnClosed="() => _editTarget = null" />
}

@code {
    /// <summary>The vehicle schedules to chart, in the order they should appear (top to bottom).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Schedule> Schedules { get; set; } = [];

    /// <summary>The graph settings that decide how a train identity is formatted (company signature,
    /// sessions/days), so the blocks match the graphical timetable's labels.</summary>
    [Parameter] public GraphSettings Settings { get; set; } = GraphSettings.Default;

    /// <summary>Raised with a status message to show (or <c>null</c> to clear it), e.g. when a complement
    /// has nothing to add.</summary>
    [Parameter] public EventCallback<string?> OnMessage { get; set; }

    private Plan? Plan => ScheduleState.Schedule;

    private bool UseDays => ScheduleState.Layout?.Settings.General.UseDays ?? false;
    private int MaxSessions => ScheduleState.Layout?.Settings.General.MaxSessions ?? 14;
    private DayOfWeek StartDay => ScheduleState.Layout?.Settings.General.StartDay ?? DayOfWeek.Monday;

    private SessionsSettings SessionSettings =>
        ScheduleState.Layout?.Settings.General.SessionSettings() ?? SessionsSettings.UseSessions(MaxSessions);

    // The working a train is being added to, and where in it: a joint to fill, or null for the trailing
    // "+ train" that appends to the end.
    private (Schedule Schedule, ScheduleJoint? Joint)? _addPartTarget;
    private (Schedule Schedule, ScheduledTrainPart Part)? _editPartTarget;
    private Schedule? _assignTarget;
    private Schedule? _deleteTarget;
    private (Schedule Schedule, ScheduledObject Vehicle, ScheduleAssignment Assignment)? _editTarget;

    // Schedule-scope conflicts for this working (overlapping/non-contiguous/orphan parts, or a train left
    // without traction): they tint the parts column and fill the badge that opens them. Train- and
    // vehicle-scope errors are excluded by Involves(schedule), so they never mark the parts column.
    private IReadOnlyList<ValidationError> ConflictsOf(Schedule schedule) =>
        [.. ValidationState.Errors.Where(e => e.Involves(schedule))];

    // Vehicle-scope conflicts for this vehicle (double-booked, non-closing circulation). Only the offending
    // chip is marked, in the Vehicle column.
    private IReadOnlyList<ValidationError> ConflictsOf(ScheduledObject vehicle) =>
        [.. ValidationState.Errors.Where(e => e.Involves(vehicle))];

    // How the conflict pop-up names a working: by the vehicles worked to it, since that is what the row
    // reads as. A schedule with no vehicle yet has only its number to go by — and that missing vehicle is
    // itself one of the conflicts the pop-up may be listing.
    private static string ScheduleLabel(Schedule schedule)
    {
        var vehicles = string.Join(" ", schedule.Vehicles.Select(v => v.Designation));
        return vehicles.Length > 0 ? vehicles : $"#{schedule.Number}";
    }

    // The vehicles worked to a schedule, paired with the assignment that links them (needed to unassign).
    private IEnumerable<(ScheduledObject Vehicle, ScheduleAssignment Assignment)> VehiclesOf(Schedule schedule) =>
        schedule.Vehicles
            .Select(v => (Vehicle: v, Assignment: v.ScheduleAssignments.FirstOrDefault(a => schedule.Equals(a.Schedule))))
            .Where(x => x.Assignment is not null)
            .Select(x => (x.Vehicle, x.Assignment!));

    // What a joint reads as in the row: where the vehicle stands and for how long, the two stations when
    // the working is broken across it, or where the vehicle must be brought to before the working starts.
    private string JointText(ScheduleJoint joint) =>
        joint.IsStart ? $"→ {joint.To!.Signature} {joint.WindowEnd!.Value.HHMM()}"
        : joint.IsBroken ? $"{joint.From!.Signature} → {joint.To!.Signature}"
        : $"{joint.From!.Signature} {LayoverText(joint.Layover!.Value)}";

    // The time the vehicle stands, as H:mm — the form the duty chart writes a duration in, and not a
    // padded clock time, which is what the times on the blocks either side of it are.
    private static string LayoverText(Time layover) =>
        $"{(int)layover.Value.TotalHours}:{layover.Value.Minutes:00}";

    private string JointTitle(ScheduleJoint joint) =>
        Translator(joint.IsStart ? "InsertBeforeFirstPart" : joint.IsBroken ? "ScheduleBrokenJoint" : "ScheduleLayover");

    private void RemoveVehicle(ScheduleAssignment assignment)
    {
        Plan?.TryDelete(assignment);
        ScheduleState.SaveAndNotify();
    }

    private void RemovePart(Schedule schedule, ScheduledTrainPart part)
    {
        schedule.RemovePart(part);
        ScheduleState.SaveAndNotify();
    }

    private void DeleteSchedule(Schedule schedule)
    {
        _deleteTarget = null;
        Plan?.TryDelete(schedule);
        ScheduleState.SaveAndNotify();
    }

    // Copies the whole working into a new schedule as a starting point the planner then edits.
    private async Task CloneSchedule(Schedule schedule)
    {
        if (Plan is null) return;
        Plan.CloneSchedule(schedule);
        ScheduleState.SaveAndNotify();
        await OnMessage.InvokeAsync(null);
    }

    // Creates the working for the sessions this schedule leaves out (its trains that run beyond its
    // effective sessions). Reports when there is nothing to complement.
    private async Task ComplementSchedule(Schedule schedule)
    {
        if (Plan is null) return;
        var result = Plan.CreateComplementarySchedule(schedule);
        if (result.HasValue)
        {
            ScheduleState.SaveAndNotify();
            await OnMessage.InvokeAsync(null);
        }
        else
        {
            await OnMessage.InvokeAsync(Translator("SchedulesNothingToComplement"));
        }
    }

    // The category prefix/suffix is always part of the identity here, whatever the graph is set to draw:
    // the blocks have to be recognisable against the Trains tab, which always lists trains that way.
    private GraphSettings IdentitySettings => Settings with { ShowTrainCategory = true };

    private Segment BuildSegment(ScheduledTrainPart part)
    {
        var color = part.Train.Category?.Color ?? "#000000";
        var identity = part.Train.GraphLabel(IdentitySettings);
        var from = $"{part.From.OperationLocation.Signature} {part.From.Departure.HHMM()}";
        var to = $"{part.To.OperationLocation.Signature} {part.To.Arrival.HHMM()}";
        return new Segment(from, identity, to, color, color.TextColor, $"{from} – {identity} – {to}");
    }

    private sealed record Segment(string From, string Identity, string To, string Color, string TextColor, string Title);
}
