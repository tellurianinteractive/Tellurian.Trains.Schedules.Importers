@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Layouts
@using Tellurian.Trains.Schedules.Model.Schedules
@using Tellurian.Trains.Schedules.Model.Timetables
@using Tellurian.Trains.Schedules.Model.Validations
@inject ScheduleStateService ScheduleState
@inject Translator Translator
@implements IDisposable

<div class="cargo-trains">
    <p class="hint">@Translator("CargoTrainsDescription")</p>

    @if (CargoDestinations.Count == 0)
    {
        <p class="empty">@Translator("CargoTrainsNeedDestinations")</p>
    }
    else
    {
        <div class="toolbar">
            <ListBoxView Items="@(Timetable!.Trains.Where(Train.CanHostCargoFlow).ToListItems(t => t.Number))"
                         @bind-Value="_addTrainId" Placeholder="@Translator("SelectTrain")" />
            <button class="primary" disabled="@(_addTrainId is null)" @onclick="AddToSelectedTrain">@Translator("AddCargoFlow")</button>
        </div>

        @if (Masters.Count == 0)
        {
            <p class="empty">@Translator("NoCargoFlows")</p>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th class="expander"></th>
                        <th>@Translator("Train")</th>
                        <th class="num">@Translator("CargoFlows")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var train in Masters)
                    {
                        <tr class="master @(IsExpanded(train) ? "expanded" : "")">
                            <td class="expander">
                                <button class="toggle" title="@Translator(IsExpanded(train) ? "Collapse" : "Expand")"
                                        @onclick="() => ToggleExpanded(train)"><i class="fa-solid @(IsExpanded(train) ? "fa-chevron-down" : "fa-chevron-right")"></i></button>
                            </td>
                            <td>@train.ListLabel</td>
                            <td class="num">@train.CargoFlows.Count</td>
                        </tr>
                        @if (IsExpanded(train))
                        {
                            <tr class="detail">
                                <td></td>
                                <td colspan="2">@FlowsTable(train)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    }

    @if (_deleteTarget is not null)
    {
        <div class="confirm">
            <span>@Translator("DeleteCargoFlowConfirm")</span>
            <button class="danger" @onclick="DeleteConfirmed"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button>
            <button @onclick="() => _deleteTarget = null">@Translator("Cancel")</button>
        </div>
    }
</div>

@code {
    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private Plan? Plan => ScheduleState.Schedule;
    private Timetable? Timetable => ScheduleState.Timetable;

    // Catalogue order; the drop-down these feed re-sorts them by their composed label anyway.
    private List<CargoFlowOptions> CargoDestinations =>
        [.. (Timetable?.CargoFlowOptions ?? []).OrderBy(o => o.Id)];

    // Trains that already have cargo flows, shown as the master rows.
    private List<Train> Masters =>
        [.. (Timetable?.Trains ?? []).Where(t => t.CargoFlows.Count > 0).OrderBy(t => t.Number)];

    private int? _addTrainId;
    private readonly HashSet<int> _expanded = [];
    private CargoFlowTrainPart? _deleteTarget;

    protected override void OnInitialized() => ScheduleState.OnChanged += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        ScheduleState.FlushPendingSave();
    }

    private bool IsExpanded(Train train) => _expanded.Contains(train.Id);

    private void ToggleExpanded(Train train)
    {
        if (!_expanded.Remove(train.Id)) _expanded.Add(train.Id);
    }

    // ---- Add / delete ----------------------------------------------------------------------------

    private void AddToSelectedTrain()
    {
        if (Timetable?.Trains.FirstOrDefault(t => t.Id == _addTrainId) is { } train) AddCargoFlow(train);
    }

    private void AddCargoFlow(Train train)
    {
        if (CargoDestinations.FirstOrDefault() is not { } destinations) return;
        var from = CargoDepartureCalls(train).FirstOrDefault(f => CargoArrivalCallsAfter(train, f).Any());
        if (from is null) return;
        var to = CargoArrivalCallsAfter(train, from).First();
        train.CreateCargoFlow(NextCargoFlowId(), from, to, destinations);
        _expanded.Add(train.Id);
        Save();
    }

    // Cargo flows attach freight wagons, so only calls at stations with cargo exchange are valid
    // connect/disconnect points — further filtering the train's default departure/arrival stops.
    private static IEnumerable<StationCall> CargoDepartureCalls(Train train) =>
        train.DepartureCalls.Where(c => c.OperationLocation.HasCargoExchange);

    private static IEnumerable<StationCall> CargoArrivalCallsAfter(Train train, StationCall from) =>
        train.ArrivalCallsAfter(from).Where(c => c.OperationLocation.HasCargoExchange);

    private void DeleteConfirmed()
    {
        if (_deleteTarget is { } flow && Plan?.TryDelete(flow).IsSuccess == true) Save();
        _deleteTarget = null;
    }

    private int NextCargoFlowId() =>
        ((Timetable?.Trains.SelectMany(t => t.CargoFlows).Select(c => c.Id) ?? []).DefaultIfEmpty(0).Max()) + 1;

    // ---- Cargo flows sub-table -------------------------------------------------------------------

    private RenderFragment FlowsTable(Train train) => @<div class="sub">
        <table class="sub-grid">
            <thead>
                <tr>
                    <th class="num" title="@Translator("PositionInTrainHint")">@Translator("Position")</th>
                    <th>@Translator("From")</th>
                    <th>@Translator("CargoDestinations")</th>
                    <th class="center" title="@Translator("CargoFlowNoWagonsHereHint")">@Translator("CargoFlowNoWagonsHere")</th>
                    <th class="center" title="@Translator("CargoFlowShuntBeforeHint")">@Translator("CargoFlowShuntBefore")</th>
                    <th class="center" title="@Translator("CargoFlowCoupleHint")">@Translator("CargoFlowCouple")</th>
                    <th>@Translator("To")</th>
                    <th class="center" title="@Translator("CargoFlowUncoupleHint")">@Translator("CargoFlowUncouple")</th>
                    <th class="center" title="@Translator("CargoFlowShuntAfterHint")">@Translator("CargoFlowShuntAfter")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @* Keyed: the rows are sorted by the position that is edited in them, so without a key an
                   edit that re-sorts them would leave typed text sitting in the row it moved out of. *@
                @foreach (var flow in train.CargoFlows.OrderBy(f => f.PositionInTrain).ThenBy(f => f.From.SortTime).ToList())
                {
                    <tr @key="flow">
                        <td><input type="number" class="num" min="0" value="@flow.PositionInTrain" @onchange="e => SetPosition(flow, e)" /></td>
                        <td>
                            <ListBoxView Items="@(CargoDepartureCalls(train).ToListItems(c => c.SortTime))"
                                         Value="flow.From.Id" ValueChanged="id => SetFrom(flow, id)" />
                        </td>
                        <td>
                            <ListBoxView Items="@(CargoDestinations.ToListItems(Translator))"
                                         Value="flow.CargoFlowOptionsId" ValueChanged="id => SetCargoDestinations(flow, id)" />
                        </td>
                        <td class="center"><input type="checkbox" checked="@flow.BringsNoWagonsFromHere" @onchange="e => SetNoWagonsFromHere(flow, e)" /></td>
                        <td class="center"><input type="checkbox" checked="@flow.AlsoShuntBeforeDeparture" disabled="@flow.BringsNoWagonsFromHere" @onchange="e => { flow.AlsoShuntBeforeDeparture = e.Value is true; Save(); }" /></td>
                        <td class="center"><input type="checkbox" checked="@flow.HasCoupleNote" disabled="@flow.BringsNoWagonsFromHere" @onchange="e => { flow.HasCoupleNote = e.Value is true; Save(); }" /></td>
                        <td>
                            <ListBoxView Items="@(CargoArrivalCallsAfter(train, flow.From).ToListItems(c => c.SortTime))"
                                         Value="flow.To.Id" ValueChanged="id => SetTo(flow, id)" />
                        </td>
                        <td class="center"><input type="checkbox" checked="@flow.HasUncoupleNote" @onchange="e => { flow.HasUncoupleNote = e.Value is true; Save(); }" /></td>
                        <td class="center"><input type="checkbox" checked="@flow.AlsoShuntAfterArrival" @onchange="e => { flow.AlsoShuntAfterArrival = e.Value is true; Save(); }" /></td>
                        <td><button class="danger small" @onclick="() => _deleteTarget = flow"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="small" @onclick="() => AddCargoFlow(train)">@Translator("AddCargoFlow")</button>
    </div>;

    private void SetPosition(CargoFlowTrainPart flow, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, Culture, out var position)) flow.PositionInTrain = position;
        Save();
    }

    private void SetFrom(CargoFlowTrainPart flow, int? id)
    {
        var train = flow.Train;
        if (train.Calls.FirstOrDefault(c => c.Id == id) is not { } from) return;
        flow.From = from;
        flow.FromId = from.Id;
        // Keep the to-call valid: it must be an arrival after the new from-call.
        if (flow.To.SortTime <= from.SortTime && CargoArrivalCallsAfter(train, from).FirstOrDefault() is { } to)
        {
            flow.To = to;
            flow.ToId = to.Id;
        }
        Save();
    }

    private void SetTo(CargoFlowTrainPart flow, int? id)
    {
        if (flow.Train.Calls.FirstOrDefault(c => c.Id == id) is { } to)
        {
            flow.To = to;
            flow.ToId = to.Id;
        }
        Save();
    }

    // Couple and shunt-before-departure only make sense when wagons are taken from here; clearing and
    // disabling them keeps the departure operations consistent.
    private void SetNoWagonsFromHere(CargoFlowTrainPart flow, ChangeEventArgs e)
    {
        flow.BringsNoWagonsFromHere = e.Value is true;
        if (flow.BringsNoWagonsFromHere)
        {
            flow.HasCoupleNote = false;
            flow.AlsoShuntBeforeDeparture = false;
        }
        Save();
    }

    private void SetCargoDestinations(CargoFlowTrainPart flow, int? id)
    {
        if (CargoDestinations.FirstOrDefault(d => d.Id == id) is { } destinations)
        {
            flow.CargoFlowOptions = destinations;
            flow.CargoFlowOptionsId = destinations.Id;
        }
        Save();
    }

    private void Save() => ScheduleState.SaveAndNotify();
}
