@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Layouts
@using Tellurian.Trains.Schedules.Model.Schedules
@using Tellurian.Trains.Schedules.Model.Timetables
@using Tellurian.Trains.Schedules.Model.Validations
@inject ScheduleStateService ScheduleState
@inject Translator Translator
@implements IDisposable

<div class="cargo-destinations">
    @if (_infoTarget is { } info)
    {
        <div class="info">
            <h2>@Translator("CargoDestinations")</h2>
            <dl>
                <dt>@Translator("OnlyWagonClasses")</dt>
                <dd>@(string.IsNullOrWhiteSpace(info.OnlyWagonClasses) ? "—" : info.OnlyWagonClasses)</dd>
                <dt>@Translator("SpecificCargo")</dt>
                <dd>@(string.IsNullOrWhiteSpace(info.SpecificCargo) ? "—" : info.SpecificCargo)</dd>
                <dt>@Translator("ToAllDestinations")</dt>
                <dd>@YesNo(info.ToAllDestinations)</dd>
            </dl>

            <h3>@Translator(info.Origins.Count == 1 ? "OriginLocation" : "OriginLocations")</h3>
            @if (info.Origins.Any())
            {
                <p>@info.OriginLocationNames</p>
            }
            else
            {
                <p class="empty">@Translator("NoOriginLocations")</p>
            }

            <h3>@Translator(info.Destinations.Count == 1 ? "DestinationLocation" : "DestinationLocations")</h3>
            @if (info.ToAllDestinations)
            {
                <p>@info.DestinationsSummary</p>
            }
            else if (info.Destinations.Any())
            {
                <table class="sub-grid">
                    <thead>
                        <tr>
                            <th>@Translator("OperationLocation")</th>
                            <th class="num" title="@Translator("PositionInTrainHint")">@Translator("Position")</th>
                            <th class="num">@Translator("MaxWagons")</th>
                            <th class="num">@Translator("MaxAxles")</th>
                            <th class="center" title="@Translator("AndRegionsHint")">@Translator("AndRegions")</th>
                            <th class="center" title="@Translator("AndBeyondHint")">@Translator("AndBeyond")</th>
                            <th class="center" title="@Translator("AndLocalDestinationsHint")">@Translator("AndLocal")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dest in info.Destinations)
                        {
                            <tr>
                                <td>@dest.Location.Name</td>
                                <td class="num">@dest.PositionInTrain</td>
                                <td class="num">@dest.MaxNumberOfWagons</td>
                                <td class="num">@dest.MaxNumberOfAxles</td>
                                <td class="center">@if (dest.AndRegions) { <i class="fa-solid fa-check"></i> }</td>
                                <td class="center">@if (dest.AndBeyond) { <i class="fa-solid fa-check"></i> }</td>
                                <td class="center">@if (dest.AndLocalDestinations) { <i class="fa-solid fa-check"></i> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="empty">@Translator("NoDestinationLocations")</p>
            }

            <h3>@Translator("UsedInTrains")</h3>
            @{ var usages = UsagesOf(info).ToList(); }
            @if (usages.Count > 0)
            {
                <table class="sub-grid">
                    <thead>
                        <tr>
                            <th>@Translator("Train")</th>
                            <th>@Translator("From")</th>
                            <th>@Translator("To")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (train, flow) in usages)
                        {
                            <tr>
                                <td>@train.Identity</td>
                                @* The flow's own connect and disconnect times, which on a shunting task
                                   are the call's arrival and departure rather than the other way round. *@
                                <td>@flow.From.OperationLocation.Signature @flow.ConnectTime.HHMM()</td>
                                <td>@flow.To.OperationLocation.Signature @flow.DisconnectTime.HHMM()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="empty">@Translator("CargoDestinationNotUsed")</p>
            }

            <div class="form-actions">
                <button class="primary" @onclick="() => _infoTarget = null">@Translator("Close")</button>
            </div>
        </div>
    }
    else
    {
    <p class="hint">@Translator("CargoDestinationsDescription")</p>

    <div class="toolbar">
        <button class="primary" @onclick="AddCargoDestination">@Translator("AddCargoDestination")</button>
    </div>

    @if (CargoDestinations.Count == 0)
    {
        <p class="empty">@Translator("NoCargoDestinations")</p>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th title="@Translator("OriginLocationsHint")">@Translator("OriginLocations")</th>
                    <th class="center">@Translator("ToAllDestinations")</th>
                    <th>@Translator("DestinationLocations")</th>
                    <th title="@Translator("OnlyWagonClassesHint")">@Translator("OnlyWagonClasses")</th>
                    <th title="@Translator("SpecificCargoHint")">@Translator("SpecificCargo")</th>
                    <th class="actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in CargoDestinations)
                {
                    <tr class="destination @(IsExpanded(d) ? "expanded" : "")" @key="d">
                        <td>@d.OriginLocationNames</td>
                        <td class="center"><input type="checkbox" checked="@d.ToAllDestinations" @onchange="e => SetToAll(d, e)" /></td>
                        <td>@(d.ToAllDestinations ? "" : d.DestinationLocationNames)</td>
                        <td><input type="text" value="@d.OnlyWagonClasses" @onchange="e => SetOnlyWagonClasses(d, e)" /></td>
                        <td><input type="text" value="@d.SpecificCargo" disabled="@(!HasWagonClasses(d))"
                                   title="@Translator(HasWagonClasses(d) ? "SpecificCargoHint" : "SpecificCargoDisabledHint")"
                                   @onchange="e => SetSpecificCargo(d, e)" /></td>
                        <td class="actions">
                            <button @onclick="() => _infoTarget = d">@Translator("Info")</button>
                            <button @onclick="() => ToggleExpanded(d)">@Translator(IsExpanded(d) ? "Close" : "Edit")</button>
                            @{ var deletion = Plan?.MayDelete(d); }
                            <span class="delete-wrap" title="@DeletionPresentation.BlockedReason(deletion, "CargoDestinationReferenced", Translator)">
                                <button class="danger" disabled="@(deletion?.IsDenied == true)"
                                        @onclick="() => _deleteTarget = d"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button>
                            </span>
                        </td>
                    </tr>
                    @if (IsExpanded(d))
                    {
                        @* Keyed on the id, not on d itself: sibling keys must differ, and the row above owns d. *@
                        <tr class="detail" @key="d.Id">
                            <td colspan="6">
                                @OriginsTable(d)
                                @if (!d.ToAllDestinations)
                                {
                                    @DestinationsTable(d)
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }

    @if (_deleteTarget is not null)
    {
        <div class="confirm">
            <span>@string.Format(Culture, Translator("DeleteCargoDestinationConfirm"), _deleteTarget.DestinationsSummary)</span>
            <button class="danger" @onclick="DeleteConfirmed"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button>
            <button @onclick="() => _deleteTarget = null">@Translator("Cancel")</button>
        </div>
    }
    }
</div>

@code {
    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private Plan? Plan => ScheduleState.Schedule;
    private Timetable? Timetable => ScheduleState.Timetable;
    private Layout? Layout => ScheduleState.Layout;

    // The catalogue entries. Each is a CargoFlowOptions: one set of cargo destinations, plus the origins
    // and wagon classes that qualify them.
    // In catalogue order, so a row stays where it is while being edited. Sorting by wagon classes would
    // move a row the moment its classes are typed, and the classes are optional anyway.
    private List<CargoFlowOptions> CargoDestinations =>
        [.. (Timetable?.CargoFlowOptions ?? []).OrderBy(o => o.Id)];

    // Wagons can be routed from and to any location that exchanges cargo — an industrial area just as
    // much as a station — so the choices are all such operation locations, not only the stations.
    private IEnumerable<OperationLocation> LocationChoices =>
        (Layout?.OperationLocations ?? [])
            .Where(l => l.HasCargoExchange)
            .OrderBy(l => l.Name, StringComparer.CurrentCulture);

    private readonly HashSet<int> _expanded = [];
    private CargoFlowOptions? _deleteTarget;
    private CargoFlowOptions? _infoTarget;

    private string YesNo(bool value) => Translator(value ? "Yes" : "No");

    // The cargo flows that reference this description, with their owning train, ordered by train then
    // by the connect time, for the Info panel's "used in trains" list.
    private IEnumerable<(Train Train, CargoFlowTrainPart Flow)> UsagesOf(CargoFlowOptions d) =>
        (Timetable?.Trains ?? [])
            .SelectMany(t => t.CargoFlows
                .Where(cf => cf.CargoFlowOptionsId == d.Id || ReferenceEquals(cf.CargoFlowOptions, d))
                .Select(cf => (Train: t, Flow: cf)))
            .OrderBy(x => x.Train.Number)
            .ThenBy(x => x.Flow.From.SortTime);

    protected override void OnInitialized() => ScheduleState.OnChanged += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        ScheduleState.FlushPendingSave();
    }

    private bool IsExpanded(CargoFlowOptions d) => _expanded.Contains(d.Id);

    private void ToggleExpanded(CargoFlowOptions d)
    {
        if (!_expanded.Remove(d.Id)) _expanded.Add(d.Id);
    }

    // ---- Cargo destination fields ------------------------------------------------------------------

    // A specific cargo only makes sense within a wagon-class limit, so the field is enabled by the classes
    // and clearing the classes drops the cargo with them rather than leaving it stranded and unreachable.
    private static bool HasWagonClasses(CargoFlowOptions d) => !string.IsNullOrWhiteSpace(d.OnlyWagonClasses);

    private void SetOnlyWagonClasses(CargoFlowOptions d, ChangeEventArgs e)
    {
        d.OnlyWagonClasses = e.Value?.ToString() ?? "";
        if (!HasWagonClasses(d)) d.SpecificCargo = "";
        Save();
    }

    private void SetSpecificCargo(CargoFlowOptions d, ChangeEventArgs e)
    {
        d.SpecificCargo = e.Value?.ToString() ?? "";
        Save();
    }

    private void SetToAll(CargoFlowOptions d, ChangeEventArgs e)
    {
        d.ToAllDestinations = e.Value is true;
        Save();
    }

    private void AddCargoDestination()
    {
        if (Timetable is not { } timetable) return;
        var added = timetable.Add(new CargoFlowOptions());
        _expanded.Add(added.Id);
        Save();
    }

    private void DeleteConfirmed()
    {
        if (_deleteTarget is { } d && Plan?.TryDelete(d).IsSuccess == true)
        {
            _expanded.Remove(d.Id);
            Save();
        }
        _deleteTarget = null;
    }

    // ---- Destinations sub-table ------------------------------------------------------------------

    private RenderFragment DestinationsTable(CargoFlowOptions d) => @<div class="sub">
        <h4>@Translator(d.Destinations.Count == 1 ? "DestinationLocation" : "DestinationLocations")</h4>
        <table class="sub-grid">
            <thead>
                <tr>
                    <th>@Translator("OperationLocation")</th>
                    <th class="num" title="@Translator("PositionInTrainHint")">@Translator("Position")</th>
                    <th class="num">@Translator("MaxWagons")</th>
                    <th class="num">@Translator("MaxAxles")</th>
                    <th class="center" title="@Translator("AndRegionsHint")">@Translator("AndRegions")</th>
                    <th class="center" title="@Translator("AndBeyondHint")">@Translator("AndBeyond")</th>
                    <th class="center" title="@Translator("AndLocalDestinationsHint")">@Translator("AndLocal")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dest in d.Destinations.ToList())
                {
                    <tr @key="dest">
                        <td>
                            <ListBoxView Items="@(LocationChoices.ToListItems())"
                                         Value="dest.Location.Id" ValueChanged="id => SetDestinationLocation(dest, id)" />
                        </td>
                        <td><input type="number" class="num" min="0" value="@dest.PositionInTrain" @onchange="e => SetDestinationPosition(dest, e)" /></td>
                        <td><input type="number" class="num" min="0" value="@dest.MaxNumberOfWagons" @onchange="e => SetDestinationMaxWagons(dest, e)" /></td>
                        <td><input type="number" class="num" min="0" value="@dest.MaxNumberOfAxles" @onchange="e => SetDestinationMaxAxles(dest, e)" /></td>
                        <td class="center"><input type="checkbox" checked="@dest.AndRegions" @onchange="e => SetDestinationAndRegions(dest, e)" /></td>
                        <td class="center"><input type="checkbox" checked="@dest.AndBeyond" @onchange="e => SetDestinationAndBeyond(dest, e)" /></td>
                        <td class="center"><input type="checkbox" checked="@dest.AndLocalDestinations" @onchange="e => SetDestinationAndLocal(dest, e)" /></td>
                        <td><button class="danger small" @onclick="() => RemoveDestination(d, dest)"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button></td>
                    </tr>
                }
                @if (d.Destinations.Count == 0)
                {
                    <tr><td colspan="8" class="empty">@Translator("NoDestinationLocations")</td></tr>
                }
            </tbody>
        </table>
        <button class="small" disabled="@(!LocationChoices.Any())" @onclick="() => AddDestination(d)">@Translator("AddDestinationLocation")</button>
    </div>;

    private void SetDestinationLocation(Destination dest, int? id)
    {
        if (LocationChoices.FirstOrDefault(l => l.Id == id) is { } location) dest.Location = location;
        Save();
    }

    private void SetDestinationPosition(Destination dest, ChangeEventArgs e)
    {
        dest.PositionInTrain = ParseInt(e) ?? dest.PositionInTrain;
        Save();
    }

    private void SetDestinationMaxWagons(Destination dest, ChangeEventArgs e)
    {
        dest.MaxNumberOfWagons = ParseInt(e) ?? dest.MaxNumberOfWagons;
        Save();
    }

    private void SetDestinationMaxAxles(Destination dest, ChangeEventArgs e)
    {
        dest.MaxNumberOfAxles = ParseInt(e) ?? dest.MaxNumberOfAxles;
        Save();
    }

    private void SetDestinationAndRegions(Destination dest, ChangeEventArgs e) { dest.AndRegions = e.Value is true; Save(); }
    private void SetDestinationAndBeyond(Destination dest, ChangeEventArgs e) { dest.AndBeyond = e.Value is true; Save(); }
    private void SetDestinationAndLocal(Destination dest, ChangeEventArgs e) { dest.AndLocalDestinations = e.Value is true; Save(); }

    private void AddDestination(CargoFlowOptions d)
    {
        if (LocationChoices.FirstOrDefault() is not { } location) return;
        d.Destinations.Add(new Destination { Location = location });
        Save();
    }

    private void RemoveDestination(CargoFlowOptions d, Destination dest)
    {
        d.Destinations.Remove(dest);
        Save();
    }

    // ---- Origins sub-table -----------------------------------------------------------------------

    private RenderFragment OriginsTable(CargoFlowOptions d) => @<div class="sub">
        <h4>@Translator(d.Origins.Count == 1 ? "OriginLocation" : "OriginLocations")</h4>
        <p class="hint">@Translator("OriginLocationsHint")</p>
        <table class="sub-grid">
            <thead>
                <tr>
                    <th>@Translator("OperationLocation")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var origin in d.Origins.ToList())
                {
                    <tr @key="origin">
                        <td>
                            <ListBoxView Items="@(LocationChoices.ToListItems())"
                                         Value="origin.Location.Id" ValueChanged="id => SetOriginLocation(origin, id)" />
                        </td>
                        <td><button class="danger small" @onclick="() => RemoveOrigin(d, origin)"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button></td>
                    </tr>
                }
                @if (d.Origins.Count == 0)
                {
                    <tr><td colspan="2" class="empty">@Translator("NoOriginLocations")</td></tr>
                }
            </tbody>
        </table>
        <button class="small" disabled="@(!LocationChoices.Any())" @onclick="() => AddOrigin(d)">@Translator("AddOriginLocation")</button>
    </div>;

    private void SetOriginLocation(Origin origin, int? id)
    {
        if (LocationChoices.FirstOrDefault(l => l.Id == id) is { } location) origin.Location = location;
        Save();
    }

    private void AddOrigin(CargoFlowOptions d)
    {
        if (LocationChoices.FirstOrDefault() is not { } location) return;
        d.Origins.Add(new Origin { Location = location });
        Save();
    }

    private void RemoveOrigin(CargoFlowOptions d, Origin origin)
    {
        d.Origins.Remove(origin);
        Save();
    }

    // ---- Helpers ---------------------------------------------------------------------------------

    private static int? ParseInt(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.CurrentCulture, out var value) ? value : null;

    private void Save() => ScheduleState.SaveAndNotify();
}
