@namespace Tellurian.Trains.Schedules.Planning.Components.Duties
@using Tellurian.Trains.Schedules.Planning.Components.Services
@inject ScheduleStateService ScheduleState
@inject Translator Translator

@* Adds a train part to a driver duty. The planner picks from the parts already defined in the vehicle
   schedules that a driver could take next: the parts worked by a locomotive or trainset, and the shunting
   tasks, which need a driver whether or not a loco of their own works them. Offered are those that do not
   overlap the duty's parts and, for a non-empty duty, start at or after its last part ends — the natural
   continuation, though the part may start at any station since the driver walks between parts. *@

@if (Plan is not null)
{
    <div class="add-part-backdrop">
        <div class="add-part-dialog">
            <h3>@Translator("AddDutyPart")</h3>

            @if (Candidates.Count == 0)
            {
                <p class="empty">@Translator("DutyNoCandidateParts")</p>
            }
            else
            {
                <div class="field">
                    <label>@Translator("SelectTrainPart")</label>
                    <select value="@_index" @onchange="OnPartChanged">
                        <option value="-1">—</option>
                        @for (var i = 0; i < Candidates.Count; i++)
                        {
                            <option value="@i">@PartText(Candidates[i])</option>
                        }
                    </select>
                </div>
            }

            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }

            <div class="actions">
                <button class="primary" disabled="@(_index < 0)" @onclick="Add">@Translator("Add")</button>
                <button @onclick="Abort">@Translator("Abort")</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The duty the part is added to.</summary>
    [Parameter, EditorRequired] public DriverDuty Duty { get; set; } = default!;

    /// <summary>Raised after a part has been added and saved.</summary>
    [Parameter] public EventCallback OnAdded { get; set; }

    /// <summary>Raised when the dialog is dismissed without adding a part.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private Plan? Plan => ScheduleState.Schedule;

    private int _index = -1;
    private string? _error;

    private IReadOnlyList<ScheduledTrainPart> Candidates => Plan?.CandidatePartsFor(Duty) ?? [];

    private void OnPartChanged(ChangeEventArgs e)
    {
        _index = int.TryParse(e.Value?.ToString(), out var i) ? i : -1;
        _error = null;
    }

    private async Task Add()
    {
        _error = null;
        var candidates = Candidates;
        if (_index < 0 || _index >= candidates.Count) return;
        var result = Duty.Append(candidates[_index]);
        if (result.IsNone) { _error = result.Message; return; }
        ScheduleState.SaveAndNotify();
        await OnAdded.InvokeAsync();
    }

    private Task Abort() => OnClosed.InvokeAsync();

    // A shunting task is worked at one location, so it is written once with the times its work runs
    // between rather than as a run from one place to another.
    private string PartText(ScheduledTrainPart part)
    {
        var traction = Plan?.ScheduledObjectsFor(part).FirstOrDefault(so => so.IsTraction)?.Designation;
        var span = part.Train.IsShuntingTask
            ? $"{part.From.OperationLocation.Signature} {part.StartTime.HHMM()} – {part.EndTime.HHMM()}"
            : $"{part.From.OperationLocation.Signature} {part.StartTime.HHMM()} → {part.To.OperationLocation.Signature} {part.EndTime.HHMM()}";
        return traction is null ? $"{part.Train} {span}" : $"{part.Train} {span} [{traction}]";
    }
}
