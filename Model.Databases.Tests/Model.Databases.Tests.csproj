<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <AssemblyName>Tellurian.Trains.Schedules.Model.Databases.Tests</AssemblyName>
    <RootNamespace>Tellurian.Trains.Schedules.Model.Databases.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Use the SQLite provider without the SQLitePCLRaw.bundle_e_sqlite3 meta-package, whose native
         build (SQLitePCLRaw.lib.e_sqlite3) is deprecated and carries GHSA-2m69-gcr7-jv3q. Bring the
         native build from its renamed successor, SourceGear.sqlite3, instead. See SqliteProviderInitializer. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageReference Include="Tellurian.Utilities" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Importers.Interfaces\Interfaces.csproj" />
    <ProjectReference Include="..\Model.Databases\Model.Databases.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\Importers.Services\Services.csproj" />
    <ProjectReference Include="..\Importers.Xpln\Xpln.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Test data\**\*.ods" CopyToOutputDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.8.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.2.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.2.3" />
  </ItemGroup>
</Project>
