@inherits LayoutComponentBase
@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using Tellurian.Localization
@using Tellurian.Utilities.Web
@inject DockLayoutState Dock
@inject ScheduleStateService ScheduleState
@inject UiPreferenceService UiPrefs
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Translator Translator
@implements IDisposable

<div class="page" style="--primary: @Primary; --primary-text: @Primary.TextColor">@* signature colour + its auto-contrasted text, exposed app-wide for data-grid headers etc. *@
    <header class="top-bar no-print">
        <h1 class="app-title">@Translator("AppName") <span class="app-version">@AppVersion</span></h1>
        <div class="top-bar-actions">
            <LanguageSelector />
            <button class="header-btn" @onclick="ToggleAbout">@Translator("About")</button>
        </div>
    </header>

    @if (_showAbout)
    {
        <div class="about" @onclick="ToggleAbout">
            <div class="panel" @onclick:stopPropagation>
                <button class="close" @onclick="ToggleAbout"><i class="fa-solid fa-xmark"></i></button>
                @((MarkupString)_aboutHtml)
            </div>
        </div>

    }

    <nav class="tab-bar no-print">
        @foreach (var tab in TabRegistry.Tabs)
        {
            @* Reports sits just before Import in the tab order. *@
            @if (tab.Href == "import")
            {
                <ReportsMenu />
            }
            <span class="tab-slot">
                <NavLink class="@($"tab{(Dock.ContainsView(tab.Href) ? " docked" : "")}")"
                         href="@tab.Href"
                         Match="@(tab.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                         draggable="true"
                         @ondragstart="() => Dock.DraggingViewId = tab.Href"
                         @ondragend="() => Dock.DraggingViewId = null">
                    @Translator(tab.ResourceKey)
                </NavLink>
                @if (tab.HelpKey is { } helpKey)
                {
                    <HelpButton For="@helpKey" />
                }
            </span>
            @* Workspace sits just after Home (the empty route). *@
            @if (tab.Href == "")
            {
                <NavLink class="tab workspace-tab" href="workspace" Match="NavLinkMatch.Prefix">
                    @Translator("Workspace")
                </NavLink>
            }
        }
        <ExportMenu />
    </nav>

    <main class="content">
        <div class="pane-content">
            @if (_initializing)
            {
                @* Mirrors the Blazor boot loader (wwwroot/index.html) — same SVG ring at the same 20vh
                   spot — but the blue arc spins instead of filling by load percentage. *@
                <div class="app-loading">
                    <svg class="app-loading-progress">
                        <circle r="40%" cx="50%" cy="50%" />
                        <circle r="40%" cx="50%" cy="50%" pathLength="100" />
                    </svg>
                    <p>@Translator("RestoringWork")</p>
                </div>
            }
            else
            {
                @Body
            }
        </div>
    </main>
</div>

@code {
    private const string AppVersion = "0.1";

    // The app's signature colour. Exposed (with its auto-contrasted text colour) as the --primary /
    // --primary-text CSS variables on the page root, so data-grid headers and similar can use them.
    private const string Primary = "#1a3a5c";
    private bool _showAbout;
    private string _aboutHtml = "";

    // Restoring state on startup (deserializing the persisted plan, restoring the dock and last route)
    // takes a moment on WebAssembly; show a spinner until it finishes instead of a blank/wrong tab.
    // Only on a genuine cold start, though: when this layout is merely re-created (e.g. returning from a
    // read-only report, which uses PrintLayout) the singleton state is already loaded, so skip the spinner.
    private bool _initializing;

    [Inject(Key = "Markdown")]
    public IResourceProvider MarkdownProvider { get; set; } = default!;

    protected override void OnInitialized()
    {
        Dock.OnChanged += StateHasChanged;
        Nav.LocationChanged += OnLocationChanged;
        // Show the restore spinner only when the app has not yet loaded its state (a cold start).
        _initializing = !ScheduleState.IsInitialized;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Dock.LoadAsync(JS);
                await ScheduleState.InitializeAsync();
                await RestoreLastRouteAsync();
            }
            finally
            {
                // Always clear the spinner, even if a restore step fails, so the app never hangs on it.
                _initializing = false;
                StateHasChanged();
            }
        }
    }

    // On a fresh start (at the app root) navigate to the route the user last had open. An explicit
    // deep link (non-root start) is respected and left untouched.
    private async Task RestoreLastRouteAsync()
    {
        if (!string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri))) return;
        if (await UiPrefs.GetLastRouteAsync() is { Length: > 0 } last && IsRestorableRoute(last))
            Nav.NavigateTo(last);
    }

    private static bool IsRestorableRoute(string route) =>
        route == "workspace" || TabRegistry.Tabs.Any(t => t.Href == route);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var route = Nav.ToBaseRelativePath(e.Location);
        if (IsRestorableRoute(route))
            _ = UiPrefs.SetLastRouteAsync(route);
    }

    private async Task ToggleAbout()
    {
        _showAbout = !_showAbout;
        if (_showAbout && string.IsNullOrEmpty(_aboutHtml))
        {
            var content = await MarkdownProvider.GetTranslationAsync(
                "About", CultureInfo.CurrentUICulture);
            _aboutHtml = Markdig.Markdown.ToHtml(content.Text);
        }
    }

    public void Dispose()
    {
        Dock.OnChanged -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
