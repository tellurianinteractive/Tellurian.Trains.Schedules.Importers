@page "/trains"
@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Layouts
@using Tellurian.Trains.Schedules.Model.Timetables
@using Tellurian.Trains.Schedules.Model.Validations
@inject ScheduleStateService ScheduleState
@inject ValidationStateService ValidationState
@inject Translator Translator
@implements IDisposable

@if (Timetable is null || Layout is null)
{
    <p>@Translator("TrainsNoSchedule")</p>
}
else
{
    <div class="trains-editor">
        <p class="hint">@Translator("TrainsDescription")</p>

        <div class="toolbar">
            <button class="primary" @onclick="AddTrain">@Translator("AddTrain")</button>
        </div>

        @if (Trains.Count == 0)
        {
            <p class="empty">@Translator("NoTrains")</p>
        }
        else
        {
            <table class="trains">
                <thead>
                    <tr>
                        <th class="expander"></th>
                        @if (ShowExternalId)
                        {
                            <th>@Translator("ExternalId")</th>
                        }
                        <th>@Translator("Company")</th>
                        <th>@Translator("Number")</th>
                        <th>@Translator(UseDays ? "Days" : "Sessions")</th>
                        <th>@Translator("Category")</th>
                        <th>@Translator("MaxSpeed")</th>
                        <th>@Translator("Axles")</th>
                        <th>@Translator("Wagons")</th>
                        <th>@Translator("LengthMeters")</th>
                        <th>@Translator("ContinuesAs")</th>
                        <th class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var train in Trains)
                    {
                        var conflict = ConflictTitle(train);
                        <tr class="train @(IsExpanded(train) ? "expanded" : "") @(conflict is not null ? "has-conflict" : "")" title="@conflict">
                            <td class="expander">
                                <button class="toggle" title="@Translator(IsExpanded(train) ? "Collapse" : "Expand")"
                                        @onclick="() => ToggleExpanded(train)"><i class="fa-solid @(IsExpanded(train) ? "fa-chevron-down" : "fa-chevron-right")"></i></button>
                            </td>
                            @if (ShowExternalId)
                            {
                                <td>
                                    <input type="text" class="ext" value="@train.ExternalId"
                                           @onchange="e => SetExternalId(train, e)" />
                                </td>
                            }
                            <td>
                                @{ var inheritedCompany = train.Category?.Company; }
                                <ListBoxView Items="@(CompanyChoices.ToListItems())"
                                             Value="train.CompanyId" ValueChanged="id => SetCompany(train, id)"
                                             Class="@(train.Company is null ? "inherited" : null)"
                                             Placeholder="@(inheritedCompany is { } ic ? string.Format(Culture, Translator("CompanyFromCategory"), ic.Name) : "—")" />
                            </td>
                            <td>
                                <input type="number" class="num" value="@train.Number" @onchange="e => SetNumber(train, e)" />
                            </td>
                            <td>
                                <select value="@SessionsKey(train)" @onchange="e => SetSessions(train, e)">
                                    @if (!SessionsCatalogue.Any(s => SessionsDisplay.Key(s) == SessionsKey(train)))
                                    {
                                        <option value="@SessionsKey(train)" selected>@SessionsText(train.Sessions)</option>
                                    }
                                    @foreach (var sessions in SessionsCatalogue)
                                    {
                                        <option value="@SessionsDisplay.Key(sessions)">@SessionsText(sessions)</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <ListBoxView Items="@(CategoryChoices.ToListItems())"
                                             Value="train.CategoryId" ValueChanged="id => SetCategory(train, id)"
                                             Placeholder="—" />
                            </td>
                            <td>
                                <input type="number" class="num" min="0" value="@train.MaxSpeed"
                                       placeholder="@(train.Category?.DefaultSpeed.ToString(Culture))"
                                       @onchange="e => SetMaxSpeed(train, e)" />
                            </td>
                            <td><input type="number" class="num3" min="0" value="@train.Length.Axles" @onchange="e => SetAxles(train, e)" /></td>
                            <td><input type="number" class="num3" min="0" value="@train.Length.Wagons" @onchange="e => SetWagons(train, e)" /></td>
                            <td><input type="text" class="num3"
                                       value="@train.Length.Meters?.ToString("0.#", Culture)" @onchange="e => SetMeters(train, e)" /></td>
                            <td class="continues">
                                <input type="checkbox" checked="@train.ShowContinuesAs"
                                       title="@Translator("ShowContinuesAsHint")" @onchange="e => SetShowContinuesAs(train, e)" />
                            </td>
                            <td class="actions">
                                @{ var deletion = Plan?.MayDelete(train); }
                                <span class="delete-wrap" title="@DeletionPresentation.BlockedReason(deletion, "TrainReferenced", Translator)">
                                    <button class="danger" disabled="@(deletion is DeletionResult.Failure)"
                                            @onclick="() => _deleteTarget = train"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button>
                                </span>
                            </td>
                        </tr>
                        @if (IsExpanded(train))
                        {
                            <tr class="detail">
                                <td></td>
                                <td colspan="@(ShowExternalId ? 11 : 10)">
                                    @CallsTable(train)
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        @if (_deleteTarget is not null)
        {
            <div class="confirm-backdrop" @onclick="() => _deleteTarget = null">
                <div class="confirm" @onclick:stopPropagation="true">
                    <span>@string.Format(Culture, Translator("DeleteTrainConfirm"), TrainLabel(_deleteTarget))</span>
                    <button class="danger" @onclick="DeleteConfirmed"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button>
                    <button @onclick="() => _deleteTarget = null">@Translator("Cancel")</button>
                </div>
            </div>
        }

        @if (_showAdd)
        {
            <AddTrainDialog OnCreated="OnTrainCreated" OnClosed="() => _showAdd = false" />
        }
    </div>
}

@code {
    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private Plan? Plan => ScheduleState.Schedule;
    private Timetable? Timetable => ScheduleState.Timetable;
    private Layout? Layout => ScheduleState.Layout;

    private bool UseDays => Layout?.Settings.General.UseDays ?? false;
    private int MaxSessions => Layout?.Settings.General.MaxSessions ?? 14;
    private DayOfWeek StartDay => Layout?.Settings.General.StartDay ?? DayOfWeek.Monday;

    private List<Train> Trains =>
        [.. (Timetable?.Trains ?? []).OrderBy(t => t.Number)];

    // The ExternalId column is only meaningful for imported trains; hide it when nothing uses it.
    private bool ShowExternalId => Trains.Any(t => !string.IsNullOrWhiteSpace(t.ExternalId));

    private IEnumerable<Company> CompanyChoices =>
        (Layout?.Companies ?? []).OrderBy(c => c.Name, StringComparer.CurrentCulture);

    private IEnumerable<TrainCategory> CategoryChoices =>
        (Timetable?.TrainCategories ?? []).OrderBy(c => c.Name, StringComparer.CurrentCulture);

    private IEnumerable<Sessions> SessionsCatalogue =>
        Timetable?.Sessions ?? [];

    private readonly HashSet<int> _expanded = [];
    private Train? _deleteTarget;

    protected override void OnInitialized()
    {
        ScheduleState.OnChanged += OnStateChanged;
        ValidationState.OnValidationChanged += OnStateChanged;
        // Older/imported timetables have no session catalogue yet; seed the standard patterns so the
        // Sessions drop-down is usable. Only persists when something was actually added.
        if (Timetable is { } timetable && timetable.EnsureSessions()) ScheduleState.SaveAndNotify();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // The validation messages for errors that involve this train, joined for a hover tooltip; null when clean.
    private string? ConflictTitle(Train train)
    {
        var messages = ValidationState.Errors
            .Where(e => e.Scope == ValidationScope.Train && e.Involves(train))
            .Select(e => e.Message.Text)
            .Distinct()
            .ToList();
        return messages.Count == 0 ? null : string.Join("\n", messages);
    }

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        ValidationState.OnValidationChanged -= OnStateChanged;
        ScheduleState.FlushPendingSave();
    }

    // ---- Expansion state ------------------------------------------------------------------------

    private bool IsExpanded(Train train) => _expanded.Contains(train.Id);

    private void ToggleExpanded(Train train)
    {
        if (!_expanded.Remove(train.Id)) _expanded.Add(train.Id);
    }

    // ---- Display helpers ------------------------------------------------------------------------

    private SessionsSettings SessionSettings =>
        ScheduleState.Layout?.Settings.General.SessionSettings() ?? SessionsSettings.UseSessions(MaxSessions);

    // Rendered inside <option>, where markup cannot go, so this is the text form rather than circles.
    private string SessionsText(Sessions sessions) => sessions.ToText(SessionSettings);

    private string SessionsKey(Train train) => SessionsDisplay.Key(train.Sessions);

    private string TrainLabel(Train train)
    {
        var identity = train.Category?.TrainIdentity(train.Number) ?? train.Number.ToString(Culture);
        return train.EffectiveCompany is { } c ? $"{c.Signature} {identity}".Trim() : identity;
    }

    // ---- Train field editing --------------------------------------------------------------------

    private void SetExternalId(Train train, ChangeEventArgs e)
    {
        train.ExternalId = e.Value?.ToString() ?? "";
        Save();
    }

    private void SetNumber(Train train, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, Culture, out var number)) train.Number = number;
        Save();
    }

    private void SetCompany(Train train, int? id)
    {
        train.Company = id is null ? null : Layout!.Companies.FirstOrDefault(c => c.Id == id);
        train.CompanyId = train.Company?.Id;
        Save();
    }

    private void SetCategory(Train train, int? id)
    {
        train.Category = id is null ? null : Timetable!.TrainCategories.FirstOrDefault(c => c.Id == id);
        train.CategoryId = train.Category?.Id;
        Save();
    }

    private void SetSessions(Train train, ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        var match = SessionsCatalogue.FirstOrDefault(s => SessionsDisplay.Key(s) == key);
        if (SessionsCatalogue.Any(s => SessionsDisplay.Key(s) == key)) train.Sessions = match;
        Save();
    }

    private void SetMaxSpeed(Train train, ChangeEventArgs e)
    {
        train.MaxSpeed = int.TryParse(e.Value?.ToString(), NumberStyles.Integer, Culture, out var speed) ? speed : null;
        Save();
    }

    private void SetAxles(Train train, ChangeEventArgs e) =>
        SetLength(train, train.Length with { Axles = ParseInt(e) });

    private void SetWagons(Train train, ChangeEventArgs e) =>
        SetLength(train, train.Length with { Wagons = ParseInt(e) });

    private void SetMeters(Train train, ChangeEventArgs e) =>
        // Train length in metres is kept to at most one decimal place.
        SetLength(train, train.Length with { Meters = ParseDouble(e) is double m ? Math.Round(m, 1, MidpointRounding.AwayFromZero) : null });

    private void SetLength(Train train, TrainCapacity length)
    {
        train.Length = length;
        Save();
    }

    private void SetShowContinuesAs(Train train, ChangeEventArgs e)
    {
        train.ShowContinuesAs = e.Value is true;
        Save();
    }

    // ---- Calls sub-table ------------------------------------------------------------------------

    private RenderFragment CallsTable(Train train) => @<div class="sub">
        <table class="sub-grid">
            <thead>
                <tr>
                    <th>@Translator("Station") / @Translator("Track")</th>
                    <th>@Translator("Arrival")</th>
                    <th>@Translator("Departure")</th>
                    <th title="@Translator("IsArrival")">@Translator("Arr")</th>
                    <th title="@Translator("IsDeparture")">@Translator("Dep")</th>
                    <th class="note" title="@Translator("CallNoteHint")">@Translator("Remark")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var call in train.Calls.OrderBy(c => c.SortTime).ToList())
                {
                    <tr>
                        <td>
                            <ListBoxView Items="@(TrackChoices.ToListItems())"
                                         Value="call.TrackId" ValueChanged="id => SetCallTrack(call, id)" />
                        </td>
                        <td><input type="text" class="time" value="@call.Arrival.HHMM()" @onchange="e => SetArrival(call, e)" /></td>
                        <td><input type="text" class="time" value="@call.Departure.HHMM()" @onchange="e => SetDeparture(call, e)" /></td>
                        <td><input type="checkbox" checked="@call.IsArrival" @onchange="e => SetIsArrival(call, e)" /></td>
                        <td><input type="checkbox" checked="@call.IsDeparture" @onchange="e => SetIsDeparture(call, e)" /></td>
                        <td class="note">
                            <CallNoteField Value="@call.ManualNoteText" ValueChanged="text => SetCallNote(call, text)"
                                           Placeholder="@Translator("AddCallNote")" Title="@Translator("CallNoteHint")" />
                        </td>
                        <td><button class="danger small" @onclick="() => RemoveCall(call)"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button></td>
                    </tr>
                }
                @if (train.Calls.Count == 0)
                {
                    <tr><td colspan="7" class="empty">@Translator("NoCalls")</td></tr>
                }
            </tbody>
        </table>
        <button class="small" disabled="@(!TrackChoices.Any())" @onclick="() => AddCall(train)">@Translator("AddCall")</button>
    </div>;

    private IEnumerable<StationTrack> TrackChoices =>
        (Layout?.StationTracks() ?? []).OrderBy(t => t.Station.Name, StringComparer.CurrentCulture).ThenBy(t => t.Number, StringComparer.CurrentCulture);

    private void SetCallTrack(StationCall call, int? id)
    {
        if (TrackChoices.FirstOrDefault(t => t.Id == id) is not { } track) return;
        call.Track.Calls.Remove(call);
        call.Track = track;
        call.TrackId = track.Id;
        track.Calls.Add(call);
        Save();
    }

    private void SetArrival(StationCall call, ChangeEventArgs e)
    {
        if (TryParseTime(e, out var time)) call.Arrival = time;
        Save();
    }

    private void SetDeparture(StationCall call, ChangeEventArgs e)
    {
        if (TryParseTime(e, out var time)) call.Departure = time;
        Save();
    }

    private void SetIsArrival(StationCall call, ChangeEventArgs e)
    {
        call.IsArrival = e.Value is true;
        Save();
    }

    private void SetIsDeparture(StationCall call, ChangeEventArgs e)
    {
        call.IsDeparture = e.Value is true;
        Save();
    }

    // The model creates the note on first text, removes it when the text is cleared and writes it in
    // the language being read — see StationCall.SetManualNote.
    private void SetCallNote(StationCall call, string text)
    {
        call.SetManualNote(text);
        Save();
    }

    private void AddCall(Train train)
    {
        var track = TrackChoices.FirstOrDefault();
        if (track is null) return;
        var start = train.Calls.Count > 0 ? train.Calls.Max(c => c.Departure) : Time.Zero;
        var call = new StationCall(NextCallId(), track, start, start);
        train.Add(call);
        Save();
    }

    private void RemoveCall(StationCall call)
    {
        if (Plan?.TryDelete(call).IsSuccess == true) Save();
    }

    private int NextCallId() =>
        ((Timetable?.Trains.SelectMany(t => t.Calls).Select(c => c.Id) ?? []).DefaultIfEmpty(0).Max()) + 1;

    // ---- Add / delete train ---------------------------------------------------------------------

    private bool _showAdd;

    private void AddTrain() => _showAdd = true;

    // The dialog has already built the train, added it to the timetable and saved; just reveal it.
    private void OnTrainCreated(Train train)
    {
        _showAdd = false;
        _expanded.Add(train.Id);
    }

    private void DeleteConfirmed()
    {
        if (_deleteTarget is not { } train || Plan is not { } plan) return;
        if (plan.TryDelete(train).IsSuccess)
        {
            _expanded.Remove(train.Id);
            Save();
        }
        _deleteTarget = null;
    }

    // ---- Parsing helpers ------------------------------------------------------------------------

    private void Save() => ScheduleState.SaveAndNotify();

    private static int? ParseInt(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.CurrentCulture, out var value) ? value : null;

    // Accept a decimal typed in either the current culture (e.g. "2,5") or with a dot ("2.5"); the
    // value is displayed back in the current culture.
    private static double? ParseDouble(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text)) return null;
        if (double.TryParse(text, NumberStyles.Float, CultureInfo.CurrentCulture, out var value)) return value;
        if (double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value)) return value;
        return null;
    }

    private static bool TryParseTime(ChangeEventArgs e, out Time time)
    {
        var text = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(text) && TimeSpan.TryParse(text, CultureInfo.InvariantCulture, out var span))
        {
            time = Time.FromTimeSpan(span);
            return true;
        }
        time = Time.Zero;
        return false;
    }
}
