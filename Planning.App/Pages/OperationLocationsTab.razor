@page "/operation-locations"
@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Layouts
@using Tellurian.Utilities
@using Tellurian.Utilities.Web
@inject ScheduleStateService ScheduleState
@inject Translator Translator
@implements IDisposable

@if (Layout is null)
{
    <p>@Translator("OperationLocationsNoSchedule")</p>
}
else
{
    <div class="operation-locations">
        @if (_mode == Mode.List)
        {
            <div class="toolbar">
                <button class="primary" @onclick="StartAdd">@Translator("AddNew")</button>
            </div>

            @if (_addingType)
            {
                <div class="type-picker">
                    <span>@Translator("SelectLocationType")</span>
                    <button @onclick="() => AddNew(LocationType.Station)">@Translator("Station")</button>
                    <button @onclick="() => AddNew(LocationType.SignalControlled)">@Translator("SignalControlledLocation")</button>
                    <button @onclick="() => AddNew(LocationType.IndustrialArea)">@Translator("IndustrialArea")</button>
                    <button @onclick="() => AddNew(LocationType.Other)">@Translator("OtherLocation")</button>
                    <button @onclick="() => _addingType = false">@Translator("Cancel")</button>
                </div>
            }

            @if (!Locations.Any())
            {
                <p class="empty">@Translator("NoOperationLocations")</p>
            }
            else
            {
                <QuickGrid Items="Locations" Class="grid" Theme="tellurian">
                    <PropertyColumn Property="o => o.Signature" Title='@Translator("Signature")' Sortable="true" />
                    <PropertyColumn Property="o => o.Name" Title='@Translator("Name")' Sortable="true" />
                    <TemplateColumn Title='@Translator("Country")' SortBy="GridSort<OperationLocation>.ByAscending(o => o.CountryId)">@CountryName(context.CountryId)</TemplateColumn>
                    <TemplateColumn Title='@Translator("Type")'>@Translator(TypeKey(context))</TemplateColumn>
                    <TemplateColumn Title='@Translator("Regions")'>
                        @if (context is Station { Regions.Count: > 0 } regionStation)
                        {
                            @foreach (var region in regionStation.Regions)
                            {
                                @region.ToHtml
                            }
                        }
                    </TemplateColumn>
                    <TemplateColumn Title='@Translator("IsManned")' Align="Align.Center">@if (context is Station { IsManned: true }) { <i class="fa-solid fa-check"></i> }</TemplateColumn>
                    <TemplateColumn Title='@Translator("Shadow")' Align="Align.Center">@if (context is Station { IsShadow: true }) { <i class="fa-solid fa-check"></i> }</TemplateColumn>
                    <TemplateColumn Title='@Translator("HasPassengerExchange")' Align="Align.Center">@if (context.HasPassengerExchange) { <i class="fa-solid fa-check"></i> }</TemplateColumn>
                    <TemplateColumn Title='@Translator("HasCargoExchange")' Align="Align.Center">@if (context.HasCargoExchange) { <i class="fa-solid fa-check"></i> }</TemplateColumn>
                    <TemplateColumn Title='@Translator("CargoServedFrom")'>@(context.CargoServedFrom?.Name ?? "")</TemplateColumn>
                    <TemplateColumn Title='@Translator("LockKey")'>@LockKeySummary(context)</TemplateColumn>
                    <TemplateColumn Title='@Translator("ControlledBy")'>@(context is SignalControlledLocation { ControlledBy: { } c } ? c.Name : "")</TemplateColumn>
                    <PropertyColumn Property="o => o.Owner" Title='@Translator("Owner")' Sortable="true" />
                    <TemplateColumn Title='@Translator("PhoneNumber")' Align="Align.Right">@(context.PhoneNumber?.ToString(Culture) ?? "")</TemplateColumn>
                    <TemplateColumn Title='@Translator("Tracks")' Align="Align.Right">@context.Tracks.Count</TemplateColumn>
                    <TemplateColumn Title='@Translator("Actions")' Class="actions">
                        <button @onclick="() => Info(context)">@Translator("Info")</button>
                        <button @onclick="() => Edit(context)"><i class="fa-solid fa-pen"></i> @Translator("Edit")</button>
                        <button class="danger" disabled="@IsReferenced(context)"
                                title='@(IsReferenced(context) ? Translator("LocationReferencedByTrains") : null)'
                                @onclick="() => _deleteTarget = context">
                            @Translator("Delete")
                        </button>
                    </TemplateColumn>
                </QuickGrid>
            }

            @if (_deleteTarget is not null)
            {
                <div class="confirm">
                    <span>@string.Format(Culture, Translator("DeleteLocationConfirm"), _deleteTarget.Name)</span>
                    <button class="danger" @onclick="DeleteConfirmed"><i class="fa-solid fa-trash"></i> @Translator("Delete")</button>
                    <button @onclick="() => _deleteTarget = null">@Translator("Cancel")</button>
                </div>
            }
        }
        else if (_mode == Mode.Edit && Editing is not null)
        {
            <div class="edit">
                <div class="view-header">
                    @if (!_isNew)
                    {
                        <button class="primary" @onclick="BackToList">@Translator("Close")</button>
                    }
                    <h2>@(_isNew ? $"{Translator(TypeKey(Editing))} — {Translator("AddNew")}" : Editing.Name)</h2>
                </div>

                <div class="section">
                    @if (!_isNew)
                    {
                        <div class="field">
                            <label>@Translator("Type")</label>
                            <select value="@TypeKey(Editing)" @onchange="OnTypeChanged">
                                <option value="Station">@Translator("Station")</option>
                                <option value="SignalControlledLocation">@Translator("SignalControlledLocation")</option>
                                <option value="IndustrialArea">@Translator("IndustrialArea")</option>
                                <option value="OtherLocation">@Translator("OtherLocation")</option>
                            </select>
                        </div>
                    }
                    <div class="field">
                        <HelpLabel For="Name" />
                        <input type="text" @bind="Editing.Name" @bind:after="OnEdited" />
                    </div>
                    <div class="field">
                        <HelpLabel For="Signature" />
                        <input type="text" @bind="Editing.Signature" @bind:after="OnEdited" />
                    </div>
                    <div class="field">
                        <label>@Translator("Country")</label>
                        <ListBoxView Items="@(CountryChoices.ToListItems(Translator))" Placeholder="—"
                                     Value="Editing.CountryId" ValueChanged="@(id => { Editing!.CountryId = id; OnEdited(); })" />
                    </div>
                    <div class="field">
                        <HelpLabel For="Owner" />
                        <input type="text" @bind="Editing.Owner" @bind:after="OnEdited" />
                    </div>
                    <div class="field">
                        <HelpLabel For="PhoneNumber" />
                        <input type="number" class="num" @bind="Editing.PhoneNumber" @bind:after="OnEdited" />
                    </div>

                    @* Direction change is only configurable at a station or a signal-controlled location;
                       the other kinds force it to false. *@
                    @if (Editing is Station or SignalControlledLocation)
                    {
                        <div class="field">
                            <HelpLabel For="IsChangingTrainDirectionPossible" />
                            <input type="checkbox" @bind="Editing.IsChangingTrainDirectionPossible" @bind:after="OnEdited" />
                        </div>
                    }

                    @* Passenger exchange is settable at a station or an other location; cargo exchange only
                       at a station (an industrial area always has it). The model forces the rest — including
                       a shadow station, which stands for everything beyond the layout and so exchanges both. *@
                    @{ var shadow = Editing is Station { IsShadow: true }; }
                    @if (Editing is Station or OtherLocation)
                    {
                        <div class="field" title="@(shadow ? Translator("ShadowExchangesEverything") : null)">
                            <HelpLabel For="HasPassengerExchange" />
                            <input type="checkbox" @bind="Editing.HasPassengerExchange" @bind:after="OnEdited" disabled="@shadow" />
                        </div>
                    }

                    @if (Editing is Station)
                    {
                        <div class="field" title="@(shadow ? Translator("ShadowExchangesEverything") : null)">
                            <HelpLabel For="HasCargoExchange" />
                            <input type="checkbox" @bind="Editing.HasCargoExchange" @bind:after="OnEdited" disabled="@shadow" />
                        </div>
                    }

                    <div class="field">
                        <HelpLabel For="HideMeets" />
                        <input type="checkbox" @bind="Editing.HideMeets" @bind:after="OnEdited" />
                    </div>

                    @* An other location always shows its passings; the model forces the flag off there. *@
                    @if (Editing is not OtherLocation)
                    {
                        <div class="field">
                            <HelpLabel For="HidePassings" />
                            <input type="checkbox" @bind="Editing.HidePassings" @bind:after="OnEdited" />
                        </div>
                    }

                    @if (Editing is Station station)
                    {
                        <div class="field">
                            <HelpLabel For="IsShadow" />
                            <input type="checkbox" @bind="station.IsShadow" @bind:after="OnEdited" />
                        </div>
                        <div class="field">
                            <HelpLabel For="IsManned" />
                            <input type="checkbox" @bind="station.IsManned" @bind:after="OnEdited" />
                        </div>
                    }

                    @if (Editing is SignalControlledLocation)
                    {
                        <div class="field">
                            <HelpLabel For="ControlledBy" />
                            <select @bind="ControlledById" @bind:after="OnEdited">
                                <option value="">@Translator("NoneOption")</option>
                                @foreach (var s in Stations)
                                {
                                    <option value="@s.Id">@s.Name (@s.Signature)</option>
                                }
                            </select>
                        </div>
                    }

                    @* Which shunting yard works this location's local freight. Offered only where it
                       makes sense: the location must exchange cargo and must not itself be a shadow
                       station, since a shadow station is where off-layout traffic originates rather than
                       a delivery destination. The picker lists every station, shadow ones included — a
                       shadow shunting yard is a perfectly ordinary origin for local freight. *@
                    @if (Editing.CanBeCargoServed)
                    {
                        <div class="field">
                            <HelpLabel For="CargoServedFrom" />
                            <select @bind="CargoServedFromId" @bind:after="OnEdited">
                                <option value="">@Translator("NoneOption")</option>
                                @foreach (var s in CargoServingStations)
                                {
                                    <option value="@s.Id">@s.Name (@s.Signature)</option>
                                }
                            </select>
                        </div>
                    }

                    @* The key that unlocks the switches here. Offered where nobody is on duty to work
                       them and there is cargo to work, and only manned stations can hold it. The key is
                       named only once a station holds it — a name on its own says nothing.

                       A key already set stays on offer even where one is no longer needed, so it can be
                       cleared or corrected here rather than only by undoing the manning change that
                       made it meaningless. Such a key is kept and ignored, which the hint says and the
                       Conflicts list explains. *@
                    @if (Editing.CanRequireLockKey || Editing.LockKey is not null)
                    {
                        <div class="field">
                            <HelpLabel For="LockKeyHeldAt" />
                            <select @bind="LockKeyHeldAtId" @bind:after="OnEdited">
                                <option value="">@Translator("NoneOption")</option>
                                @foreach (var s in LockKeyStationChoices)
                                {
                                    <option value="@s.Id">@s.Name (@s.Signature)</option>
                                }
                            </select>
                        </div>
                        @if (Editing.LockKey is { } lockKey)
                        {
                            <div class="field">
                                <HelpLabel For="LockKeyName" />
                                <input type="text" @bind="lockKey.Name" @bind:after="OnEdited" />
                            </div>
                        }
                        else if (!LockKeyHoldingStations.Any())
                        {
                            <p class="hint">@Translator("NoMannedStationsForLockKey")</p>
                        }
                        @if (Editing.LockKeyFault is not LockKeyFault.None)
                        {
                            <p class="hint ignored">@Translator("LockKeyIgnoredHint")</p>
                        }
                    }
                </div>

                @if (Editing is Station regionStation)
                {
                    <h3>@Translator("Regions")</h3>
                    @if (!Layout.Regions.Any())
                    {
                        <p class="hint">
                            @Translator("NoRegionsDefined")
                            <button @onclick="AddStandardRegions">@Translator("AddStandardRegions")</button>
                        </p>
                    }
                    else
                    {
                        <div class="regions">
                            @foreach (var r in AvailableRegions(regionStation))
                            {
                                <label class="region-choice">
                                    <input type="checkbox" checked="@HasRegion(regionStation, r)"
                                           @onchange="e => ToggleRegion(regionStation, r, (bool)e.Value!)" />
                                    <span class="chip" style="background-color:@r.BackgroundColor; color:@r.BackgroundColor.TextColor">@r.Name</span>
                                </label>
                            }
                        </div>
                    }
                }

                @* How this location is worked at this meeting. What the location is in itself — its
                   track plan, how it is operated in general — comes from whoever owns it, so it is
                   not what this field is for; the help text says so.

                   Offered at a station or an industrial area; a location trains merely run past, and
                   one nobody works, have nothing to instruct about. Where the field is hidden, what
                   was written stays with the location rather than being thrown away. *@
                @if (Editing.HasInstructions)
                {
                    <div class="field instructions">
                        <HelpLabel For="LocationInstructions" />
                        <p class="hint">@Translator("LocationInstructionsHint")</p>
                        <MarkdownEditor Rows="10" PreviewClass="instructions-body"
                                        @bind-Value="Editing.Instructions" @bind-Value:after="OnEdited" />
                    </div>
                }

                <h3>@Translator("OperationalTimes")</h3>
                <p class="hint">@Translator("OperationalTimesHint")</p>
                <div class="section">
                    <div class="field">
                        <HelpLabel For="MinimumStopMinutes" />
                        <input type="number" class="num" @bind="Editing.Timings.MinimumStopMinutes" @bind:after="OnEdited" />
                    </div>
                    <div class="field">
                        <HelpLabel For="LocoRunaroundRealMinutes" />
                        <input type="number" class="num" @bind="Editing.Timings.LocoRunaroundRealMinutes" @bind:after="OnEdited" />
                    </div>
                    <div class="field">
                        <HelpLabel For="TrainClearanceRealMinutes" />
                        <input type="number" class="num" @bind="Editing.Timings.TrainClearanceRealMinutes" @bind:after="OnEdited" />
                    </div>
                </div>

                <h3>@Translator("Tracks")</h3>
                <table class="tracks">
                    <thead>
                        <tr>
                            <th>@Translator("TrackNumber")</th>
                            <th>@Translator("DisplayOrder")</th>
                            <th>@Translator("IsMain")</th>
                            <th>@Translator("IsScheduled")</th>
                            <th>@Translator("Length")</th>
                            <th>@Translator("Usage")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Editing.Tracks.OrderBy(t => t.DisplayOrder).ThenBy(t => t.Number, StringComparer.OrdinalIgnoreCase).ToList())
                        {
                            <tr>
                                <td><input type="text" class="track-number" @bind="t.Number" @bind:after="OnEdited" /></td>
                                <td><input type="number" class="num" @bind="t.DisplayOrder" @bind:after="OnEdited" /></td>
                                <td><input type="checkbox" @bind="t.IsMain" @bind:after="OnEdited" /></td>
                                <td><input type="checkbox" @bind="t.IsScheduled" @bind:after="OnEdited" /></td>
                                <td><input type="number" step="0.1" class="num" @bind="t.Length" @bind:after="OnEdited" /></td>
                                <td><input type="text" @bind="t.Usage" @bind:after="OnEdited" /></td>
                                <td>
                                    <button class="danger" disabled="@TrackReferenced(t)"
                                            title='@(TrackReferenced(t) ? string.Format(Culture, Translator("TrackReferencedByTrains"), t.Calls.Count) : null)'
                                            @onclick="() => DeleteTrack(t)">
                                        @Translator("Delete")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <button @onclick="AddTrack">@Translator("AddTrack")</button>

                @if (_error is not null)
                {
                    <p class="error">@_error</p>
                }

                @if (_isNew)
                {
                    <div class="form-actions">
                        <button class="primary" @onclick="SaveNew">@Translator("Save")</button>
                        <button @onclick="BackToList">@Translator("Cancel")</button>
                    </div>
                }
            </div>
        }
        else if (_mode == Mode.Info && _selected is not null)
        {
            <div class="info">
                <div class="view-header">
                    <button class="primary" @onclick="BackToList">@Translator("Close")</button>
                    <h2>@_selected.Name (@_selected.Signature)</h2>
                </div>
                <dl>
                    <dt>@Translator("Type")</dt>
                    <dd>@Translator(TypeKey(_selected))</dd>
                    <dt>@Translator("Country")</dt>
                    <dd>@CountryName(_selected.CountryId)</dd>
                    <dt>@Translator("Owner")</dt>
                    <dd>@(string.IsNullOrWhiteSpace(_selected.Owner) ? "—" : _selected.Owner)</dd>
                    <dt>@Translator("PhoneNumber")</dt>
                    <dd>@(_selected.PhoneNumber?.ToString(Culture) ?? "—")</dd>
                    <dt>@Translator("IsChangingTrainDirectionPossible")</dt>
                    <dd>@YesNo(_selected.IsChangingTrainDirectionPossible)</dd>
                    <dt>@Translator("HasPassengerExchange")</dt>
                    <dd>@YesNo(_selected.HasPassengerExchange)</dd>
                    <dt>@Translator("HasCargoExchange")</dt>
                    <dd>@YesNo(_selected.HasCargoExchange)</dd>
                    <dt>@Translator("HideMeets")</dt>
                    <dd>@YesNo(_selected.HideMeets)</dd>
                    <dt>@Translator("HidePassings")</dt>
                    <dd>@YesNo(_selected.HidePassings)</dd>
                    @if (_selected is Station infoStation)
                    {
                        <dt>@Translator("IsShadow")</dt>
                        <dd>@YesNo(infoStation.IsShadow)</dd>
                        <dt>@Translator("IsManned")</dt>
                        <dd>@YesNo(infoStation.IsManned)</dd>
                        <dt>@Translator("Regions")</dt>
                        <dd>
                            @if (infoStation.Regions.Any())
                            {
                                @foreach (var r in infoStation.Regions)
                                {
                                    <span class="chip" style="background-color:@r.BackgroundColor; color:@r.BackgroundColor.TextColor">@r.Name</span>
                                }
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </dd>
                    }
                    @if (_selected is SignalControlledLocation infoSignal)
                    {
                        <dt>@Translator("ControlledBy")</dt>
                        <dd>@(infoSignal.ControlledBy is { } c ? $"{c.Name} ({c.Signature})" : "—")</dd>
                    }
                    @if (_selected.CanRequireLockKey || _selected.LockKey is not null)
                    {
                        <dt>@Translator("LockKeyHeldAt")</dt>
                        <dd>
                            @(_selected.LockKey is { } key ? $"{key.HeldAt.Name} ({key.HeldAt.Signature})" : "—")
                            @if (_selected.LockKeyFault is not LockKeyFault.None)
                            {
                                <span class="hint ignored">@Translator("LockKeyIgnoredHint")</span>
                            }
                        </dd>
                        @if (_selected.LockKey is { Name.Length: > 0 } namedKey)
                        {
                            <dt>@Translator("LockKeyName")</dt>
                            <dd>@namedKey.Name</dd>
                        }
                    }
                    <dt>@Translator("MinimumStopMinutes")</dt>
                    <dd>@Inherited(_selected.Timings.MinimumStopMinutes)</dd>
                    <dt>@Translator("LocoRunaroundRealMinutes")</dt>
                    <dd>@Inherited(_selected.Timings.LocoRunaroundRealMinutes)</dd>
                    <dt>@Translator("TrainClearanceRealMinutes")</dt>
                    <dd>@Inherited(_selected.Timings.TrainClearanceRealMinutes)</dd>
                </dl>

                @* Shown only where instructions apply and something is written; the rendered markdown
                   carries its own headings, so an empty block with nothing under it would only be
                   noise. *@
                @if (_selected.HasInstructions && !string.IsNullOrWhiteSpace(_selected.Instructions))
                {
                    <h3>@Translator("LocationInstructions")</h3>
                    <div class="instructions-body">@Rendered(_selected.Instructions)</div>
                }

                <h3>@Translator("Tracks")</h3>
                @if (_selected.Tracks.Any())
                {
                    <table class="tracks">
                        <thead>
                            <tr>
                                <th>@Translator("TrackNumber")</th>
                                <th>@Translator("DisplayOrder")</th>
                                <th>@Translator("IsMain")</th>
                                <th>@Translator("IsScheduled")</th>
                                <th>@Translator("Length")</th>
                                <th>@Translator("Usage")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in _selected.Tracks.OrderBy(t => t.DisplayOrder).ThenBy(t => t.Number, StringComparer.OrdinalIgnoreCase))
                            {
                                <tr>
                                    <td>@t.Number</td>
                                    <td>@t.DisplayOrder</td>
                                    <td>@YesNo(t.IsMain)</td>
                                    <td>@YesNo(t.IsScheduled)</td>
                                    <td>@(t.Length > 0 ? t.Length.ToString(Culture) : "—")</td>
                                    <td>@(string.IsNullOrWhiteSpace(t.Usage) ? "—" : t.Usage)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="empty">—</p>
                }

            </div>
        }
    </div>
}

@code {
    private enum Mode { List, Edit, Info }
    private enum LocationType { Station, SignalControlled, IndustrialArea, Other }

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private Layout? Layout => ScheduleState.Layout;
    private IQueryable<OperationLocation> Locations =>
        (Layout?.OperationLocations ?? []).AsQueryable();
    private IEnumerable<Station> Stations =>
        Layout?.OperationLocations.OfType<Station>() ?? [];

    private Mode _mode = Mode.List;
    private bool _addingType;
    private bool _isNew;
    private OperationLocation? Editing { get; set; }
    private OperationLocation? _selected;
    private OperationLocation? _deleteTarget;
    private string? _error;

    protected override void OnInitialized()
    {
        ScheduleState.OnChanged += OnStateChanged;
        // Make sure the countries this layout references are in its catalogue (older/imported layouts
        // may not have them yet); only persist when something was actually added.
        if (Layout is { } layout && layout.EnsureCountries()) ScheduleState.SaveAndNotify();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // The location's country, shown in the current UI language; "—" when not set.
    private string CountryName(int? countryId) =>
        Layout!.CountryById(countryId) is { } c ? Translator(c.ResourceKey) : "—";

    // Countries saved with the layout, sorted by their name in the current UI language.
    private IEnumerable<Country> CountryChoices =>
        Layout!.Countries.OrderBy(c => Translator(c.ResourceKey), StringComparer.CurrentCulture);

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        ScheduleState.FlushPendingSave();
    }

    private static string TypeKey(OperationLocation o) => o switch
    {
        Station => "Station",
        SignalControlledLocation => "SignalControlledLocation",
        IndustrialArea => "IndustrialArea",
        _ => "OtherLocation"
    };

    private string YesNo(bool value) => Translator(value ? "Yes" : "No");
    private string Inherited(int? value) => value?.ToString(Culture) ?? "—";

    // Same Markdig call the editor's preview and the printed reports use, so the three agree.
    private static MarkupString Rendered(string markdown) => new(Markdig.Markdown.ToHtml(markdown));

    // A location/track is referenced when any train calls there; such items cannot be deleted.
    private static bool IsReferenced(OperationLocation o) => o.Tracks.Any(t => t.Calls.Count > 0);
    private static bool TrackReferenced(StationTrack t) => t.Calls.Count > 0;

    private void StartAdd()
    {
        _addingType = true;
        _error = null;
    }

    private void AddNew(LocationType type)
    {
        var id = NextLocationId();
        // The constructors reject blank name/signature, so seed placeholders and clear them for the form.
        OperationLocation created = type switch
        {
            LocationType.Station => new Station(id, "x", "x") { IsManned = true },
            LocationType.SignalControlled => new SignalControlledLocation(id, "x", "x"),
            LocationType.IndustrialArea => new IndustrialArea(id, "x", "x"),
            _ => new OtherLocation(id, "x", "x")
        };
        created.Name = "";
        created.Signature = "";
        created.CountryId = Layout!.Settings.Identity.DefaultCountryId;
        Editing = created;
        _isNew = true;
        _addingType = false;
        _mode = Mode.Edit;
    }

    private void Edit(OperationLocation location)
    {
        Editing = location;
        _isNew = false;
        _error = null;
        _mode = Mode.Edit;
    }

    // Changes the type of the location being edited. The model creates a replacement of the new type,
    // carries over the shared state and repoints all references; the form rebinds to it.
    private void OnTypeChanged(ChangeEventArgs e)
    {
        if (Editing is null || Layout is null) return;
        var kind = (string?)e.Value switch
        {
            "SignalControlledLocation" => OperationLocationKind.SignalControlled,
            "IndustrialArea" => OperationLocationKind.IndustrialArea,
            "OtherLocation" => OperationLocationKind.Other,
            _ => OperationLocationKind.Station
        };
        Editing = Layout.ChangeOperationLocationType(Editing, kind);
        _error = null;
        ScheduleState.SaveAndNotify();
    }

    private void Info(OperationLocation location)
    {
        _selected = location;
        _mode = Mode.Info;
    }

    private void BackToList()
    {
        _mode = Mode.List;
        Editing = null;
        _selected = null;
        _isNew = false;
        _error = null;
        _addingType = false;
    }

    // Existing locations are edited live and persisted on each change; a new one is held detached
    // until Save validates and adds it.
    private void OnEdited()
    {
        _error = null;
        if (!_isNew) ScheduleState.SaveAndNotify();
    }

    private void SaveNew()
    {
        if (Editing is null) return;
        if (string.IsNullOrWhiteSpace(Editing.Name) || string.IsNullOrWhiteSpace(Editing.Signature))
        {
            _error = Translator("NameAndSignatureRequired");
            return;
        }
        if (Layout!.OperationLocations.Any(o => o.Signature.Equals(Editing.Signature, StringComparison.OrdinalIgnoreCase)))
        {
            _error = Translator("SignatureMustBeUnique");
            return;
        }
        Layout.Add(Editing);
        ScheduleState.SaveAndNotify();
        BackToList();
    }

    private void DeleteConfirmed()
    {
        if (_deleteTarget is null) return;
        Layout!.OperationLocations.Remove(_deleteTarget);
        _deleteTarget = null;
        ScheduleState.SaveAndNotify();
    }

    private void AddTrack()
    {
        if (Editing is null) return;
        var order = Editing.Tracks.Count == 0 ? 1 : Editing.Tracks.Max(t => t.DisplayOrder) + 1;
        var track = new StationTrack(NextTrackId(), order.ToString(Culture), isMain: false, isScheduled: true)
        {
            DisplayOrder = order
        };
        Editing.Add(track);
        OnEdited();
    }

    private void DeleteTrack(StationTrack track)
    {
        if (Editing is null || TrackReferenced(track)) return;
        Editing.Tracks.Remove(track);
        OnEdited();
    }

    private void AddStandardRegions()
    {
        foreach (var region in Region.DefaultsFor(Layout!.Settings.Identity.DefaultCountryId)) Layout!.Add(region);
        ScheduleState.SaveAndNotify();
    }

    private static bool HasRegion(Station station, Region region) => station.Regions.Any(r => r.Id == region.Id);

    // A region may belong to only one station, so the selector offers regions that are not already
    // attached to a different station; those on this station remain in the list, shown as checked.
    private IEnumerable<Region> AvailableRegions(Station station) =>
        Layout!.Regions.Where(r => !AttachedToOtherStation(r, station));

    private bool AttachedToOtherStation(Region region, Station station) =>
        Layout!.OperationLocations.OfType<Station>()
            .Any(s => s.Id != station.Id && s.Regions.Any(r => r.Id == region.Id));

    private void ToggleRegion(Station station, Region region, bool on)
    {
        var existing = station.Regions.FirstOrDefault(r => r.Id == region.Id);
        if (on && existing is null) station.Regions.Add(region);
        else if (!on && existing is not null) station.Regions.Remove(existing);
        OnEdited();
    }

    private string ControlledById
    {
        get => (Editing as SignalControlledLocation)?.ControlledBy?.Id.ToString(Culture) ?? "";
        set
        {
            if (Editing is not SignalControlledLocation signal) return;
            signal.ControlledBy = int.TryParse(value, NumberStyles.Integer, Culture, out var id)
                ? Stations.FirstOrDefault(s => s.Id == id)
                : null;
        }
    }

    // Every station except the one being edited: a location cannot be served from itself.
    private IEnumerable<Station> CargoServingStations =>
        Editing is null ? [] : Layout?.CargoServingStationsFor(Editing) ?? [];

    private string CargoServedFromId
    {
        get => Editing?.CargoServedFrom?.Id.ToString(Culture) ?? "";
        set
        {
            if (Editing is null) return;
            Editing.CargoServedFrom = int.TryParse(value, NumberStyles.Integer, Culture, out var id)
                ? Stations.FirstOrDefault(s => s.Id == id)
                : null;
        }
    }

    // Only a manned station can hold a lock key: an unmanned one has nobody to hand it over.
    private IEnumerable<Station> LockKeyHoldingStations => Layout?.LockKeyHoldingStations ?? [];

    // The stations the picker offers: the manned ones, plus the station already holding this key where
    // it has since been unmanned. Leaving that one out would show "(none)" for a key that is still set,
    // and the planner would have no way to tell an ignored key from no key at all.
    private IEnumerable<Station> LockKeyStationChoices =>
        Editing?.LockKey?.HeldAt is { IsManned: false } held
            ? [held, .. LockKeyHoldingStations]
            : LockKeyHoldingStations;

    // The whole key is the station that holds it: choosing none removes the key, and the name goes with
    // it, since a name with nowhere to fetch it from tells the driver nothing.
    private string LockKeyHeldAtId
    {
        get => Editing?.LockKey?.HeldAt.Id.ToString(Culture) ?? "";
        set
        {
            if (Editing is null) return;
            // Looked up among the offered choices, not the manned stations alone: re-picking the station
            // that already holds an ignored key must keep it, not silently clear it.
            var station = int.TryParse(value, NumberStyles.Integer, Culture, out var id)
                ? LockKeyStationChoices.FirstOrDefault(s => s.Id == id)
                : null;
            if (station is null) Editing.LockKey = null;
            else if (Editing.LockKey is { } key) key.HeldAt = station;
            else Editing.LockKey = new LockKey { HeldAt = station };
        }
    }

    // What the grid shows for a key: its name where it has one, and where it is fetched.
    private static string LockKeySummary(OperationLocation location) =>
        location.LockKey is not { } key ? "" :
        key.Name.HasValue ? $"{key.Name} ({key.HeldAt.Signature})" : key.HeldAt.Signature;

    private int NextLocationId() =>
        (Layout!.OperationLocations.Count == 0 ? 0 : Layout.OperationLocations.Max(o => o.Id)) + 1;

    private int NextTrackId()
    {
        var existing = Layout!.OperationLocations.SelectMany(o => o.Tracks).Select(t => t.Id);
        var pending = Editing?.Tracks.Select(t => t.Id) ?? [];
        return existing.Concat(pending).DefaultIfEmpty(0).Max() + 1;
    }
}
