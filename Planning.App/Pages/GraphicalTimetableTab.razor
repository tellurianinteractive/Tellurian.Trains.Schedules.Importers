@page "/graphical-timetable"
@using Tellurian.Trains.Schedules.Planning.Timetables
@inject ScheduleStateService ScheduleState
@inject ValidationStateService ValidationState
@inject Translator Translator
@inject UiPreferenceService UiPrefs
@implements IDisposable


@if (!ScheduleState.HasSchedule)
{
    <p>@Translator("GraphNoSchedule")</p>
}
else if (ScheduleState.TimetableStretches.Count == 0)
{
    <p>@Translator("NoTimetableStretches")</p>
}
else
{
    @* The loco driver demand strip covers the whole timetable, so it is shown whether or not any stretch is graphed.
       With a horizontal time axis it shares the graphs' x axis and goes above everything; with a vertical
       axis it shares their y axis and is placed leftmost in the graph row instead (see below). *@
    @if (ShowLocoDriverDemand && !IsVerticalAxis)
    {
        <LocoDriverDemandBar Timetable="ScheduleState.Timetable" Settings="_graphSettings"
                            Start="_driverWindow.Start" End="_driverWindow.End" />
    }

    @* The train actions all operate on what the graphs show, so they appear only once a stretch is graphed. *@
    @if (_graphSchedules.Count > 0)
    {
        <div class="graph-toolbar">
            <button class="primary" @onclick="() => _showAdd = true">@Translator("AddTrain")</button>
            <button @onclick="() => _showMove = true">@Translator("MoveTrains")</button>
            <button @onclick="() => _showClone = true">@Translator("CloneTrains")</button>
            <button @onclick="() => _showUpdateTimings = true">@Translator("UpdateTimings")</button>
            <button @onclick="UpdateAllTimings">@Translator("UpdateAllTimings")</button>
        </div>

        @if (_updateAllTimingsError is not null)
        {
            <p class="error">@Translator(_updateAllTimingsError)</p>
        }
    }

    <div class="selectors">
        <div class="stretch-selector">
            <span class="stretch-selector-label">@Translator("Stretches"):</span>
            @foreach (var stretch in ScheduleState.TimetableStretches)
            {
                <label class="stretch-option" title="@stretch.ForwardDescription">
                    <input type="checkbox"
                           checked="@ScheduleState.IsSelected(stretch)"
                           @onchange="e => OnStretchToggled(stretch, e)" />
                    <span>@stretch.ForwardDescription</span>
                </label>
            }
        </div>

        @if (HasBreak)
        {
            <div class="half-selector">
                <span class="half-selector-label">@Translator("GraphPart"):</span>
                @foreach (var (half, key) in Halves)
                {
                    <label class="half-option">
                        <input type="radio" name="graph-half"
                               checked="@(_half == half)"
                               @onchange="() => OnHalfSelected(half)" />
                        <span>@Translator(key)</span>
                    </label>
                }
            </div>
        }
    </div>

    <div class="graph-list @StackingCss">
        @if (ShowLocoDriverDemand && IsVerticalAxis)
        {
            <LocoDriverDemandBar Timetable="ScheduleState.Timetable" Settings="_graphSettings"
                                Start="_driverWindow.Start" End="_driverWindow.End" />
        }
        @foreach (var graphSchedule in _graphSchedules)
        {
            <GraphicalScheduleEditor Schedule="graphSchedule" Errors="ValidationState.Errors" />
        }
    </div>

    @if (_graphSchedules.Count == 0)
    {
        <p>@Translator("SelectStretches")</p>
    }

    @if (_showAdd)
    {
        <AddTrainDialog OnCreated="() => _showAdd = false" OnClosed="() => _showAdd = false" />
    }

    @if (_showMove)
    {
        <ShiftTrainsDialog IsClone="false" OnApplied="() => _showMove = false" OnClosed="() => _showMove = false" />
    }

    @if (_showClone)
    {
        <ShiftTrainsDialog IsClone="true" OnApplied="() => _showClone = false" OnClosed="() => _showClone = false" />
    }

    @if (_showUpdateTimings)
    {
        <UpdateTimingsDialog OnApplied="() => _showUpdateTimings = false" OnClosed="() => _showUpdateTimings = false" />
    }
}

@code {
    private List<GraphSchedule> _graphSchedules = [];
    private GraphSettings? _graphSettings;
    private (TimeSpan Start, TimeSpan End) _driverWindow;
    private GraphHalf _half = GraphHalf.Whole;
    private bool _showAdd;
    private bool _showMove;
    private bool _showClone;
    private bool _showUpdateTimings;
    private string? _updateAllTimingsError;

    // The first/last-half selector is only meaningful when a break time is configured.
    private bool HasBreak => ScheduleState.Layout?.Settings.General.BreakTime is not null;

    private static readonly (GraphHalf Half, string Key)[] Halves =
    [
        (GraphHalf.Whole, "WholeGraph"),
        (GraphHalf.First, "FirstHalf"),
        (GraphHalf.Last, "LastHalf"),
    ];

    // The loco driver demand strip needs a timetable, the shared axis geometry, and drivers to compare against; it
    // hides itself when none are expected, but there is no point rendering it without the first two.
    private bool ShowLocoDriverDemand => ScheduleState.Timetable is not null && _graphSettings is not null;

    private bool IsVerticalAxis => _graphSettings?.AxisDirection == TimeAxisDirection.Vertical;

    // Horizontal time axis → graphs grow downward, so stack them vertically; a vertical
    // time axis makes graphs grow sideways, so stack them horizontally.
    private string StackingCss => IsVerticalAxis ? "stack-horizontal" : "stack-vertical";

    protected override void OnInitialized()
    {
        ScheduleState.OnChanged += OnStateChanged;
        ValidationState.OnValidationChanged += OnValidationChanged;
        BuildGraphSchedules();
    }

    protected override async Task OnInitializedAsync()
    {
        if (await UiPrefs.GetGraphHalfAsync() is { } saved && Enum.TryParse<GraphHalf>(saved, out var half))
        {
            _half = half;
            BuildGraphSchedules();
        }
    }

    // Recomputes every train in the timetable at once, unlike UpdateTimingsDialog which lets the user
    // restrict the recompute to a chosen subset.
    private void UpdateAllTimings()
    {
        _updateAllTimingsError = null;
        if (ScheduleState.Schedule is not { } plan || ScheduleState.Timetable is not { } timetable) return;

        var anyFailed = false;
        foreach (var train in timetable.Trains)
            if (plan.UpdateTimings(train) is null) anyFailed = true;

        ScheduleState.SaveAndNotify();
        if (anyFailed) _updateAllTimingsError = "UpdateAllTimingsFailed";
    }

    private void OnStretchToggled(TimetableStretch stretch, ChangeEventArgs e)
    {
        var selected = e.Value is bool b && b;
        ScheduleState.SetStretchSelected(stretch, selected);
    }

    private void OnHalfSelected(GraphHalf half)
    {
        _half = half;
        BuildGraphSchedules();
        _ = UiPrefs.SetGraphHalfAsync(half.ToString());
    }

    private void OnStateChanged()
    {
        BuildGraphSchedules();
        InvokeAsync(StateHasChanged);
    }

    // Validation recomputes on a debounce after an edit; re-render so the graph re-reads ValidationState.Errors
    // and refreshes its conflict highlighting. The graph schedules themselves are unchanged, so don't rebuild them.
    private void OnValidationChanged() => InvokeAsync(StateHasChanged);

    private void BuildGraphSchedules()
    {
        if (ScheduleState.Timetable is { } timetable)
        {
            _graphSettings = ScheduleState.Layout?.Settings.ToGraphSettings();
            // A break may have been cleared since it was last selected; fall back to the whole graph.
            if (!HasBreak) _half = GraphHalf.Whole;
            _graphSchedules = [.. ScheduleState.SelectedStretches
                .Select(stretch => new GraphSchedule(stretch, timetable, _graphSettings, _half))];

            // The loco driver demand strip shares the graphs' time axis. Take the window from a drawn graph whenever
            // there is one, so the two line up exactly; with nothing selected there is no graph to match, so
            // derive the same window from the whole timetable instead.
            _driverWindow = _graphSchedules.FirstOrDefault() is { } graph
                ? (graph.StartTime, graph.EndTime)
                : GraphSchedule.TimeWindow(
                    _graphSettings ?? GraphSettings.Default,
                    GraphSchedule.CrossesMidnight(timetable.Trains.SelectMany(t => t.Calls)),
                    _half);
        }
        else
        {
            _graphSchedules = [];
            _graphSettings = null;
        }
    }

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        ValidationState.OnValidationChanged -= OnValidationChanged;
    }
}
