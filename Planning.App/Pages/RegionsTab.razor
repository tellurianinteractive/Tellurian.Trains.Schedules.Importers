@page "/regions"
@using System.Globalization
@using Tellurian.Trains.Schedules.Model
@using Tellurian.Trains.Schedules.Model.Layouts
@inject ScheduleStateService ScheduleState
@inject Translator Translator
@implements IDisposable

@if (Layout is null)
{
    <p>@Translator("RegionsNoSchedule")</p>
}
else
{
    <div class="regions-editor">
        @if (_mode == Mode.List)
        {
            <div class="toolbar">
                <button class="primary" @onclick="StartAdd">@Translator("AddNew")</button>
                <button @onclick="AddDefaults">@Translator("DefaultRegions")</button>
            </div>

            @if (!Regions.Any())
            {
                <p class="empty">@Translator("NoRegions")</p>
            }
            else
            {
                <QuickGrid Items="Regions" Class="grid" Theme="tellurian">
                    <TemplateColumn Title='@Translator("Region")'>@context.Display</TemplateColumn>
                    <TemplateColumn Title='@Translator("Country")'>@CountryName(context.CountryId)</TemplateColumn>
                    <TemplateColumn Title='@Translator("Actions")' Class="actions">
                        <button @onclick="() => Edit(context)">@Translator("Edit")</button>
                        <button class="danger" disabled="@IsReferenced(context)"
                                title='@(IsReferenced(context) ? Translator("RegionReferenced") : null)'
                                @onclick="() => _deleteTarget = context">@Translator("Delete")</button>
                    </TemplateColumn>
                </QuickGrid>
            }

            @if (_deleteTarget is not null)
            {
                <div class="confirm">
                    <span>@string.Format(Culture, Translator("DeleteRegionConfirm"), _deleteTarget.Name)</span>
                    <button class="danger" @onclick="DeleteConfirmed">@Translator("Delete")</button>
                    <button @onclick="() => _deleteTarget = null">@Translator("Cancel")</button>
                </div>
            }
        }
        else if (_mode == Mode.Edit && Editing is not null)
        {
            <div class="edit">
                <h2>@(_isNew ? Translator("AddNew") : Editing.Name)</h2>

                <div class="section">
                    <div class="field">
                        <HelpLabel For="Name" />
                        <input type="text" @bind="Editing.Name" @bind:after="OnEdited" />
                    </div>
                    <div class="field">
                        <label>@Translator("Country")</label>
                        <select @bind="Editing.CountryId" @bind:after="OnEdited">
                            @foreach (var c in CountryChoices)
                            {
                                <option value="@c.Id">@Translator(c.ResourceKey)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <HelpLabel For="BackgroundColor" />
                        <div class="palette">
                            @foreach (var color in Region.Palette)
                            {
                                <button type="button" title="@color"
                                        class="swatch@(IsSelected(color) ? " selected" : "")"
                                        style="background-color:@color"
                                        @onclick="() => SelectColor(color)"></button>
                            }
                        </div>
                    </div>
                    <div class="field">
                        <label>@Translator("Region")</label>
                        <span>@Editing.Display</span>
                    </div>
                </div>

                @if (_error is not null)
                {
                    <p class="error">@_error</p>
                }

                <div class="form-actions">
                    @if (_isNew)
                    {
                        <button class="primary" @onclick="SaveNew">@Translator("Save")</button>
                        <button @onclick="BackToList">@Translator("Cancel")</button>
                    }
                    else
                    {
                        <button class="primary" @onclick="BackToList">@Translator("Close")</button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private enum Mode { List, Edit }

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private Layout? Layout => ScheduleState.Layout;
    private IQueryable<Region> Regions => (Layout?.Regions ?? []).AsQueryable();

    private Mode _mode = Mode.List;
    private bool _isNew;
    private Region? Editing { get; set; }
    private Region? _deleteTarget;
    private string? _error;

    protected override void OnInitialized()
    {
        ScheduleState.OnChanged += OnStateChanged;
        // Make sure the countries this layout references are in its catalogue (older/imported layouts
        // may not have them yet); only persist when something was actually added.
        if (Layout is { } layout && layout.EnsureCountries()) ScheduleState.SaveAndNotify();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        ScheduleState.FlushPendingSave();
    }

    // A region is referenced when any station is associated with it; such regions cannot be deleted.
    private bool IsReferenced(Region region) =>
        Layout!.OperationLocations.OfType<Station>().Any(s => s.Regions.Any(r => r.Id == region.Id));

    // The country a region belongs to, shown in the current UI language; "—" when not set.
    private string CountryName(int? countryId) =>
        Layout!.CountryById(countryId) is { } c ? Translator(c.ResourceKey) : "—";

    // Countries saved with the layout, sorted by their name in the current UI language.
    private IEnumerable<Country> CountryChoices =>
        Layout!.Countries.OrderBy(c => Translator(c.ResourceKey), StringComparer.CurrentCulture);

    private bool IsSelected(string color) =>
        Editing is not null && string.Equals(Editing.BackgroundColor, color, StringComparison.OrdinalIgnoreCase);

    private void SelectColor(string color)
    {
        if (Editing is null) return;
        Editing.BackgroundColor = color;
        OnEdited();
    }

    private void StartAdd()
    {
        Editing = new Region { Id = NextId(), Name = "", CountryId = Layout!.Settings.Identity.DefaultCountryId };
        _isNew = true;
        _error = null;
        _mode = Mode.Edit;
    }

    private void Edit(Region region)
    {
        Editing = region;
        _isNew = false;
        _error = null;
        _mode = Mode.Edit;
    }

    private void BackToList()
    {
        _mode = Mode.List;
        Editing = null;
        _isNew = false;
        _error = null;
    }

    // Existing regions edit live and persist on each change; a new one is held until Save validates it.
    private void OnEdited()
    {
        _error = null;
        if (!_isNew) ScheduleState.SaveAndNotify();
    }

    private void SaveNew()
    {
        if (Editing is null) return;
        if (string.IsNullOrWhiteSpace(Editing.Name))
        {
            _error = Translator("RegionNameRequired");
            return;
        }
        Layout!.Add(Editing);
        ScheduleState.SaveAndNotify();
        BackToList();
    }

    private void DeleteConfirmed()
    {
        if (_deleteTarget is null) return;
        Layout!.Regions.Remove(_deleteTarget);
        _deleteTarget = null;
        ScheduleState.SaveAndNotify();
    }

    private void AddDefaults()
    {
        foreach (var region in Region.DefaultsFor(Layout!.Settings.Identity.DefaultCountryId)) Layout!.Add(region);
        ScheduleState.SaveAndNotify();
    }

    private int NextId() => (Layout!.Regions.Count == 0 ? 0 : Layout.Regions.Max(r => r.Id)) + 1;
}
