<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<AssemblyName>Tellurian.Trains.Schedules.Planning.App</AssemblyName>
		<RootNamespace>Tellurian.Trains.Schedules.Planning.App</RootNamespace>
		<IsPackable>false</IsPackable>
		<!-- The app has its own release cycle, separate from the NuGet libraries' version in
		     Directory.Build.props. This is the number shown in the top bar and headed in the
		     ReleaseNotes markdown; bump both together. -->
		<Version>0.5.0</Version>
		<AssemblyVersion>0.5.0.0</AssemblyVersion>
		<FileVersion>0.5.0.0</FileVersion>
		<!-- SourceLink would otherwise append "+<commit sha>" to the informational version. -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<!-- Ahead-of-time compile the WebAssembly on publish for faster CPU-bound work (e.g. ODS import).
         Only applied by `dotnet publish` (Release); `dotnet build`/`run` stay interpreted for fast dev.
         Requires the wasm-tools workload: `dotnet workload install wasm-tools`. -->
		<RunAOTCompilation>true</RunAOTCompilation>
		<!-- Required so the UI culture can be set dynamically at startup (see LanguageSelector). -->
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
	</PropertyGroup>
	<PropertyGroup> <DebugType>portable</DebugType> <DebugSymbols>true</DebugSymbols> <IncludeSymbols>true</IncludeSymbols> </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>embedded</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<IncludeSymbols>true</IncludeSymbols>
		<!-- Keep dev publishes fast and untrimmed; AOT/trimming only apply to Release. -->
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>embedded</DebugType>
		<!-- AOT requires IL trimming. TrimMode=partial only trims assemblies marked
		     trimmable (the framework/BCL); every first-party assembly is preserved
		     whole, so reflection and localisation resources stay intact. -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Planning.App.Translations\Planning.App.Translations.csproj" />
		<ProjectReference Include="..\Planning.Components\Planning.Components.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
