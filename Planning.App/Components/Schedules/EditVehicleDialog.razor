@namespace Tellurian.Trains.Schedules.Planning.App.Components.Schedules
@using System.Globalization
@using Tellurian.Trains.Schedules.Planning.App.Services
@inject ScheduleStateService ScheduleState
@inject Translator Translator

@* Edits a vehicle already on a schedule: its identity (type, external id, class, number, company) and
   the sessions/days its assignment covers on this schedule. The external id is a display override — when
   left blank the vehicle is shown as its company signature, class and number instead. *@

@if (Plan is not null)
{
    <div class="edit-vehicle-backdrop">
        <div class="edit-vehicle-dialog">
            <h3>@Translator("EditVehicle")</h3>

            <div class="field">
                <label>@Translator("VehicleType")</label>
                <select value="@_type" @onchange="e => _type = e.Value?.ToString() ?? _type">
                    @foreach (var type in CreatableTypes)
                    {
                        <option value="@type">@Translator(type.ToString())</option>
                    }
                </select>
            </div>
            @if (IsTractionType)
            {
                <div class="field">
                    <label>@Translator("TractionType")</label>
                    <select value="@_tractionType" @onchange="OnTractionTypeChanged">
                        @foreach (var traction in TractionTypes)
                        {
                            <option value="@traction">@Translator(traction.ToString())</option>
                        }
                    </select>
                </div>
            }
            <div class="field">
                <label>@Translator("ExternalId")</label>
                <input type="text" value="@_externalId" @onchange="e => _externalId = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="field">
                <label>@Translator("Class")</label>
                <input type="text" value="@_class" @onchange="e => _class = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="field">
                <label>@Translator("Number")</label>
                <input type="number" class="num" min="0" value="@_number" @onchange="e => _number = ParseInt(e, _number)" />
            </div>
            <div class="field">
                <label>@Translator("Company")</label>
                <select value="@(_companyId?.ToString() ?? string.Empty)" @onchange="OnCompanyChanged">
                    <option value="">@Translator("None")</option>
                    @foreach (var company in Companies)
                    {
                        <option value="@company.Id">@company.Name</option>
                    }
                </select>
            </div>
            @if (IsTractionType || IsWagonsetType)
            {
                <div class="field">
                    <label>@Translator(IsWagonsetType ? "NumberOfWagons" : "NumberOfUnits")</label>
                    <input type="number" class="num" min="1"
                           value="@EffectiveNumberOfUnits"
                           disabled="@(IsWagonsetType && _wagons.Count > 0)"
                           @onchange="e => _numberOfUnits = ParseInt(e, _numberOfUnits)" />
                </div>
            }
            @if (IsWagonsetType)
            {
                <div class="field wagons">
                    <label>@Translator("Wagons")</label>
                    <div class="wagon-list">
                        @for (var i = 0; i < _wagons.Count; i++)
                        {
                            var index = i;
                            var wagon = _wagons[index];
                            <div class="wagon-row">
                                <span class="pos">@(index + 1)</span>
                                <input type="text" class="wagon-class" placeholder="@Translator("Class")"
                                       value="@wagon.Class" @onchange="e => wagon.Class = e.Value?.ToString() ?? string.Empty" />
                                <input type="text" class="wagon-number" placeholder="@Translator("Number")"
                                       value="@wagon.Number" @onchange="e => wagon.Number = e.Value?.ToString()" />
                                <label class="wagon-kind" title="@Translator("PassengerWagon")">
                                    <input type="checkbox" checked="@wagon.IsPassenger" @onchange="e => wagon.IsPassenger = (bool)(e.Value ?? false)" />P
                                </label>
                                <label class="wagon-kind" title="@Translator("FreightWagon")">
                                    <input type="checkbox" checked="@wagon.IsCargo" @onchange="e => wagon.IsCargo = (bool)(e.Value ?? false)" />G
                                </label>
                                <button type="button" class="move" title="@Translator("MoveUp")" disabled="@(index == 0)" @onclick="() => MoveWagon(index, -1)"><i class="fa-solid fa-arrow-up"></i></button>
                                <button type="button" class="move" title="@Translator("MoveDown")" disabled="@(index == _wagons.Count - 1)" @onclick="() => MoveWagon(index, 1)"><i class="fa-solid fa-arrow-down"></i></button>
                                <button type="button" class="remove" title="@Translator("RemoveWagon")" @onclick="() => _wagons.RemoveAt(index)"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        }
                        <button type="button" class="add-wagon" @onclick="AddWagon"><i class="fa-solid fa-plus"></i> @Translator("AddWagon")</button>
                    </div>
                </div>
            }
            <div class="field">
                <label>@Translator(UseDays ? "Days" : "Sessions")</label>
                <select value="@_sessionsKey" @onchange="OnSessionsChanged">
                    @* The assignment's own pattern may not be in the catalogue; keep it selectable. *@
                    @if (!SessionsCatalogue.Any(s => SessionsDisplay.Key(s) == _sessionsKey))
                    {
                        <option value="@_sessionsKey" selected>@SessionsText(_sessions)</option>
                    }
                    @foreach (var sessions in SessionsCatalogue)
                    {
                        <option value="@SessionsDisplay.Key(sessions)">@SessionsText(sessions)</option>
                    }
                </select>
            </div>

            <div class="actions">
                <button class="primary" @onclick="Save">@Translator("Save")</button>
                <button @onclick="Cancel">@Translator("Cancel")</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The schedule the vehicle is assigned to.</summary>
    [Parameter, EditorRequired] public Schedule Schedule { get; set; } = default!;

    /// <summary>The vehicle being edited.</summary>
    [Parameter, EditorRequired] public ScheduledObject Vehicle { get; set; } = default!;

    /// <summary>The vehicle's assignment on this schedule, whose sessions/days are edited.</summary>
    [Parameter, EditorRequired] public ScheduleAssignment Assignment { get; set; } = default!;

    /// <summary>Raised after the edit has been applied and saved.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>Raised when the dialog is dismissed without saving.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private static readonly ScheduledObjectType[] CreatableTypes =
        [ScheduledObjectType.Locomotive, ScheduledObjectType.Trainset, ScheduledObjectType.Wagonset];

    // The traction types offered for a traction unit: all but None (the non-traction sentinel).
    private static IEnumerable<TractionType> TractionTypes =>
        Enum.GetValues<TractionType>().Where(t => t != TractionType.None);

    private Plan? Plan => ScheduleState.Schedule;

    private bool UseDays => ScheduleState.Layout?.Settings.General.UseDays ?? false;
    private int MaxSessions => ScheduleState.Layout?.Settings.General.MaxSessions ?? 14;
    private DayOfWeek StartDay => ScheduleState.Layout?.Settings.General.StartDay ?? DayOfWeek.Monday;

    private string _type = ScheduledObjectType.Locomotive.ToString();
    private string _externalId = "";
    private string _class = "";
    private int _number;
    private int? _companyId;
    private TractionType _tractionType = TractionType.Undefined;
    private int _numberOfUnits = 1;
    private readonly List<Wagon> _wagons = [];
    private Sessions _sessions;
    private string _sessionsKey = "";

    private ScheduledObjectType Type =>
        Enum.TryParse<ScheduledObjectType>(_type, out var t) ? t : ScheduledObjectType.Locomotive;
    private bool IsTractionType => Type.IsTraction;
    private bool IsWagonsetType => Type.IsWagonSet;

    // The number of units to display and save: the listed wagon count wins for a wagonset that lists its
    // individual wagons, otherwise the entered number.
    private int EffectiveNumberOfUnits =>
        IsWagonsetType && _wagons.Count > 0 ? _wagons.Count : _numberOfUnits;

    protected override void OnInitialized()
    {
        _type = Vehicle.ObjectType.ToString();
        _externalId = Vehicle.ExternalId ?? "";
        _class = Vehicle.Class;
        _number = Vehicle.Number;
        _companyId = Vehicle.CompanyId;
        _tractionType = Vehicle.TractionType == TractionType.None ? TractionType.Undefined : Vehicle.TractionType;
        _numberOfUnits = Math.Max(1, Vehicle.NumberOfUnits);
        // Stage clones so the dialog can be cancelled without touching the vehicle's rake.
        _wagons.AddRange(Vehicle.Units.OfType<Wagon>().OrderBy(w => w.Position).Select(w => new Wagon
        {
            Position = w.Position,
            Class = w.Class,
            Number = w.Number,
            IsPassenger = w.IsPassenger,
            IsCargo = w.IsCargo,
        }));
        _sessions = Assignment.Sessions;
        _sessionsKey = SessionsDisplay.Key(_sessions);
    }

    private void OnTractionTypeChanged(ChangeEventArgs e) =>
        _tractionType = Enum.TryParse<TractionType>(e.Value?.ToString(), out var t) ? t : _tractionType;

    private void AddWagon() =>
        _wagons.Add(new Wagon { Class = string.Empty, Position = _wagons.Count + 1, IsCargo = true });

    private void MoveWagon(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _wagons.Count) return;
        (_wagons[index], _wagons[target]) = (_wagons[target], _wagons[index]);
    }

    private IEnumerable<Company> Companies =>
        (Plan?.Layout?.Companies ?? []).OrderBy(c => c.Name, StringComparer.CurrentCulture);

    private IEnumerable<Sessions> SessionsCatalogue =>
        ScheduleState.Timetable?.Sessions ?? [];

    private void OnCompanyChanged(ChangeEventArgs e) =>
        _companyId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private void OnSessionsChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (SessionsCatalogue.FirstOrDefault(s => SessionsDisplay.Key(s) == key) is { } match && key is not null)
        {
            _sessions = match;
            _sessionsKey = key;
        }
    }

    private async Task Save()
    {
        if (Plan is not { } plan) return;
        var type = Enum.TryParse<ScheduledObjectType>(_type, out var t) ? t : ScheduledObjectType.Locomotive;
        var company = _companyId is int id ? plan.Layout.Companies.FirstOrDefault(c => c.Id == id) : null;
        plan.UpdateVehicle(Vehicle, type, _externalId, _class, _number, company, _tractionType, EffectiveNumberOfUnits);
        // Apply the staged wagon rake (UpdateVehicle already cleared it for a non-wagonset).
        if (type.IsWagonSet)
        {
            Vehicle.Units.Clear();
            var position = 1;
            foreach (var wagon in _wagons)
            {
                wagon.Position = position++;
                Vehicle.Units.Add(wagon);
            }
        }
        Assignment.Sessions = _sessions;
        ScheduleState.SaveAndNotify();
        await OnSaved.InvokeAsync();
    }

    private Task Cancel() => OnClosed.InvokeAsync();

    private string SessionsText(Sessions sessions) => SessionsDisplay.Text(sessions, UseDays, Translator, MaxSessions, StartDay);

    private static int ParseInt(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.CurrentCulture, out var value) ? value : fallback;
}
