@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Layouts
@using Tellurian.Trains.Schedules.Model.Schedules
@using Tellurian.Trains.Schedules.Model.Timetables
@using Tellurian.Trains.Schedules.Model.Validations
@inject ScheduleStateService ScheduleState
@inject Translator Translator
@implements IDisposable

<div class="cargo-trains">
    <p class="hint">@Translator("CargoTrainsDescription")</p>

    @if (Descriptions.Count == 0)
    {
        <p class="empty">@Translator("CargoTrainsNeedDescriptions")</p>
    }
    else
    {
        <div class="toolbar">
            <select @bind="_addTrainId">
                <option value="0">@Translator("SelectTrain")</option>
                @foreach (var train in AddableTrains)
                {
                    <option value="@train.Id">@TrainLabel(train)</option>
                }
            </select>
            <button class="primary" disabled="@(_addTrainId == 0)" @onclick="AddToSelectedTrain">@Translator("AddCargoFlow")</button>
        </div>

        @if (Masters.Count == 0)
        {
            <p class="empty">@Translator("NoCargoFlows")</p>
        }
        else
        {
            <table class="grid">
                <thead>
                    <tr>
                        <th class="expander"></th>
                        <th>@Translator("Train")</th>
                        <th class="num">@Translator("CargoFlows")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var train in Masters)
                    {
                        <tr class="master @(IsExpanded(train) ? "expanded" : "")">
                            <td class="expander">
                                <button class="toggle" title="@Translator(IsExpanded(train) ? "Collapse" : "Expand")"
                                        @onclick="() => ToggleExpanded(train)">@(IsExpanded(train) ? "▾" : "▸")</button>
                            </td>
                            <td>@TrainLabel(train)</td>
                            <td class="num">@train.CargoFlows.Count</td>
                        </tr>
                        @if (IsExpanded(train))
                        {
                            <tr class="detail">
                                <td></td>
                                <td colspan="2">@FlowsTable(train)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    }

    @if (_deleteTarget is not null)
    {
        <div class="confirm">
            <span>@Translator("DeleteCargoFlowConfirm")</span>
            <button class="danger" @onclick="DeleteConfirmed">@Translator("Delete")</button>
            <button @onclick="() => _deleteTarget = null">@Translator("Cancel")</button>
        </div>
    }
</div>

@code {
    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private Plan? Plan => ScheduleState.Schedule;
    private Timetable? Timetable => ScheduleState.Timetable;

    private List<CargoFlowOptions> Descriptions =>
        [.. (Timetable?.CargoFlowOptions ?? []).OrderBy(o => o.Name, StringComparer.CurrentCulture)];

    // Trains that already have cargo flows, shown as the master rows.
    private List<Train> Masters =>
        [.. (Timetable?.Trains ?? []).Where(t => t.CargoFlows.Count > 0).OrderBy(t => t.Number)];

    // Trains a cargo flow can be added to: those with at least one departure call followed by an arrival.
    private List<Train> AddableTrains =>
        [.. (Timetable?.Trains ?? []).Where(CanHostCargoFlow).OrderBy(t => t.Number)];

    private int _addTrainId;
    private readonly HashSet<int> _expanded = [];
    private CargoFlowTrainPart? _deleteTarget;

    protected override void OnInitialized() => ScheduleState.OnChanged += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ScheduleState.OnChanged -= OnStateChanged;
        ScheduleState.FlushPendingSave();
    }

    private bool IsExpanded(Train train) => _expanded.Contains(train.Id);

    private void ToggleExpanded(Train train)
    {
        if (!_expanded.Remove(train.Id)) _expanded.Add(train.Id);
    }

    // ---- Call choices ----------------------------------------------------------------------------

    // Where wagons can be connected: the train's departure calls, earliest first.
    private static IEnumerable<StationCall> FromCallChoices(Train train) =>
        train.Calls.Where(c => c.IsDeparture).OrderBy(c => c.SortTime);

    // Where wagons can be disconnected: arrivals after the chosen from-call, latest first (the natural
    // default is the final destination).
    private static IEnumerable<StationCall> ToCallChoices(Train train, StationCall from) =>
        train.Calls.Where(c => c.IsArrival && c.SortTime > from.SortTime).OrderByDescending(c => c.SortTime);

    private static bool CanHostCargoFlow(Train train) =>
        FromCallChoices(train).Any(from => ToCallChoices(train, from).Any());

    private static string CallLabel(StationCall call) => $"{call.Station.Name} {call.SortTime.HHMM()}";

    private string TrainLabel(Train train) =>
        train.EffectiveCompany is { } c ? $"{c.Signature} {train.Identity}".Trim() : train.Identity;

    // ---- Add / delete ----------------------------------------------------------------------------

    private void AddToSelectedTrain()
    {
        if (Timetable?.Trains.FirstOrDefault(t => t.Id == _addTrainId) is { } train) AddCargoFlow(train);
    }

    private void AddCargoFlow(Train train)
    {
        if (Descriptions.FirstOrDefault() is not { } description) return;
        var from = FromCallChoices(train).FirstOrDefault(f => ToCallChoices(train, f).Any());
        if (from is null) return;
        var to = ToCallChoices(train, from).First();
        train.CreateCargoFlow(NextCargoFlowId(), from, to, description);
        _expanded.Add(train.Id);
        Save();
    }

    private void DeleteConfirmed()
    {
        if (_deleteTarget is { } flow && Plan?.TryDelete(flow).IsSuccess == true) Save();
        _deleteTarget = null;
    }

    private int NextCargoFlowId() =>
        ((Timetable?.Trains.SelectMany(t => t.CargoFlows).Select(c => c.Id) ?? []).DefaultIfEmpty(0).Max()) + 1;

    // ---- Cargo flows sub-table -------------------------------------------------------------------

    private RenderFragment FlowsTable(Train train) => @<div class="sub">
        <table class="sub-grid">
            <thead>
                <tr>
                    <th class="num" title="@Translator("PositionInTrainHint")">@Translator("Position")</th>
                    <th>@Translator("From")</th>
                    <th>@Translator("To")</th>
                    <th>@Translator("CargoDescription")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var flow in train.CargoFlows.OrderBy(f => f.PositionInTrain).ThenBy(f => f.From.SortTime).ToList())
                {
                    <tr>
                        <td><input type="number" class="num" min="0" value="@flow.PositionInTrain" @onchange="e => SetPosition(flow, e)" /></td>
                        <td>
                            <select value="@flow.From.Id" @onchange="e => SetFrom(flow, e)">
                                @foreach (var call in FromCallChoices(train))
                                {
                                    <option value="@call.Id">@CallLabel(call)</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select value="@flow.To.Id" @onchange="e => SetTo(flow, e)">
                                @foreach (var call in ToCallChoices(train, flow.From))
                                {
                                    <option value="@call.Id">@CallLabel(call)</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select value="@flow.CargoFlowOptionsId" @onchange="e => SetDescription(flow, e)">
                                @foreach (var d in Descriptions)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </td>
                        <td><button class="danger small" @onclick="() => _deleteTarget = flow">@Translator("Delete")</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="small" @onclick="() => AddCargoFlow(train)">@Translator("AddCargoFlow")</button>
    </div>;

    private void SetPosition(CargoFlowTrainPart flow, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, Culture, out var position)) flow.PositionInTrain = position;
        Save();
    }

    private void SetFrom(CargoFlowTrainPart flow, ChangeEventArgs e)
    {
        var train = flow.Train;
        if (CallById(train, e) is not { } from) return;
        flow.From = from;
        flow.FromId = from.Id;
        // Keep the to-call valid: it must be an arrival after the new from-call.
        if (flow.To.SortTime <= from.SortTime && ToCallChoices(train, from).FirstOrDefault() is { } to)
        {
            flow.To = to;
            flow.ToId = to.Id;
        }
        Save();
    }

    private void SetTo(CargoFlowTrainPart flow, ChangeEventArgs e)
    {
        if (CallById(flow.Train, e) is { } to)
        {
            flow.To = to;
            flow.ToId = to.Id;
        }
        Save();
    }

    private void SetDescription(CargoFlowTrainPart flow, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && Descriptions.FirstOrDefault(d => d.Id == id) is { } description)
        {
            flow.CargoFlowOptions = description;
            flow.CargoFlowOptionsId = description.Id;
        }
        Save();
    }

    private static StationCall? CallById(Train train, ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var id) ? train.Calls.FirstOrDefault(c => c.Id == id) : null;

    private void Save() => ScheduleState.SaveAndNotify();
}
