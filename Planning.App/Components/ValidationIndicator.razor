@using Tellurian.Trains.Schedules.Model.Validations
@inject ValidationStateService Validation
@inject NavigationManager Nav
@inject Translator Translator
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="validation-indicator @SeverityCss">
    <button class="header-btn indicator-btn" @onclick="Toggle" title="@Translator("Conflicts")">
        <i class="fa-solid @IconCss"></i>
        @if (Validation.HasErrors)
        {
            <span class="badge">@Validation.Count</span>
        }
    </button>

    @if (_open)
    {
        <div class="panel-backdrop" @onclick="Close"></div>
        <div class="panel" @onclick:stopPropagation>
            <header class="panel-header">
                <h3>@Translator("Conflicts")</h3>
                <div class="header-actions">
                    @if (Validation.HasErrors)
                    {
                        <button class="copy" @onclick="CopyToClipboard" title="@Translator("CopyToClipboard")">
                            <i class="fa-solid @(_copied ? "fa-check" : "fa-copy")"></i>
                        </button>
                    }
                    <button class="close" @onclick="Close" title="@Translator("Close")"><i class="fa-solid fa-xmark"></i></button>
                </div>
            </header>
            @if (!Validation.HasErrors)
            {
                <p class="empty">@Translator("NoConflicts")</p>
            }
            else
            {
                <ul class="conflict-list">
                    @foreach (var error in Ordered)
                    {
                        <li class="conflict @SeverityClass(error.Severity)" @onclick="() => GoTo(error)">@error.Message.Text</li>
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    private bool _open;
    private bool _copied;
    private IJSObjectReference? _clipboard;

    protected override void OnInitialized() => Validation.OnValidationChanged += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _clipboard = await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
    }

    // Copy every conflict message, most severe first, one per line.
    private async Task CopyToClipboard()
    {
        if (_clipboard is null) return;
        var text = string.Join(Environment.NewLine, Ordered.Select(e => e.Message.Text));
        _copied = await _clipboard.InvokeAsync<bool>("copyText", text);
    }

    // Most severe first, so the worst problems are read first.
    private IEnumerable<ValidationError> Ordered => Validation.Errors.OrderByDescending(e => e.Severity);

    private string IconCss => Validation.MaxSeverity switch
    {
        Severity.Error or Severity.System => "fa-circle-exclamation",
        Severity.Warning => "fa-triangle-exclamation",
        Severity.Information => "fa-circle-info",
        _ => "fa-circle-check",
    };

    private string SeverityCss => SeverityClass(Validation.MaxSeverity);

    private static string SeverityClass(Severity severity) => severity switch
    {
        Severity.Error or Severity.System => "sev-error",
        Severity.Warning => "sev-warning",
        Severity.Information => "sev-info",
        _ => "sev-none",
    };

    private void Toggle()
    {
        _open = !_open;
        _copied = false;
    }

    private void Close()
    {
        _open = false;
        _copied = false;
    }

    // Jump to the tab where this kind of conflict is edited (and highlighted), then close the panel.
    private void GoTo(ValidationError error)
    {
        _open = false;
        Nav.NavigateTo(RouteFor(error));
    }

    // Schedule and vehicle conflicts are resolved on the Schedules tab; train conflicts on the graphical
    // timetable (spatial/timing conflicts) or the Trains tab (per-train edits).
    private static string RouteFor(ValidationError error) => error.Scope switch
    {
        ValidationScope.Schedule or ValidationScope.Vehicle => "schedules",
        ValidationScope.Duty => "duties",
        _ => error.ErrorType switch
        {
            ValidationErrorType.StationTrackConflict or
            ValidationErrorType.TrackStretchConflict or
            ValidationErrorType.TrainSpeedTooSlow or
            ValidationErrorType.TrainSpeedTooFast => "graphical-timetable",

            // TrainTimeSequence, StationCallTiming, TrainTooFewCalls, MissingTrackReference, DuplicateTrainNumber
            _ => "trains",
        },
    };

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Validation.OnValidationChanged -= OnChanged;
        if (_clipboard is not null)
        {
            try { await _clipboard.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
    }
}
