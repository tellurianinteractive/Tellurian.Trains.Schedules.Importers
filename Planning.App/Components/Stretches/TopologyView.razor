@using Tellurian.Trains.Schedules.Model.Layouts
@inject ScheduleStateService ScheduleState
@inject Translator Translator
@implements IDisposable

@* The Stretches tab's topology view: the shared diagram plus the tab's own hint and scrolling. The
   drawing itself lives in Planning.Components.Shared so the duty booklet's overview page renders the
   same schematic. *@

<div class="topology">
    <p class="hint">@Translator("TopologyHint")</p>

    @if (Layout is null || Layout.TimetableStretches.All(s => s.Stretches.Count == 0))
    {
        <p class="empty">@Translator("TopologyNoStretches")</p>
    }
    else
    {
        <div class="topology-scroll">
            <TopologyDiagramView Layout="Layout" />
        </div>
    }
</div>

@code {
    private Layout? Layout => ScheduleState.Layout;

    protected override void OnInitialized() => ScheduleState.OnChanged += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ScheduleState.OnChanged -= OnStateChanged;
}
