@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="split-pane @OrientationClass" style="@SplitStyle" @ref="_container">
    <div class="split-pane-first">
        @First
    </div>
    <div class="split-pane-divider"
         @onpointerdown="OnDividerPointerDown"
         @onpointerdown:preventDefault>
        <div class="divider-handle"></div>
    </div>
    <div class="split-pane-second">
        @Second
    </div>
</div>

@code {
    private ElementReference _container;
    private IJSObjectReference? _module;

    [Parameter] public RenderFragment? First { get; set; }
    [Parameter] public RenderFragment? Second { get; set; }
    [Parameter] public SplitOrientation Orientation { get; set; } = SplitOrientation.Horizontal;
    [Parameter] public double Ratio { get; set; } = 0.5;
    [Parameter] public EventCallback<double> RatioChanged { get; set; }

    private string OrientationClass => Orientation == SplitOrientation.Horizontal
        ? "split-horizontal"
        : "split-vertical";

    private string SplitStyle
    {
        get
        {
            var pct = (Ratio * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
            return Orientation == SplitOrientation.Horizontal
                ? $"--split-first: {pct}%;"
                : $"--split-first: {pct}%;";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/split-pane.js");
        }
    }

    private async Task OnDividerPointerDown(PointerEventArgs e)
    {
        if (_module is not null)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("startDrag", _container, dotNetRef,
                Orientation == SplitOrientation.Horizontal ? "horizontal" : "vertical");
        }
    }

    [JSInvokable]
    public async Task OnDragEnd(double ratio)
    {
        Ratio = Math.Clamp(ratio, 0.1, 0.9);
        await RatioChanged.InvokeAsync(Ratio);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
