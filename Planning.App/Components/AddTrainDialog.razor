@using System.Globalization
@using Tellurian.Trains.Schedules.Model.Layouts
@using Tellurian.Trains.Schedules.Model.Timetables
@using Tellurian.Trains.Schedules.Planning.Timetables
@inject ScheduleStateService ScheduleState
@inject Translator Translator

@if (Timetable is not null && Layout is not null)
{
    <div class="add-train-backdrop">
        <div class="add-train-dialog">
            <h3>@Translator("AddTrainTitle")</h3>

            <div class="field">
                <label>@Translator("Category")</label>
                <ListBoxView Items="@(CategoryChoices.ToListItems())"
                             Value="_categoryId" ValueChanged="id => { _categoryId = id; UpdateCategoryDefaults(); UpdateSuggestedNumber(); }"
                             Placeholder="—" />
            </div>
            <div class="field">
                <label>@Translator("From")</label>
                <ListBoxView Items="@(LocationChoices.ToListItems())"
                             Value="_fromId" ValueChanged="id => { _fromId = id; _error = null; UpdateSuggestedNumber(); }"
                             Placeholder="—" />
            </div>
            <div class="field">
                <label>@Translator("To")</label>
                <ListBoxView Items="@(LocationChoices.ToListItems())"
                             Value="_toId" ValueChanged="id => { _toId = id; _error = null; UpdateSuggestedNumber(); }"
                             Placeholder="—" />
            </div>
            <div class="field">
                <label>@Translator("StartTime")</label>
                <input type="text" class="time" value="@_time" @onchange="e => _time = e.Value?.ToString() ?? _time" />
            </div>
            <div class="field">
                <label>@Translator("Number")</label>
                <input type="number" class="num" min="1" value="@_number" @onchange="SetNumber" />
            </div>
            <div class="field">
                <label>@Translator("PreparationMinutes")</label>
                <input type="number" class="num" min="0" value="@_preparationMinutes" @onchange="e => _preparationMinutes = ParseInt(e, _preparationMinutes)" />
            </div>
            <div class="field">
                <label>@Translator("FinishingMinutes")</label>
                <input type="number" class="num" min="0" value="@_finishingMinutes" @onchange="e => _finishingMinutes = ParseInt(e, _finishingMinutes)" />
            </div>
            <div class="field">
                <label>@Translator("MaxSpeed") (km/h)</label>
                <input type="number" class="num" min="1" value="@_speed" @onchange="e => _speed = ParseInt(e, _speed)" />
            </div>

            <fieldset>
                <legend>@Translator("ReturnTrain")</legend>
                <div class="field">
                    <label>@Translator("Return")</label>
                    <input type="checkbox" checked="@_return" @onchange="e => _return = e.Value as bool? ?? false" />
                </div>
                @if (_return)
                {
                    <div class="field">
                        <label>@Translator("AsSoonAsPossible")</label>
                        <input type="checkbox" checked="@_returnAsSoonAsPossible" @onchange="SetReturnAsSoonAsPossible" />
                    </div>
                    <div class="field">
                        <label>@Translator("DepartureTime")</label>
                        <input type="text" class="time" value="@_returnTime" disabled="@_returnAsSoonAsPossible"
                               @onchange="e => _returnTime = e.Value?.ToString() ?? _returnTime" />
                    </div>
                }
            </fieldset>

            <fieldset>
                <legend>@Translator("RepeatTrains")</legend>
                <div class="field">
                    <label>@Translator("Repeat")</label>
                    <input type="checkbox" checked="@_repeat" @onchange="e => _repeat = e.Value as bool? ?? false" />
                </div>
                @if (_repeat)
                {
                    <div class="field">
                        <label>@Translator("EndTime")</label>
                        <input type="text" class="time" value="@_endTime" @onchange="e => _endTime = e.Value?.ToString() ?? _endTime" />
                    </div>
                    <div class="field">
                        <label>@Translator("MinutesInterval")</label>
                        <input type="number" class="num" min="1" value="@_interval" @onchange="e => _interval = ParseInt(e, _interval)" />
                    </div>
                }
            </fieldset>

            @if (_error is not null)
            {
                <p class="error">@Translator(_error)</p>
            }

            <div class="actions">
                <button class="primary" disabled="@(!CanCreate)" @onclick="Create">@Translator("Create")</button>
                <button @onclick="Abort">@Translator("Abort")</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Raised with the newly created train after it has been added to the timetable and saved.</summary>
    [Parameter] public EventCallback<Train> OnCreated { get; set; }

    /// <summary>Raised when the dialog is dismissed without creating a train.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private Plan? Plan => ScheduleState.Schedule;
    private Timetable? Timetable => ScheduleState.Timetable;
    private Layout? Layout => ScheduleState.Layout;

    private IEnumerable<TrainCategory> CategoryChoices =>
        (Timetable?.TrainCategories ?? []).OrderBy(c => c.Name, StringComparer.CurrentCulture);

    private IEnumerable<OperationLocation> LocationChoices =>
        (Layout?.OperationLocations ?? []).OrderBy(l => l.Name, StringComparer.CurrentCulture);

    private int? _categoryId;
    private int? _fromId;
    private int? _toId;
    private string _time = "";
    private int _number = 1;
    private bool _numberEdited;
    private int _preparationMinutes = 10;
    private int _finishingMinutes = 10;
    private int _speed = 100;
    private bool _repeat;
    private string _endTime = "";
    private int _interval = 60;
    private bool _return;
    // The earliest possible return departure cannot be worked out before the outbound train exists, so the
    // planner starts on "as soon as possible" and only types a time when they want a different one.
    private bool _returnAsSoonAsPossible = true;
    private string _returnTime = "";
    private string? _error;

    private bool CanCreate =>
        _categoryId is not null && _fromId is not null && _toId is not null && _fromId != _toId;

    protected override void OnInitialized()
    {
        _categoryId = CategoryChoices.FirstOrDefault()?.Id;
        UpdateCategoryDefaults();
        // The origin call's arrival — the driver's service start — is preparationMinutes before this
        // departure (see Plan.Create), so defaulting straight to the plan's start time would place that
        // arrival before it and fail the operating window. Add the preparation time so the earliest call
        // lands exactly on the plan's start time.
        var planStartTime = Layout?.Settings.General.StartTime ?? TimeSpan.FromHours(6);
        _time = planStartTime.Add(TimeSpan.FromMinutes(_preparationMinutes)).ToString(@"hh\:mm", Culture);
        _number = (Timetable?.Trains.Select(t => t.Number) ?? []).DefaultIfEmpty(0).Max() + 1;
        _speed = Layout?.Settings.TimeAndSpeed.Normal.ScaleSpeedKmh ?? 100;
        _endTime = (Layout?.Settings.General.EndTime ?? TimeSpan.FromHours(22)).ToString(@"hh\:mm", Culture);
    }

    // "As soon as possible" leaves nothing to enter, so the departure time is emptied and locked while it is set.
    private void SetReturnAsSoonAsPossible(ChangeEventArgs e)
    {
        _returnAsSoonAsPossible = e.Value as bool? ?? false;
        if (_returnAsSoonAsPossible) _returnTime = "";
        _error = null;
    }

    // Fill the preparation and finishing-up minutes with the chosen category's defaults. Unlike the train
    // number, these follow the category every time one is picked: they are the category's times, and the
    // planner types over them afterwards when this train is to differ.
    private void UpdateCategoryDefaults()
    {
        if (CategoryChoices.FirstOrDefault(c => c.Id == _categoryId) is not { } category) return;
        _preparationMinutes = category.DefaultPreparationMinutes;
        _finishingMinutes = category.DefaultFinishingMinutes;
    }

    // The planner has typed a number, so stop overwriting it with the category/direction suggestion.
    private void SetNumber(ChangeEventArgs e)
    {
        _number = ParseInt(e, _number);
        _numberEdited = true;
    }

    // Fill the number field with the default for the chosen category and travel direction (odd downwards,
    // even upwards), unless the planner has already typed a number. Does nothing until category and both
    // distinct locations are chosen, or when no path connects them.
    private void UpdateSuggestedNumber()
    {
        if (_numberEdited) return;
        if (Plan is not { } plan) return;
        if (CategoryChoices.FirstOrDefault(c => c.Id == _categoryId) is not { } category) return;
        if (Layout?.OperationLocations.FirstOrDefault(l => l.Id == _fromId) is not { } from) return;
        if (Layout?.OperationLocations.FirstOrDefault(l => l.Id == _toId) is not { } to) return;
        if (from.Equals(to)) return;
        if (plan.SuggestTrainNumber(category, from, to) is { } suggested) _number = suggested;
    }

    private async Task Create()
    {
        _error = null;
        if (Plan is not { } plan || Timetable is not { } timetable || Layout is not { } layout) return;
        if (timetable.TrainCategories.FirstOrDefault(c => c.Id == _categoryId) is not { } category) return;
        if (layout.OperationLocations.FirstOrDefault(l => l.Id == _fromId) is not { } from) return;
        if (layout.OperationLocations.FirstOrDefault(l => l.Id == _toId) is not { } to) return;
        if (!TryParseTime(_time, out var startTime)) { _error = "InvalidTime"; return; }

        // Null asks the return train to depart as soon as possible; any entered time is used as it stands.
        Time? returnTime = null;
        if (_return && !_returnAsSoonAsPossible)
        {
            if (!TryParseTime(_returnTime, out var entered)) { _error = "InvalidTime"; return; }
            returnTime = entered;
        }

        Train? first;
        if (_repeat)
        {
            if (!TryParseTime(_endTime, out var endTime)) { _error = "InvalidTime"; return; }
            if (_interval < 1) { _error = "InvalidMinutes"; return; }

            var trains = _return
                ? plan.CreateRepeatingWithReturn(category, from, to, startTime, endTime, _interval, returnTime, _preparationMinutes, _finishingMinutes, _speed, _number)
                : plan.CreateRepeating(category, from, to, startTime, endTime, _interval, _preparationMinutes, _finishingMinutes, _speed, _number);
            if (trains.Count == 0) { _error = _return ? "CouldNotCreateTrainPair" : "NoPathBetweenStations"; return; }
            first = trains[0];
        }
        else if (_return)
        {
            var trains = plan.CreateWithReturn(category, from, to, startTime, returnTime, _preparationMinutes, _finishingMinutes, _speed, _number);
            if (trains.Count == 0) { _error = "CouldNotCreateTrainPair"; return; }
            first = trains[0];
        }
        else
        {
            first = plan.Create(category, from, to, startTime, _preparationMinutes, _finishingMinutes, _speed, _number);
            if (first is null) { _error = "NoPathBetweenStations"; return; }
        }

        ScheduleState.SaveAndNotify();
        await OnCreated.InvokeAsync(first);
    }

    private Task Abort() => OnClosed.InvokeAsync();

    private static int ParseInt(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, Culture, out var value) ? value : fallback;

    private static bool TryParseTime(string text, out Time time)
    {
        if (!string.IsNullOrWhiteSpace(text) && TimeSpan.TryParse(text, CultureInfo.InvariantCulture, out var span))
        {
            time = Time.FromTimeSpan(span);
            return true;
        }
        time = Time.Zero;
        return false;
    }
}
