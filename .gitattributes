# Line endings: LF everywhere, in the repository and in the working tree, on every OS.
# Local files and GitHub are byte-identical, so git never converts or warns.
# See the tellurian-review skill, section "Repository hygiene".
* text=auto eol=lf

# Windows command scripts need CRLF to run reliably in cmd.exe
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touched
