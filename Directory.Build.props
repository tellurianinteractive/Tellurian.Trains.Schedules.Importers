<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Product>Tellurian Trains</Product>
		<Company>Tellurian Interactive</Company>
		<Copyright>© Stefan Fjällemark 2023-2026</Copyright>
		<Authors>Stefan Fjällemark</Authors>
		<Version>3.2.0</Version>
		<AssemblyVersion>3.2.0.0</AssemblyVersion>
		<NeutralLanguage>en-GB</NeutralLanguage>
		<Platforms>AnyCPU</Platforms>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
		<PackageTags>model-trains scheduling timetables FREMO XPLN</PackageTags>
		<PackageReleaseNotes>
			3.1.0: See release note document.
		</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Description>Import operations for layouts, timetables and schedules.</Description>
	</PropertyGroup>
	<PropertyGroup>
		<RepositoryType>Github</RepositoryType>
		<RepositoryUrl>https://github.com/tellurianinteractive/Tellurian.Trains.Schedule.Importers/</RepositoryUrl>
		<PackageProjectUrl>https://github.com/tellurianinteractive/Tellurian.Trains.Schedule.Importers/</PackageProjectUrl>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
		<IsPackable>false</IsPackable>
		<NoWarn>$(NoWarn);MSTEST0001;MSTEST0037;CS1591</NoWarn>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- Microsoft Testing Platform parallelism (replaces runsettings MaxCpuCount) -->
		<TestingPlatformParallelEnabled>true</TestingPlatformParallelEnabled>
		<!-- Suppress runsettings compatibility warnings -->
		<TestingPlatformShowPlatformModeCompatibilityWarnings>false</TestingPlatformShowPlatformModeCompatibilityWarnings>
	</PropertyGroup>
	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'Planning.App' OR '$(MSBuildProjectName)' == 'Planning.Components'">
		<!-- Executable app and internal UI/graph components: not documented public APIs. -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>
</Project>