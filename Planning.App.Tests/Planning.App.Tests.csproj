<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <AssemblyName>Tellurian.Trains.Schedules.Planning.App.Tests</AssemblyName>
    <RootNamespace>Tellurian.Trains.Schedules.Planning.App.Tests</RootNamespace>
    <!-- These tests launch the app and a real browser; run serially and locally only. -->
    <TestingPlatformParallelEnabled>false</TestingPlatformParallelEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- A test seeds the app's stored plan, which is written and read as the model's own JSON. -->
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.5.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>
</Project>
